                "Port": "${SFC_E2E_PLC_PORT}",
                "ConnectTimeout": 5000,
                "ReadTimeout": 2000,
                "WaitAfterConnectError": 1000,
                "WaitAfterReadError": 1000,
                "WaitAfterWriteError": 1000
              }
            }
          }
        },
        "Metadata": {
          "runId": "${SFC_E2E_RUN_ID}",
          "case": "${SFC_E2E_CASE}",
          "mode": "${SFC_E2E_MODE}",
          "marker": "${SFC_E2E_MARKER}"
        }
      },
      "uberjar": {
        "AdapterTypes": {
          "PCCC": {
            "FactoryClassName": "com.amazonaws.sfc.pccc.PcccAdapter"
          }
        },
        "TargetTypes": {
          "FILE-TARGET": {
            "FactoryClassName": "com.amazonaws.sfc.filetarget.FileTargetWriter"
          }
        }
      },
      "inprocess": {
        "AdapterTypes": {
          "PCCC": {
            "FactoryClassName": "com.amazonaws.sfc.pccc.PcccAdapter",
            "JarFiles": [
              "${SFC_DEPLOYMENT_DIR}/pccc/lib"
            ]
          }
        },
        "TargetTypes": {
          "FILE-TARGET": {
            "FactoryClassName": "com.amazonaws.sfc.filetarget.FileTargetWriter",
            "JarFiles": [
              "${SFC_DEPLOYMENT_DIR}/file-target/lib"
            ]
          }
        }
      },
      "ipcServices": {
        "PcccServer": {
          "module": "pccc"
        },
        "FileServer": {
          "module": "file-target"
        }
      },
      "ipc": {
        "ProtocolAdapters": {
          "Pccc": {
            "AdapterServer": "PcccServer"
          }
        },
        "AdapterServers": {
          "PcccServer": {
            "Address": "${SFC_E2E_IPC_HOST}",
            "Port": 50000
          }
        },
        "Targets": {
          "File": {
            "TargetServer": "FileServer"
          }
        },
        "TargetServers": {
          "FileServer": {
            "Address": "${SFC_E2E_IPC_HOST}",
            "Port": 50001
          }
        }
      }
    }
  ]
}
