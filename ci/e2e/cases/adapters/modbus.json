{
  "cases": [
    {
      "id": "ADP-MODBUS-PILOT",
      "title": "pilot: omni-plc-sim Modbus TCP (generic profile) -> modbus-tcp adapter -> file",
      "intent": "The first case on a real Modbus TCP server: every logical tag of the default map, read through SFC's request planner (5 requests per cycle: FC1 0/17, FC2 0/10, FC3 0/110, FC3 200/42, FC4 0/17), decoded raw and through the register transformations, in all three deployment modes. Static words are exact; dynamic signals are range- and change-checked over 8 records (the first read waits out the TCP client's 1 s first-send delay, so the second read follows it back to back; 8 records leave at least six samples 200 ms apart); the simulator's own request log proves the wire plan and that no exception was sent.",
      "pins": [
        "adapters/modbus/src/main/kotlin/com/amazonaws/sfc/modbus/adapter/ModbusDevice.kt:192-231",
        "adapters/modbus/src/main/kotlin/com/amazonaws/sfc/modbus/protocol/RequestBase.kt:69",
        "adapters/modbus/src/main/kotlin/com/amazonaws/sfc/modbus/protocol/ResponseBase.kt:188-231",
        "adapters/modbus-tcp/src/main/kotlin/com/amazonaws/sfc/modbus/tcp/protocol/MBAPHeader.kt:114-126",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/JsonHelper.kt:104-117",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/SourcesValuesAsFlow.kt:133-146",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/tcp/TcpClient.kt:256-260"
      ],
      "tier": "local-infra",
      "priority": "P1",
      "services": [
        {
          "name": "plc",
          "kind": "plc-sim",
          "args": {
            "protocol": "modbus",
            "profile": "generic"
          }
        }
      ],
