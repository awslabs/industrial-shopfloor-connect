    {
      "id": "ADP-XCUT-ISOLATION-01",
      "title": "A failing source does not suppress data from a healthy source in the same schedule",
      "tier": "local-infra",
      "priority": "P1",
      "intent": "One schedule reads three sources through three adapters: a simulator counter, an MQTT source whose broker port is dead (the adapter returns a SourceReadError on every read) and an OPC-UA source whose server port is dead (the adapter returns an empty success while it pauses). ScheduleReader waits for every reader and slices the combined results from the successful sources only, so the counter must keep its exact gap-free sequence in every record and the failing sources must never appear.",
      "pins": [
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:234",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:789",
        "adapters/mqtt/src/main/kotlin/com/amazonaws/sfc/mqtt/MqttAdapter.kt:206",
        "adapters/opcua/src/main/kotlin/com/amazonaws/sfc/opcua/OpcuaSource.kt:1058"
      ],
      "records": 12,
      "modeParity": true,
      "assert": [
        {
          "kind": "channelSequence",
          "source": "sim",
          "channel": "ctr",
          "step": 1
        },
        {
          "kind": "keysAbsent",
          "paths": [
            "sources.m",
            "sources.u"
          ]
        },
        {
          "kind": "logContains",
          "text": "Reading for source m paused for"
        },
        {
          "kind": "logContains",
          "text": "Error creating client for for source \"u\""
        }
      ],
