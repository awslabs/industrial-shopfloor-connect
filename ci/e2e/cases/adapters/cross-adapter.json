    {
      "id": "ADP-XCUT-READERROR-NOTLOGGED-01",
      "title": "Adapter read errors (SourceReadError) are never logged or counted by the core (known defect)",
      "tier": "local-infra",
      "priority": "P1",
      "intent": "docs/sfc-extending.md says the core logs the SourceReadError an adapter returns. ScheduleReader builds the slices it processes from SourceReadSuccess results only, so its error branch (log 'error reading from source', count ReadError) is dead code. The NATS adapter, pointed at a dead port, returns a SourceReadError on every read and logs a pause line each time, which the case waits for three times; the adapter's own ConnectionErrors metric proves errors were returned, while the core neither logs nor counts them.",
      "pins": [
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:789",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:315",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:196",
        "adapters/nats/src/main/kotlin/com/amazonaws/sfc/nats/NatsAdapter.kt:245",
        "docs/sfc-extending.md:63"
      ],
      "steps": [
        {
          "wait": {
            "log": "Pause reading from source until",
            "count": 3
          }
        },
        {
          "wait": {
            "metric": {
              "source": "Nats",
              "name": "ConnectionErrors",
              "op": "ge",
              "value": 1
            }
          },
          "comment": "metrics are written once per second; wait for the adapter's error count before collecting"
        }
      ],
      "gate": {
        "sink": "main",
        "records": 10
      },
      "assert": [
        {
          "kind": "recordCount",
          "where": {
            "schedule": "R"
          },
          "equals": 0
        },
        {
          "kind": "recordCount",
          "where": {
            "schedule": "H"
          },
          "min": 10
        },
        {
          "kind": "metric",
          "source": "Nats",
          "name": "ConnectionErrors",
          "op": "ge",
          "value": 1
        }
      ],
      "knownDefect": {
        "ref": "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:789",
        "summary": "sliceResults keeps only SourceReadSuccess entries, so the SourceReadError branch of processReceivedData never runs: read errors are neither logged nor counted as SfcCore ReadError",
        "assertCurrent": [
          {
            "kind": "logAbsent",
            "texts": [
              "error reading from source"
            ]
          },
          {
            "kind": "metric",
            "source": "SfcCore",
            "name": "ReadError",
            "op": "eq",
            "value": 0
          }
        ],
        "assertCorrect": [
          {
            "kind": "logContains",
            "text": "error reading from source \"n\""
          },
          {
            "kind": "metric",
            "source": "SfcCore",
            "name": "ReadError",
            "op": "ge",
            "value": 1
          }
        ]
      },
