{
  "cases": [
    {
      "id": "ADP-XCUT-IPC-NULLMAP-01",
      "title": "Null entries in structured adapter values are dropped in IPC mode only (known defect)",
      "tier": "local-infra",
      "priority": "P1",
      "intent": "A map value crosses the IPC hop as a gRPC TypedMap, and GrpcValueFromNativeExt.typedMap filters out every entry whose value is null, so a structure decoded in the adapter service loses keys that in-process and uberjar keep as null. The vehicle is the OPC-UA ServerStatus structure from SFC's own opcua-target, whose shutdownReason is null; in-process/uberjar delivery of the same key set is asserted by ADP-OPCUA-POLL-STRUCT-01. The defect affects every adapter that returns maps (OPC-UA structures, SQL rows, JSON payloads).",
      "pins": [
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/extensions/GrpcValueFromNativeExt.kt:443",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/extensions/GrpcValueFromNativeExt.kt:435",
        "adapters/opcua/src/main/kotlin/com/amazonaws/sfc/opcua/OpcuaDataTypesConverter.kt:113"
      ],
      "modes": [
        "ipc"
      ],
      "services": [
        {
          "name": "opcua",
          "kind": "command",
          "start": "deferred",
          "args": {
            "argv": [
              "true"
            ]
          }
        }
      ],
      "records": 4,
      "assert": [
        {
          "kind": "everyRecord",
          "path": "sources.ua.values.status.value.buildInfo.productName",
          "equals": "SFC OPCUA Target",
          "strictTypes": true
        }
      ],
      "knownDefect": {
        "ref": "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/extensions/GrpcValueFromNativeExt.kt:443",
        "summary": "typedMap filters out null-valued entries, so in IPC a structure loses its null fields (ServerStatus.shutdownReason) that in-process and uberjar deliver as null",
        "assertCurrent": [
          {
            "kind": "keySet",
            "path": "sources.ua.values.status.value",
            "keys": [
              "startTime",
              "currentTime",
              "state",
              "buildInfo",
              "secondsTillShutdown"
            ]
          }
        ],
        "assertCorrect": [
          {
            "kind": "keySet",
            "path": "sources.ua.values.status.value",
            "keys": [
              "startTime",
              "currentTime",
              "state",
              "buildInfo",
              "secondsTillShutdown",
              "shutdownReason"
            ]
          }
        ]
      },
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "ADP-XCUT-IPC-NULLMAP-01",
        "Schedules": [
          {
            "Name": "W",
            "Interval": 1000,
            "Sources": {
              "sim": [
                "*"
              ]
            },
            "Targets": [
              "OpcuaTarget"
            ]
          },
          {
            "Name": "R",
            "Interval": 200,
            "Sources": {
              "ua": [
                "*"
              ]
            },
            "Targets": [
              "File"
            ],
            "TimestampLevel": "None"
          }
        ],
        "Sources": {
          "sim": {
            "Name": "sim",
            "ProtocolAdapter": "Sim",
            "Channels": {
              "one": {
                "Name": "one",
                "Simulation": {
                  "SimulationType": "Constant",
                  "DataType": "Int",
                  "Value": 1
                }
              }
            }
          },
          "ua": {
            "Name": "ua",
            "ProtocolAdapter": "Ua",
            "AdapterOpcuaServer": "srv",
            "SourceReadingMode": "Polling",
