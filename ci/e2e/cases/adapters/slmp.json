          "SLMP": {
            "FactoryClassName": "com.amazonaws.sfc.slmp.SlmpAdapter",
            "JarFiles": [
              "${SFC_DEPLOYMENT_DIR}/slmp/lib"
            ]
          }
        },
        "TargetTypes": {
          "FILE-TARGET": {
            "FactoryClassName": "com.amazonaws.sfc.filetarget.FileTargetWriter",
            "JarFiles": [
              "${SFC_DEPLOYMENT_DIR}/file-target/lib"
            ]
          }
        }
      },
      "ipcServices": {
        "SlmpServer": {
          "module": "slmp"
        },
        "FileServer": {
          "module": "file-target"
        }
      },
      "ipc": {
        "ProtocolAdapters": {
          "Plc": {
            "AdapterServer": "SlmpServer"
          }
        },
        "AdapterServers": {
          "SlmpServer": {
            "Address": "${SFC_E2E_IPC_HOST}",
            "Port": 50000
          }
        },
        "Targets": {
          "File": {
            "TargetServer": "FileServer"
          }
        },
        "TargetServers": {
          "FileServer": {
            "Address": "${SFC_E2E_IPC_HOST}",
            "Port": 50001
          }
        }
      }
    }
  ]
}
