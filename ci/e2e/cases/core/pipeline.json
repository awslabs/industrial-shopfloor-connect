    {
      "id": "CORE-PIPE-WEDGE-01",
      "title": "One processing exception permanently stops a schedule's output (value-filter type mismatch, transformation failure) (known defect)",
      "tier": "core",
      "intent": "processReceivedData() clears combinedReaderResults/readersDone only after every slice was processed (ScheduleReader.kt:190-206). When processing throws, the catch at :237-239 logs 'Error processing data from reader' and the stale data stays; on the next result the reader is already in readersDone, so the stale data is reprocessed first (:225-226), throws again, and the new result is never stored. The schedule is wedged for good. Two triggers that pass validation: (a) a value filter on a non-numeric value - applyValueFilter has no catch (:645-650) and numericCompare throws for a String (DataTypes.kt:66-71); (b) at non-TRACE level transformations run in async and the exception surfaces at await (:731), outside the try at :713-726 - here [BytesToInt16, Int16ToBytes], which validation accepts (any numeric type is 'assignable', DataTypes.kt:43) but which fails the strict runtime type check (TransformationImpl.kt:124: Short is not Int). 'Once' runs healthy until an Interval simulation first emits a String after ~3 s. A Control schedule on its own sink is the gate and must stay healthy throughout.",
      "pins": [
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:190-206",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:225-226",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:237-239",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:645-650",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:713-731",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/DataTypes.kt:66-73",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/transformations/TransformationImpl.kt:116-125",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/transformations/Transformation.kt:112-125"
      ],
      "timeoutSeconds": 90,
      "modeParity": false,
      "sinks": {
        "main": {},
        "ctl": {}
      },
      "gates": [
        {
          "sink": "ctl",
          "records": 80
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "sink": "ctl",
          "min": 80
        },
        {
          "kind": "channelSequence",
          "sink": "ctl",
          "source": "srcCtl",
          "channel": "ctr",
          "step": 1,
          "comment": "A healthy schedule in the same process is unaffected: the wedge is per schedule"
        },
        {
          "kind": "logCount",
          "text": "Error processing data from reader",
          "min": 10
        }
      ],
      "knownDefect": {
        "ref": "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:198",
        "summary": "An exception escaping processReceivedData leaves the failing data in combinedReaderResults; every later read reprocesses it, throws again and is discarded, so the schedule never outputs again",
        "assertCurrent": [
          {
            "kind": "recordCount",
            "sink": "main",
            "where": {
              "schedule": "Always"
            },
            "equals": 0
          },
          {
            "kind": "recordCount",
            "sink": "main",
            "where": {
              "schedule": "Xform"
            },
            "equals": 0
          },
          {
            "kind": "recordCount",
            "sink": "main",
            "where": {
              "schedule": "Once"
            },
            "max": 50,
            "comment": "Healthy only until the first 'x' (~3 s after the adapter starts; immediately in IPC, where reads start ~10 s late), then never again"
          },
          {
            "kind": "logContains",
            "text": "Can not compare value RUNNING"
          },
          {
            "kind": "logContains",
            "text": "Int16ToBytes"
          }
        ],
        "assertCorrect": [
          {
            "kind": "recordCount",
            "sink": "main",
            "where": {
              "schedule": "Always"
            },
            "min": 40
          },
          {
            "kind": "keysAbsent",
            "paths": [
              "sources.srcAlways.values.s"
            ],
            "sink": "main",
            "where": {
              "schedule": "Always"
            }
          },
          {
            "kind": "recordCount",
            "sink": "main",
            "where": {
              "schedule": "Xform"
            },
            "min": 40
          },
          {
            "kind": "recordCount",
            "sink": "main",
            "where": {
              "schedule": "Once"
            },
            "min": 60
          },
          {
            "kind": "keysAbsent",
            "paths": [
              "sources.srcOnce.values.late"
