{
  "cases": [
    {
      "id": "CORE-TS-ADJUST-01",
      "title": "SourceTimestampAdjustment and ChannelTimestampAdjustment shift source and channel timestamps by the configured milliseconds",
      "tier": "core",
      "priority": "P1",
      "intent": "Timestamp adjustment corrects devices with skewed clocks, so a sign error or a unit error (seconds vs milliseconds) corrupts every time series. ScheduleReader.adjustTimestamps adds SourceTimestampAdjustment to the source read timestamp and ChannelTimestampAdjustment to every channel timestamp, in sfc-main, before any output; the root timestamp is unadjusted. A +1 day source and -1 hour channel adjustment dwarf scheduling jitter, so the deltas to the root timestamp are asserted within 5 s. In-process and uberjar only: an IPC adapter service does not transmit channel timestamps at all (GrpcSourceValueFromNativeExt.kt:759), so the channel adjustment has nothing to act on; CORE-TS-ADJUST-02 pins that in IPC mode.",
      "pins": [
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:249-271",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/SourceConfiguration.kt:49-57"
      ],
      "modes": [
        "inprocess",
        "uberjar"
      ],
      "records": 3,
      "timeoutSeconds": 60,
      "modeParity": true,
      "assert": [
        {
          "kind": "recordCount",
          "min": 3
        },
        {
          "kind": "tsDelta",
          "from": "timestamp",
          "to": "sources.sim.timestamp",
          "minMs": 86395000,
          "maxMs": 86405000
        },
        {
          "kind": "tsDelta",
          "from": "timestamp",
          "to": "sources.sim.values.c.timestamp",
          "minMs": -3605000,
          "maxMs": -3595000
        }
      ],
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "CORE-TS-ADJUST-01",
        "Version": 1,
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "S",
            "Interval": 100,
            "Active": true,
            "TimestampLevel": "Both",
            "Sources": {
              "sim": [
                "*"
              ]
            },
            "Targets": [
              "FileTarget"
            ]
          }
        ],
        "Sources": {
          "sim": {
            "Name": "sim",
            "ProtocolAdapter": "SimAdapter",
            "SourceTimestampAdjustment": 86400000,
            "ChannelTimestampAdjustment": -3600000,
            "Channels": {
              "c": {
                "Name": "c",
                "Simulation": {
                  "SimulationType": "Constant",
                  "DataType": "Int",
                  "Value": 1
                }
              }
            }
          }
        },
        "Targets": {
          "FileTarget": {
            "Active": true,
            "TargetType": "FILE-TARGET",
            "Directory": "${SFC_E2E_SINK}",
            "Json": true,
            "UtcTime": true,
            "Extension": ".json",
            "BufferSize": 1,
            "BufferCount": 1,
            "Interval": 60
          }
        },
        "ProtocolAdapters": {
          "SimAdapter": {
            "AdapterType": "SIMULATOR"
          }
        },
        "Metrics": {
          "Interval": 1,
          "Writer": {}
        },
