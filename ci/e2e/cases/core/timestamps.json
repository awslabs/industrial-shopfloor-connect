          "mode": "${SFC_E2E_MODE}",
          "marker": "${SFC_E2E_MARKER}"
        }
      },
      "ipcServices": {
        "SimAdapterServer": {
          "module": "simulator"
        },
        "FileTargetServer": {
          "module": "file-target"
        }
      },
      "ipc": {
