    {
      "id": "CORE-TS-ADJUST-02",
      "title": "An IPC adapter service drops channel timestamps, so ChannelTimestampAdjustment is lost and channels inherit the source timestamp (known defect)",
      "tier": "core",
      "priority": "P1",
      "intent": "The IPC-mode half of CORE-TS-ADJUST-01. SourceReadResult.asSourceReadValuesReply in the adapter service calls addAnyValue(key, value) without the channel timestamp and stamps the source with Instant.now() instead of the read timestamp. sfc-main then finds no channel timestamp to adjust (ScheduleReader.adjustTimestamps skips nulls) and buildOutputValues falls back to the source timestamp, which already carries the +1 day source adjustment. Every channel of an IPC adapter therefore reports the source time: TimestampLevel Channel/Both and ChannelTimestampAdjustment are silently wrong in IPC deployments. IPC only, because that is the only mode with the defect.",
      "pins": [
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/extensions/GrpcSourceValueFromNativeExt.kt:756",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/extensions/GrpcSourceValueFromNativeExt.kt:759",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:261-268",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:767"
      ],
      "modes": [
        "ipc"
      ],
      "records": 3,
      "timeoutSeconds": 90,
      "modeParity": false,
      "assert": [
        {
          "kind": "recordCount",
          "min": 3
        },
        {
          "kind": "tsDelta",
          "from": "timestamp",
          "to": "sources.sim.timestamp",
          "minMs": 86395000,
          "maxMs": 86405000,
          "comment": "The source adjustment works in IPC mode too."
        }
      ],
      "knownDefect": {
        "ref": "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/extensions/GrpcSourceValueFromNativeExt.kt:759",
        "summary": "The IPC adapter service encodes channel values without their timestamps (GrpcSourceValueFromNativeExt.kt:759, and :756 re-stamps the source with Instant.now()), so channel timestamps fall back to the source timestamp and ChannelTimestampAdjustment has no effect",
        "assertCurrent": [
          {
            "kind": "pathsEqual",
            "a": "sources.sim.values.c.timestamp",
            "b": "sources.sim.timestamp"
          },
          {
            "kind": "tsDelta",
            "from": "timestamp",
            "to": "sources.sim.values.c.timestamp",
            "minMs": 86395000,
            "maxMs": 86405000,
            "comment": "The channel shows the source time plus one day instead of the read time minus one hour."
          }
        ],
        "assertCorrect": [
          {
            "kind": "tsDelta",
            "from": "timestamp",
            "to": "sources.sim.values.c.timestamp",
            "minMs": -3605000,
            "maxMs": -3595000
          }
        ]
      },
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "CORE-TS-ADJUST-02",
        "Version": 1,
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "S",
            "Interval": 100,
            "Active": true,
            "TimestampLevel": "Both",
            "Sources": {
              "sim": [
                "*"
              ]
            },
            "Targets": [
              "FileTarget"
            ]
          }
        ],
        "Sources": {
          "sim": {
            "Name": "sim",
            "ProtocolAdapter": "SimAdapter",
            "SourceTimestampAdjustment": 86400000,
            "ChannelTimestampAdjustment": -3600000,
            "Channels": {
              "c": {
                "Name": "c",
                "Simulation": {
                  "SimulationType": "Constant",
                  "DataType": "Int",
                  "Value": 1
                }
              }
            }
          }
        },
        "Targets": {
          "FileTarget": {
            "Active": true,
            "TargetType": "FILE-TARGET",
            "Directory": "${SFC_E2E_SINK}",
            "Json": true,
            "UtcTime": true,
            "Extension": ".json",
            "BufferSize": 1,
            "BufferCount": 1,
            "Interval": 60
          }
        },
        "ProtocolAdapters": {
