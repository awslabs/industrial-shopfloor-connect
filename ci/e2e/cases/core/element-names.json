{
  "cases": [
    {
      "id": "CORE-ENAMES-COLLISION-01",
      "title": "Colliding ElementNames (Values == Metadata) are accepted and silently replace every channel value by the source metadata",
      "tier": "core",
      "priority": "P1",
      "intent": "ElementNamesConfiguration has no validate(), so two element names may be equal. SourceOutputDataSerializer adds the values node under the Values name and then the source metadata node under the Metadata name on the same JsonObject; with both named 'm' the metadata replaces the values and every reading is lost while SFC reports success. The partial rename also shows that unspecified names keep their defaults (schedule, serial, timestamp, sources). 1234.5678 is used because it cannot occur inside an ISO timestamp or a UUID, so the raw scan is unambiguous. In-process and uberjar only: IPC target services ignore ElementNames altogether (pinned by CORE-ENAMES-RENAME-02), which hides this collision there.",
      "pins": [
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ElementNamesConfiguration.kt:14-79",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/SourceOutputDataSerializer.kt:35-40",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/SourceOutputDataSerializer.kt:48-53"
      ],
      "modes": [
        "inprocess",
        "uberjar"
      ],
      "records": 3,
      "timeoutSeconds": 60,
      "modeParity": true,
      "assert": [
        {
          "kind": "recordCount",
          "min": 3
        },
        {
          "kind": "logAbsent",
          "texts": [
            "ConfigurationException",
            "ElementNames"
          ]
        },
        {
          "kind": "keyOrder",
          "keys": [
            "schedule",
            "serial",
            "timestamp",
            "sources"
          ]
        }
      ],
      "knownDefect": {
        "ref": "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/SourceOutputDataSerializer.kt:39",
        "summary": "ElementNames are never validated; with Values == Metadata the source metadata node replaces the values node (SourceOutputDataSerializer.kt:36 then :39), so every channel value is dropped without an error",
        "assertCurrent": [
          {
            "kind": "everyRecord",
            "path": "sources.Src",
            "equals": {
              "m": {
                "machine": "M42"
              }
            },
            "strictTypes": true
          },
          {
            "kind": "rawAbsent",
            "texts": [
              "1234.5678"
            ]
          }
        ],
        "assertCorrect": [
          {
            "kind": "rawContains",
            "text": "1234.5678",
            "min": 3
          }
        ]
      },
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "CORE-ENAMES-COLLISION-01",
        "Version": 1,
        "LogLevel": "Info",
        "ElementNames": {
          "Values": "m",
          "Metadata": "m"
        },
        "Schedules": [
          {
            "Name": "S",
            "Interval": 100,
            "Active": true,
            "Sources": {
              "sim": [
                "*"
              ]
            },
            "Targets": [
              "FileTarget"
            ]
          }
        ],
        "Sources": {
          "sim": {
            "Name": "Src",
            "ProtocolAdapter": "SimAdapter",
            "Metadata": {
              "machine": "M42"
            },
            "Channels": {
              "c1": {
                "Name": "ChanName",
                "Simulation": {
                  "SimulationType": "Constant",
                  "DataType": "Double",
                  "Value": 1234.5678
                }
              }
            }
          }
        },
        "Targets": {
          "FileTarget": {
            "Active": true,
            "TargetType": "FILE-TARGET",
            "Directory": "${SFC_E2E_SINK}",
            "Json": true,
            "UtcTime": true,
            "Extension": ".json",
            "BufferSize": 1,
            "BufferCount": 1,
            "Interval": 60
          }
        },
        "ProtocolAdapters": {
          "SimAdapter": {
            "AdapterType": "SIMULATOR"
          }
        },
        "Metrics": {
          "Interval": 1,
          "Writer": {}
        }
      },
      "uberjar": {
        "AdapterTypes": {
          "SIMULATOR": {
            "FactoryClassName": "com.amazonaws.sfc.simulator.SimulatorAdapter"
          }
        },
        "TargetTypes": {
          "FILE-TARGET": {
            "FactoryClassName": "com.amazonaws.sfc.filetarget.FileTargetWriter"
          }
        },
        "Metrics": {
          "Writer": {
            "MetricsWriter": {
              "FactoryClassName": "com.amazonaws.sfc.e2e.E2eMetricsWriter"
            }
          }
        }
      },
      "inprocess": {
        "AdapterTypes": {
          "SIMULATOR": {
            "FactoryClassName": "com.amazonaws.sfc.simulator.SimulatorAdapter",
            "JarFiles": [
              "${SFC_DEPLOYMENT_DIR}/simulator/lib"
            ]
          }
        },
        "TargetTypes": {
          "FILE-TARGET": {
            "FactoryClassName": "com.amazonaws.sfc.filetarget.FileTargetWriter",
            "JarFiles": [
              "${SFC_DEPLOYMENT_DIR}/file-target/lib"
            ]
          }
        },
        "Metrics": {
          "Writer": {
            "MetricsWriter": {
              "FactoryClassName": "com.amazonaws.sfc.e2e.E2eMetricsWriter",
              "JarFiles": [
                "${SFC_E2E_SUPPORT_JAR}"
              ]
            }
          }
        }
      }
