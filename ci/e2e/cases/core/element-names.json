              }
            },
            "Sources": {
              "sa": [
                "*"
              ]
            },
            "Targets": [
              "FileAgg"
            ]
          }
        ],
        "Sources": {
          "sp": {
            "Name": "SrcName",
            "ProtocolAdapter": "SimAdapter",
            "Metadata": {
              "b": "2"
            },
            "Channels": {
              "c1": {
                "Name": "ChanName",
                "Metadata": {
                  "c": "3"
                },
                "Simulation": {
                  "SimulationType": "Constant",
                  "DataType": "Double",
                  "Value": 42.5
                }
              }
            }
          },
          "sa": {
            "Name": "sa",
            "ProtocolAdapter": "SimAdapter",
            "Channels": {
              "k": {
                "Name": "k",
                "Simulation": {
                  "SimulationType": "Counter",
                  "DataType": "Int",
                  "Min": 1,
                  "Max": 100000,
                  "Step": 1
                }
              }
            }
          }
        },
        "Targets": {
          "FilePlain": {
            "Active": true,
            "TargetType": "FILE-TARGET",
            "Directory": "${SFC_E2E_SINK_PLAIN}",
            "Json": true,
            "UtcTime": true,
            "Extension": ".json",
            "BufferSize": 1,
            "BufferCount": 1,
            "Interval": 60
          },
          "FileAgg": {
            "Active": true,
            "TargetType": "FILE-TARGET",
            "Directory": "${SFC_E2E_SINK_AGG}",
            "Json": true,
            "UtcTime": true,
            "Extension": ".json",
            "BufferSize": 1,
            "BufferCount": 1,
            "Interval": 60
          }
        },
        "ProtocolAdapters": {
          "SimAdapter": {
            "AdapterType": "SIMULATOR"
          }
        },
        "Metrics": {
          "Interval": 1,
          "Writer": {}
        }
      },
      "uberjar": {
        "AdapterTypes": {
          "SIMULATOR": {
            "FactoryClassName": "com.amazonaws.sfc.simulator.SimulatorAdapter"
          }
        },
        "TargetTypes": {
          "FILE-TARGET": {
            "FactoryClassName": "com.amazonaws.sfc.filetarget.FileTargetWriter"
          }
        },
        "Metrics": {
          "Writer": {
            "MetricsWriter": {
              "FactoryClassName": "com.amazonaws.sfc.e2e.E2eMetricsWriter"
            }
          }
        }
      },
      "inprocess": {
