    {
      "id": "CORE-ENAMES-RENAME-01",
      "title": "All seven ElementNames renamed: plain and aggregated payloads carry only the configured names",
      "tier": "core",
      "priority": "P0",
      "intent": "ElementNames lets a deployment match an existing downstream schema, so a single key that keeps its default name breaks every consumer. TargetData passes the configured names to the root, source and channel serializers, and the aggregator's nested {min, values} outputs are ChannelOutputData serialized by the same serializer. The case renames all seven names and asserts both a plain and an aggregated document exactly (normalised serial and timestamps), then scans the raw files for any default name. 'values' is excluded from the scan on the aggregated sink only because it is the name of the aggregation function, not an element name. In-process and uberjar only: a target running as an IPC service never receives ElementNames (IpcTargetWriter.extractConfigurationForTarget copies only a few sections), which CORE-ENAMES-RENAME-02 pins in IPC mode.",
      "pins": [
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ElementNamesConfiguration.kt:16-79",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/BaseConfiguration.kt:114-121",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/ChannelDataOutputSerializer.kt:29-43",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/aggregations/Aggregator.kt:497-506",
        "targets/file-target/src/main/kotlin/com/amazonaws/sfc/filetarget/FileTargetWriter.kt:137"
      ],
      "modes": [
        "inprocess",
        "uberjar"
      ],
      "sinks": {
        "plain": {
          "kind": "file"
        },
        "agg": {
          "kind": "file"
        }
      },
      "gates": [
        {
          "sink": "plain",
          "records": 3
        },
        {
          "sink": "agg",
          "records": 2
        }
      ],
      "timeoutSeconds": 60,
      "modeParity": true,
      "assert": [
        {
          "kind": "deepEquals",
          "sink": "plain",
          "index": 0,
          "normalise": {
            "serial": "<UUID>",
            "isoTimestamps": "<ISO>"
          },
          "strictTypes": true,
          "value": {
            "sch": "Plain",
            "sn": "<UUID>",
            "ts": "<ISO>",
            "srcs": {
              "SrcName": {
                "vals": {
                  "ChanName": {
                    "v": 42.5,
                    "md": {
                      "c": "3"
                    },
                    "ts": "<ISO>"
                  }
                },
                "md": {
                  "b": "2"
                },
                "ts": "<ISO>"
              }
            },
            "md": {
              "a": "1"
            }
          }
        },
        {
          "kind": "keyOrder",
          "sink": "plain",
          "keys": [
            "sch",
            "sn",
            "ts",
            "srcs",
            "md"
          ]
        },
        {
          "kind": "deepEquals",
          "sink": "agg",
          "index": 0,
          "normalise": {
            "serial": "<UUID>",
            "isoTimestamps": "<ISO>"
          },
          "strictTypes": true,
          "path": "srcs.sa.vals.k",
          "value": {
            "v": {
              "min": {
                "v": 1
              },
              "values": {
                "v": [
                  {
                    "v": 1,
                    "ts": "<ISO>"
                  },
                  {
                    "v": 2,
                    "ts": "<ISO>"
                  },
                  {
                    "v": 3,
                    "ts": "<ISO>"
                  }
                ]
              }
            }
          },
          "comment": "First window of Size 3 over a counter starting at 1."
        },
        {
          "kind": "deepEquals",
          "sink": "agg",
          "index": 1,
          "normalise": {
            "serial": "<UUID>",
            "isoTimestamps": "<ISO>"
          },
          "strictTypes": true,
          "path": "srcs.sa.vals.k.v.min",
          "value": {
            "v": 4
          }
        },
        {
          "kind": "keyOrder",
          "sink": "agg",
          "keys": [
            "sch",
            "sn",
            "ts",
            "srcs",
            "md"
          ]
        },
        {
          "kind": "rawAbsent",
          "sink": "plain",
          "texts": [
            "\"schedule\"",
            "\"serial\"",
            "\"timestamp\"",
            "\"sources\"",
            "\"value\"",
            "\"metadata\"",
            "\"values\""
          ]
        },
        {
          "kind": "rawAbsent",
          "sink": "agg",
          "texts": [
            "\"schedule\"",
            "\"serial\"",
            "\"timestamp\"",
            "\"sources\"",
            "\"value\"",
            "\"metadata\""
          ]
        }
      ],
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "CORE-ENAMES-RENAME-01",
        "Version": 1,
        "LogLevel": "Info",
        "Metadata": {
          "a": "1"
        },
        "ElementNames": {
          "Schedule": "sch",
          "Serial": "sn",
          "Timestamp": "ts",
          "Sources": "srcs",
          "Values": "vals",
          "Value": "v",
          "Metadata": "md"
        },
        "Schedules": [
          {
            "Name": "Plain",
            "Interval": 100,
            "Active": true,
            "TimestampLevel": "Both",
            "Sources": {
              "sp": [
                "*"
