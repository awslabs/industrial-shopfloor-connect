    {
      "id": "CORE-ENAMES-RENAME-02",
      "title": "A target running as an IPC service ignores ElementNames and writes the default element names (known defect)",
      "tier": "core",
      "priority": "P1",
      "intent": "The IPC-mode half of CORE-ENAMES-RENAME-01. sfc-main sends each IPC target service a reduced configuration built by IpcTargetWriter.extractConfigurationForTarget, which copies AWSVersion, LogWriter, Metrics, Targets, Transformations, ValueFilters, TargetTypes, TargetServers, credential clients and secrets, but not ElementNames. IpcTargetServer then serialises with the defaults, so the same configuration produces differently named documents depending on deployment mode. IPC only, because that is the only mode with the defect; the other modes are covered by -01.",
      "pins": [
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcTargetWriter.kt:203-267",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcTargetServer.kt:143",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcTargetServer.kt:254"
      ],
      "modes": [
        "ipc"
      ],
      "records": 3,
      "timeoutSeconds": 90,
      "modeParity": false,
      "assert": [
        {
          "kind": "recordCount",
          "min": 3
        }
      ],
      "knownDefect": {
        "ref": "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcTargetWriter.kt:210",
        "summary": "IpcTargetWriter.extractConfigurationForTarget does not forward ElementNames to the IPC target service, so IPC targets write schedule/serial/timestamp/sources/values/value/metadata whatever the configuration says",
        "assertCurrent": [
          {
            "kind": "deepEquals",
            "index": 0,
            "normalise": {
              "serial": "<UUID>",
              "isoTimestamps": "<ISO>"
            },
            "strictTypes": true,
            "value": {
              "schedule": "Plain",
              "serial": "<UUID>",
              "timestamp": "<ISO>",
              "sources": {
                "SrcName": {
                  "values": {
                    "ChanName": {
                      "value": 42.5,
                      "metadata": {
                        "c": "3"
                      },
                      "timestamp": "<ISO>"
                    }
                  },
                  "metadata": {
                    "b": "2"
                  },
                  "timestamp": "<ISO>"
                }
              },
              "metadata": {
                "a": "1"
              }
            }
          }
        ],
        "assertCorrect": [
          {
            "kind": "deepEquals",
            "index": 0,
            "normalise": {
              "serial": "<UUID>",
              "isoTimestamps": "<ISO>"
            },
            "strictTypes": true,
            "value": {
              "sch": "Plain",
              "sn": "<UUID>",
              "ts": "<ISO>",
              "srcs": {
                "SrcName": {
                  "vals": {
                    "ChanName": {
                      "v": 42.5,
                      "md": {
                        "c": "3"
                      },
                      "ts": "<ISO>"
                    }
                  },
                  "md": {
                    "b": "2"
                  },
                  "ts": "<ISO>"
                }
              },
              "md": {
                "a": "1"
              }
            }
          }
        ]
      },
