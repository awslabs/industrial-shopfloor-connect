    {
      "id": "CORE-SCHED-MULTI-01",
      "title": "Two active schedules with different intervals run independently; an inactive schedule produces nothing",
      "tier": "core",
      "priority": "P0",
      "intent": "Most deployments run several schedules at different rates; a schedule that starved, merged with another, or ran although deactivated would corrupt every downstream series. MainControllerService.start builds a reader/writer pair per active schedule only, and each ScheduleController runs on its own interval. Each schedule has its own source and sink, so each must deliver its own gap-free counter from 0 with its own schedule name and metadata, while the inactive schedule's sink stays empty. No rate ratio is asserted, because that would depend on wall-clock time.",
      "pins": [
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/MainControllerService.kt:167-192",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ControllerServiceConfiguration.kt:87",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ScheduleConfiguration.kt:43-51"
      ],
      "sinks": {
        "fast": {
          "kind": "file"
        },
        "slow": {
          "kind": "file"
        },
        "off": {
          "kind": "file"
        }
      },
      "gates": [
        {
          "sink": "fast",
          "records": 20
        },
        {
          "sink": "slow",
          "records": 5
        }
      ],
      "timeoutSeconds": 60,
      "modeParity": false,
      "assert": [
        {
          "kind": "channelSequence",
          "sink": "fast",
          "source": "srcFast",
          "channel": "c",
          "step": 1
        },
        {
          "kind": "deepEquals",
          "sink": "fast",
          "index": 0,
          "path": "sources.srcFast.values.c.value",
