  "cases": [
    {
      "id": "CORE-SCHED-CHANNELS-01",
      "title": "Channel selection: [*], an explicit subset, [x, *], and '#'-disabled channels and sources",
      "tier": "core",
      "priority": "P1",
      "intent": "The schedule's channel list decides what is read. '*' means all channels, a list means exactly those, and a '#' prefix disables a channel (SourceConfiguration/SimulatorSourceConfiguration) or a schedule input (ScheduleConfiguration.sources) - even one naming a source that does not exist. Known defect: SourcesValuesAsFlow.channelList honours '*' only at index 0, while validation accepts it anywhere, so [fixed, *] reads 'fixed' and a channel literally named '*' whose null value is then dropped - 'ctr' is silently missing.",
      "pins": [
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/SourcesValuesAsFlow.kt:157-158",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ScheduleConfiguration.kt:62-69",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/SourceConfiguration.kt:34-38",
        "adapters/simulator/src/main/kotlin/com/amazonaws/sfc/simulator/config/SimulatorSourceConfiguration.kt:18-21",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ControllerServiceConfiguration.kt:358-364",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:766"
      ],
      "sinks": {
        "all": {
          "kind": "file"
        },
        "sub": {
          "kind": "file"
        },
        "weird": {
          "kind": "file"
        },
        "hash": {
          "kind": "file"
        }
      },
      "gates": [
        {
          "sink": "all",
          "records": 4
        },
        {
          "sink": "sub",
          "records": 4
        },
        {
          "sink": "weird",
          "records": 4
        },
        {
          "sink": "hash",
          "records": 4
        }
