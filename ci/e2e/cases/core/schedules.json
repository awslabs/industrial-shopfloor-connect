        {
          "kind": "channelSequence",
          "sink": "same",
          "source": "a1",
          "channel": "c",
          "step": 1
        },
        {
          "kind": "channelSequence",
          "sink": "two",
          "source": "b1",
          "channel": "c",
          "step": 1,
          "skipMissing": true
        },
        {
          "kind": "channelSequence",
          "sink": "two",
          "source": "b2",
          "channel": "c",
          "step": 1,
          "skipMissing": true
        },
        {
          "kind": "distinct",
          "sink": "two",
          "path": "sources.b1.values.c.value",
          "min": 3
        },
        {
          "kind": "distinct",
          "sink": "two",
          "path": "sources.b2.values.c.value",
          "min": 3
        }
      ],
