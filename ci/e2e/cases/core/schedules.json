    {
      "id": "CORE-SCHED-SOURCES-01",
      "title": "Several sources in one schedule: one adapter yields one combined record per read; two adapters yield gap-free values per source",
      "tier": "core",
      "priority": "P1",
      "intent": "A schedule usually reads several sources. MainControllerService creates one reader per protocol adapter, so sources on the same adapter are read in the same cycle and arrive in one record: a1 and a2 are in every record with equal counter values. With two adapters the ScheduleReader merges results from two readers and may emit partial records when one reader delivers twice before the other, so only per-source invariants are asserted: each source's counter is gap-free over the records that contain it. In IPC mode the two adapters are two separate services.",
      "pins": [
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/MainControllerService.kt:240-276",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:182-247",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/SourcesValuesAsFlow.kt:76-131"
      ],
      "sinks": {
        "same": {
          "kind": "file"
        },
        "two": {
          "kind": "file"
        }
      },
      "gates": [
        {
          "sink": "same",
          "records": 10
        },
        {
          "sink": "two",
          "records": 10
        }
      ],
      "timeoutSeconds": 60,
      "modeParity": false,
      "assert": [
        {
          "kind": "everyRecord",
          "sink": "same",
          "path": "sources.a1.values.c.value"
        },
        {
          "kind": "everyRecord",
          "sink": "same",
          "path": "sources.a2.values.c.value"
        },
        {
          "kind": "pathsEqual",
          "sink": "same",
          "a": "sources.a1.values.c.value",
          "b": "sources.a2.values.c.value",
          "comment": "Both counters advance once per combined read."
