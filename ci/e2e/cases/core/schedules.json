          "texts": [
            "\"off\"",
            "\"#off\""
          ]
        }
      ],
      "knownDefect": {
        "ref": "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/SourcesValuesAsFlow.kt:158",
        "summary": "'*' selects all channels only as the first list element (SourcesValuesAsFlow.kt:158); [\"fixed\", \"*\"] passes validation but reads only 'fixed'",
