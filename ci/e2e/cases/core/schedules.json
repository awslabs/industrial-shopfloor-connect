    {
      "id": "CORE-SCHED-IDLE-01",
      "title": "When no schedule can start because its target cannot be created, SFC idles forever: no output and no exit (known defect)",
      "tier": "core",
      "priority": "P2",
      "intent": "A deployment whose only target is misconfigured should fail visibly so that a supervisor restarts it or an operator notices. Here the file target's type is registered under the name 'FILE' instead of 'FILE-TARGET'; the core accepts any TargetTypes name, but FileTargetWriterConfiguration only sees targets of type FILE-TARGET, so the writer's constructor throws 'Configuration for type FILE-TARGET for target with ID \"FileTarget\" does not exist'. InstanceFactory.createInstance logs it and returns null, the schedule without writers is dropped, MainControllerService.blockUntilShutdown returns at once on the empty map, and ServiceMain goes back to waiting for a new configuration. The case waits for the error, lets SFC settle, and finds it still running with nothing written: the runner has to SIGTERM it (exit 143). The same mechanism applies to adapters (CORE-SIM-INVALID-01). In-process and uberjar only: in IPC mode sfc-main holds an IPC writer for the remote service, so the schedule is not dropped and the failure takes a different path (an IPC-area concern). Note: the catalog's original trigger, a file target Interval of 30, does not work - FileTargetConfiguration.validate() is never called.",
      "pins": [
        "targets/file-target/src/main/kotlin/com/amazonaws/sfc/filetarget/FileTargetWriter.kt:67-69",
        "targets/file-target/src/main/kotlin/com/amazonaws/sfc/filetarget/config/FileTargetWriterConfiguration.kt:28-29",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/util/InstanceFactory.kt:62-71",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/MainControllerService.kt:176",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/MainControllerService.kt:452-456",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/service/ServiceMain.kt:100-118"
      ],
      "modes": [
        "inprocess",
        "uberjar"
      ],
      "steps": [
        {
          "wait": {
            "log": "Configuration for type FILE-TARGET for target with ID \"FileTarget\" does not exist"
          }
        },
        {
          "wait": {
            "seconds": 3,
            "comment": "Nothing observable happens when SFC idles; the settle gives a process that would exit on its own the time to do so."
          }
        }
      ],
      "failFast": [],
      "timeoutSeconds": 30,
      "modeParity": false,
      "assert": [
        {
          "kind": "recordCount",
          "equals": 0
        },
        {
          "kind": "logContains",
          "text": "Error creating instance of \"com.amazonaws.sfc.filetarget.FileTargetWriter\""
        }
      ],
      "knownDefect": {
        "ref": "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/MainControllerService.kt:176",
        "summary": "A target (or adapter) that fails to construct is logged and replaced by null (InstanceFactory.kt:71); its schedule is dropped (MainControllerService.kt:176), blockUntilShutdown returns on the empty map (:452-456) and ServiceMain waits for a new configuration (ServiceMain.kt:100-118), so SFC idles without output and never exits",
        "assertCurrent": [
          {
            "kind": "exitCode",
            "equals": 143,
            "comment": "143 = still running when the runner sent SIGTERM."
          }
        ],
        "assertCorrect": [
          {
            "kind": "exitCode",
            "equals": 1,
            "comment": "Like every other configuration error (ServiceMain exitProcess(1))."
          }
        ]
      },
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "CORE-SCHED-IDLE-01",
        "Version": 1,
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "S",
            "Interval": 100,
            "Active": true,
            "Sources": {
              "sim": [
                "*"
              ]
            },
            "Targets": [
              "FileTarget"
            ]
          }
        ],
        "Sources": {
          "sim": {
            "Name": "sim",
            "ProtocolAdapter": "SimAdapter",
            "Channels": {
              "ctr": {
                "Name": "ctr",
                "Simulation": {
                  "SimulationType": "Counter",
                  "DataType": "Int",
                  "Min": 0,
                  "Max": 100000
                }
              }
            }
          }
        },
        "Targets": {
          "FileTarget": {
            "Active": true,
            "TargetType": "FILE",
            "Directory": "${SFC_E2E_SINK}",
            "Json": true,
            "UtcTime": true,
            "Extension": ".json",
            "BufferSize": 1,
            "BufferCount": 1,
            "Interval": 60
          }
        },
        "ProtocolAdapters": {
          "SimAdapter": {
            "AdapterType": "SIMULATOR"
          }
        },
        "Metrics": {
          "Interval": 1,
          "Writer": {}
        },
        "Metadata": {
          "runId": "${SFC_E2E_RUN_ID}",
          "case": "${SFC_E2E_CASE}",
          "mode": "${SFC_E2E_MODE}",
          "marker": "${SFC_E2E_MARKER}"
        }
      },
      "uberjar": {
        "AdapterTypes": {
          "SIMULATOR": {
            "FactoryClassName": "com.amazonaws.sfc.simulator.SimulatorAdapter"
          }
        },
        "TargetTypes": {
          "FILE": {
            "FactoryClassName": "com.amazonaws.sfc.filetarget.FileTargetWriter"
          }
        },
        "Metrics": {
