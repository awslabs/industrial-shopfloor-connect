      "timeoutSeconds": 60,
      "modeParity": true,
      "assert": [
        {
          "kind": "keySet",
          "sink": "all",
          "path": "sources.simAll.values",
          "keys": [
            "ctr",
            "fixed"
          ],
          "comment": "'#off' is disabled and never read."
        },
        {
          "kind": "channelSequence",
          "sink": "all",
          "source": "simAll",
          "channel": "ctr",
          "step": 1
        },
        {
          "kind": "keySet",
          "sink": "sub",
          "path": "sources.simSub.values",
          "keys": [
            "fixed"
          ]
        },
        {
          "kind": "keySet",
          "sink": "hash",
          "path": "sources",
          "keys": [
            "simHash"
          ],
