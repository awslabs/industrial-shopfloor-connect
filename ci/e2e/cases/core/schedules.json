    {
      "id": "CORE-SCHED-SILENT-01",
      "title": "A schedule whose only target is inactive or misspelled is dropped without an error or a log line",
      "tier": "core",
      "priority": "P1",
      "intent": "A misspelled target name is a common configuration error, and it should be reported. createTargetWritersForSchedule filters schedule.targets on config.targets[t]?.active == true before its 'does not exist' and 'is not active' branches, so both branches are dead; the schedule without writers is then dropped (MainControllerService.kt:176), which also makes ScheduleWriter's 'No active targets' error unreachable, and no validation checks schedule target names. The control schedule proves SFC is running; the inactive target's sink stays empty, and the typo is never mentioned in any log.",
      "pins": [
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/MainControllerService.kt:172-177",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/MainControllerService.kt:283",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/MainControllerService.kt:292-299",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleWriter.kt:121-123"
      ],
      "sinks": {
        "main": {
          "kind": "file"
        },
        "off": {
          "kind": "file"
        }
      },
      "records": 10,
      "timeoutSeconds": 60,
      "modeParity": false,
      "assert": [
        {
          "kind": "channelSequence",
          "source": "srcCtl",
          "channel": "c",
          "step": 1
        },
        {
          "kind": "everyRecord",
          "path": "schedule",
          "equals": "Control"
        },
        {
          "kind": "recordCount",
          "sink": "off",
          "equals": 0
        }
      ],
      "knownDefect": {
        "ref": "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/MainControllerService.kt:283",
        "summary": "Schedule targets are filtered on 'exists and active' before the branches that would log a missing or inactive target (MainControllerService.kt:283 vs :292-299), and no validation checks target names, so a misspelled target silently disables its schedule",
        "assertCurrent": [
          {
            "kind": "logAbsent",
            "texts": [
              "FileTargte",
              "No active targets for schedule"
            ]
          }
        ],
        "assertCorrect": [
          {
            "kind": "logContains",
            "text": "FileTargte"
          }
        ]
      },
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "CORE-SCHED-SILENT-01",
        "Version": 1,
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "Control",
            "Interval": 100,
            "Active": true,
            "Sources": {
              "srcCtl": [
                "*"
              ]
            },
            "Targets": [
              "FileTarget"
            ]
          },
          {
            "Name": "Inactive",
            "Interval": 100,
            "Active": true,
            "Sources": {
              "srcOff": [
                "*"
              ]
            },
            "Targets": [
              "OffTarget"
            ]
          },
          {
            "Name": "Typo",
            "Interval": 100,
            "Active": true,
