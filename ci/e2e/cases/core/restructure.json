    {
      "id": "CORE-RESTRUCT-02",
      "title": "Spread on a list of primitives removes the channel instead of spreading it (known defect)",
      "tier": "core",
      "intent": "The docs say Spread turns every element of a list into a separate value named '<name>.<index>' and removes the list (docs/core/channel-configuration.md:99-103). spreadChannelValues only creates entries for elements that are Maps (ScheduleReader.kt:494-498) but removes the list unconditionally (:503-505), so a list of numbers - a register block, a 3-element counter here - silently disappears from the output. (Spread of a list of structures cannot be produced by the simulator: a List simulation coerces items to a scalar DataType.) The unspread counter is the control and the record source.",
      "pins": [
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:471-512",
        "docs/core/channel-configuration.md:99-103",
        "adapters/simulator/src/main/kotlin/com/amazonaws/sfc/simulator/simulations/List.kt"
      ],
      "records": 3,
      "timeoutSeconds": 60,
      "modeParity": true,
      "assert": [
        {
          "kind": "recordCount",
          "min": 3
        },
        {
          "kind": "channelSequence",
          "source": "sim",
          "channel": "ctr",
          "step": 1
        }
      ],
      "knownDefect": {
        "ref": "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:495",
        "summary": "Spread keeps only Map elements of a list but always removes the list, so a list of primitives vanishes",
        "assertCurrent": [
          {
            "kind": "keySet",
            "path": "sources.sim.values",
            "keys": [
              "ctr"
            ]
          }
        ],
        "assertCorrect": [
          {
            "kind": "deepEquals",
            "index": 0,
            "path": [
              "sources",
              "sim",
              "values",
              "arr.0",
              "value"
            ],
            "value": 0
          },
          {
            "kind": "deepEquals",
            "index": 0,
            "path": [
              "sources",
              "sim",
              "values",
              "arr.2",
              "value"
            ],
            "value": 2
          },
          {
            "kind": "deepEquals",
            "index": 1,
            "path": [
              "sources",
              "sim",
              "values",
              "arr.0",
              "value"
            ],
            "value": 3
          }
        ]
      },
      "priority": "P1",
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "CORE-RESTRUCT-02",
        "Version": 1,
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "S",
            "Interval": 100,
            "Active": true,
            "TimestampLevel": "None",
            "Sources": {
              "sim": [
                "*"
              ]
            },
            "Targets": [
              "FileTarget"
            ]
          }
        ],
        "Sources": {
          "sim": {
            "Name": "sim",
            "ProtocolAdapter": "SimAdapter",
            "Channels": {
              "ctr": {
                "Name": "ctr",
                "Simulation": {
                  "SimulationType": "Counter",
                  "DataType": "Int",
                  "Min": 0,
                  "Max": 100000,
                  "Step": 1
