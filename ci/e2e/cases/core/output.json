    {
      "id": "CORE-OUT-UNQUOTE-01",
      "title": "UnquoteNumericJsonValues un-quotes unsigned numbers, but also numeric-looking strings and metadata",
      "tier": "core",
      "priority": "P1",
      "intent": "Gson's unsigned adapters write UByte/UShort/UInt as JSON strings, and UnquoteNumericJsonValues exists to turn them back into numbers for consumers that need numeric types. TargetData.toJson implements it as a regex over the whole rendered document, so any string that looks like a non-negative number is un-quoted too: a String channel '100' and channel metadata '7' change type. One schedule writes to a target without and a target with the option. Sink q pins the quoting baseline; sink u pins the un-quoting and the collateral damage as a known defect. In-process and uberjar only: the IPC adapter transport already encodes UInt as a signed Long (GrpcSourceValueFromNativeExt.kt:280), so there is nothing quoted to un-quote; CORE-SIM-DATATYPES-02 pins that divergence.",
      "pins": [
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/TargetData.kt:78-85",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/TargetData.kt:110",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/JsonHelper.kt:91-101"
      ],
      "modes": [
        "inprocess",
        "uberjar"
      ],
      "sinks": {
        "q": {
          "kind": "file"
        },
        "u": {
          "kind": "file"
        }
      },
      "gates": [
        {
          "sink": "q",
          "records": 3
        },
        {
          "sink": "u",
          "records": 3
        }
      ],
      "timeoutSeconds": 60,
      "modeParity": true,
      "assert": [
        {
          "kind": "everyRecord",
          "sink": "q",
          "path": "sources.sim.values.u.value",
          "equals": "7",
          "strictTypes": true,
          "comment": "JsonHelper.UIntAdapter writes UInt as a string."
        },
        {
          "kind": "everyRecord",
          "sink": "q",
          "path": "sources.sim.values.s.value",
          "equals": "100",
          "strictTypes": true
        },
        {
          "kind": "everyRecord",
          "sink": "q",
          "path": "sources.sim.values.n.value",
          "equals": "-42",
          "strictTypes": true
        },
        {
          "kind": "everyRecord",
          "sink": "q",
          "path": "sources.sim.values.u.metadata.line",
          "equals": "7",
          "strictTypes": true
        },
        {
          "kind": "everyRecord",
          "sink": "u",
          "path": "sources.sim.values.u.value",
          "equals": 7,
          "strictTypes": true,
          "comment": "The feature: the unsigned value becomes a JSON number."
        },
        {
          "kind": "everyRecord",
          "sink": "u",
          "path": "sources.sim.values.n.value",
          "equals": "-42",
          "strictTypes": true
        }
      ],
      "knownDefect": {
        "ref": "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/TargetData.kt:81",
        "summary": "UnquoteNumericJsonValues applies the regex \"(\\d+(\\.\\d*)?)\" to the whole document (TargetData.kt:81-83,110), so genuine String values and metadata that look like numbers are un-quoted as well",
        "assertCurrent": [
          {
            "kind": "everyRecord",
            "sink": "u",
            "path": "sources.sim.values.s.value",
            "equals": 100,
            "strictTypes": true
          },
          {
            "kind": "everyRecord",
            "sink": "u",
            "path": "sources.sim.values.u.metadata.line",
            "equals": 7,
            "strictTypes": true
          }
        ],
        "assertCorrect": [
          {
            "kind": "everyRecord",
            "sink": "u",
            "path": "sources.sim.values.s.value",
            "equals": "100",
            "strictTypes": true
          },
          {
            "kind": "everyRecord",
            "sink": "u",
            "path": "sources.sim.values.u.metadata.line",
            "equals": "7",
            "strictTypes": true
          }
        ]
      },
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "CORE-OUT-UNQUOTE-01",
        "Version": 1,
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "S",
            "Interval": 100,
            "Active": true,
            "Sources": {
              "sim": [
                "*"
              ]
            },
            "Targets": [
              "FileQ",
              "FileU"
            ]
          }
        ],
        "Sources": {
          "sim": {
            "Name": "sim",
            "ProtocolAdapter": "SimAdapter",
            "Channels": {
              "u": {
                "Name": "u",
