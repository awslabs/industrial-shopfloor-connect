    {
      "id": "CORE-OUT-NULLS-01",
      "title": "Null channel values are dropped next to data, but a read whose values are all null still emits a message without 'sources'",
      "tier": "core",
      "priority": "P1",
      "intent": "A null reading must not reach consumers as data. ScheduleReader.buildOutputValues drops null channels and then sources without channels, so a null next to a value simply disappears (schedule A: an Interval channel that never fires). With no filter configured, however, the emptiness check runs on the restructured data before nulls are removed, and ScheduleWriter writes whatever it receives: schedule B, whose only value is Sqrt(-1) -> NaN -> null, emits an envelope without 'sources' on every read. The null is produced in sfc-main, so this is the same in every mode. srcB has its own protocol adapter so that in IPC mode each schedule talks to its own adapter service: with one shared service only one schedule's first stream hits the known gRPC UNKNOWN retry, and schedule A could fill the gate before B wrote anything.",
      "pins": [
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:339",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:582",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:766-776",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleWriter.kt:145-153",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/transformations/Sqrt.kt:22"
      ],
      "sinks": {
        "a": {
          "kind": "file"
        },
        "b": {
          "kind": "file"
        }
      },
      "gates": [
        {
          "sink": "a",
          "records": 30
        }
      ],
      "timeoutSeconds": 60,
      "modeParity": false,
      "assert": [
        {
          "kind": "keySet",
          "sink": "a",
          "path": "sources.srcA.values",
          "keys": [
            "ctr"
          ],
          "comment": "nul is null on every read and is dropped."
        },
        {
          "kind": "channelSequence",
          "sink": "a",
          "source": "srcA",
          "channel": "ctr",
          "step": 1
        }
      ],
      "knownDefect": {
        "ref": "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleReader.kt:339",
        "summary": "With no filter configured the emptiness check (ScheduleReader.kt:339) runs before null values are removed (:766, :776), and ScheduleWriter writes the empty result, so every all-null read emits a message without 'sources'",
        "assertCurrent": [
          {
            "kind": "recordCount",
            "sink": "b",
            "min": 5
          },
          {
            "kind": "keysAbsent",
            "sink": "b",
            "paths": [
              "sources"
            ]
          },
          {
            "kind": "everyRecord",
            "sink": "b",
            "path": "schedule",
            "equals": "B"
          }
        ],
        "assertCorrect": [
          {
            "kind": "recordCount",
            "sink": "b",
            "equals": 0
          }
        ]
      },
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "CORE-OUT-NULLS-01",
        "Version": 1,
        "LogLevel": "Info",
        "Transformations": {
          "Sq": [
            {
              "Operator": "Sqrt"
            }
          ]
        },
        "Schedules": [
          {
            "Name": "A",
            "Interval": 100,
            "Active": true,
            "Sources": {
              "srcA": [
                "*"
              ]
            },
            "Targets": [
              "FileA"
            ]
          },
          {
            "Name": "B",
            "Interval": 100,
            "Active": true,
            "Sources": {
              "srcB": [
                "*"
              ]
            },
            "Targets": [
              "FileB"
            ]
          }
        ],
        "Sources": {
          "srcA": {
            "Name": "srcA",
            "ProtocolAdapter": "SimAdapter",
            "Channels": {
              "ctr": {
                "Name": "ctr",
