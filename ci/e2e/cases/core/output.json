    {
      "id": "CORE-OUT-SERIAL-01",
      "title": "serial is a fresh UUIDv4 per message and identical across the targets of one schedule",
      "tier": "core",
      "priority": "P1",
      "intent": "The serial is the key for de-duplication and for correlating one reading across destinations. ScheduleWriter draws one UUID.randomUUID() per message and passes it to the TargetData of every target of the schedule (each target gets its own root timestamp). Two file targets write into one directory, so the case can join their records by counter value: each value arrives exactly twice with a single serial, while serials differ between messages.",
      "pins": [
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleWriter.kt:150-153"
      ],
      "records": 16,
      "timeoutSeconds": 60,
      "modeParity": false,
      "assert": [
        {
          "kind": "everyRecord",
          "path": "serial",
          "regex": "[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}"
        },
        {
          "kind": "distinct",
          "path": "serial",
          "min": 8,
          "comment": "16 records from two targets are at least 8 messages; a serial that did not change per message would give 1."
        },
        {
          "kind": "recordCount",
          "where": {
            "sources.sim.values.c.value": 0
          },
          "equals": 2,
          "comment": "Message 0 reached both targets."
        },
        {
          "kind": "distinct",
          "where": {
            "sources.sim.values.c.value": 0
          },
          "path": "serial",
          "equals": 1,
          "comment": "Both copies of one message carry the same serial."
        },
        {
          "kind": "recordCount",
          "where": {
            "sources.sim.values.c.value": 1
          },
          "equals": 2,
          "comment": "Message 1 reached both targets."
        },
        {
          "kind": "distinct",
          "where": {
            "sources.sim.values.c.value": 1
          },
          "path": "serial",
          "equals": 1,
          "comment": "Both copies of one message carry the same serial."
        },
        {
          "kind": "recordCount",
          "where": {
            "sources.sim.values.c.value": 2
          },
          "equals": 2,
          "comment": "Message 2 reached both targets."
        },
        {
          "kind": "distinct",
          "where": {
            "sources.sim.values.c.value": 2
          },
          "path": "serial",
          "equals": 1,
          "comment": "Both copies of one message carry the same serial."
        },
        {
          "kind": "recordCount",
          "where": {
            "sources.sim.values.c.value": 3
          },
          "equals": 2,
          "comment": "Message 3 reached both targets."
        },
        {
          "kind": "distinct",
          "where": {
            "sources.sim.values.c.value": 3
          },
          "path": "serial",
          "equals": 1,
          "comment": "Both copies of one message carry the same serial."
        },
        {
          "kind": "fileNameRegex",
          "regex": "[0-9a-f-]{36}\\.(a|b)\\.json"
        }
      ],
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "CORE-OUT-SERIAL-01",
        "Version": 1,
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "S",
            "Interval": 100,
            "Active": true,
            "Sources": {
              "sim": [
                "*"
              ]
            },
            "Targets": [
              "FileA",
