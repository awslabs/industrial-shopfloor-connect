{
  "cases": [
    {
      "id": "AWS-FH-01",
      "title": "Firehose BatchSize 1: every record is its own PutRecordBatch call and comes back unchanged out of the objects the delivery stream writes to S3",
      "tier": "aws",
      "priority": "P0",
      "intent": "The basic Firehose contract against the real service. With BatchSize 1 every record is flushed on arrival (AwsKinesisFirehoseTargetWriter.kt:167) as a one-record PutRecordBatch (:197-204) - the only call the client declares (AwsFirehoseClient.kt:17) and the one grantPutRecords allows - whose data is the record's JSON plus a newline (:284-288). The stack's DirectPut stream delivers to S3 with 0 s buffering; the sink parses the delivered objects as concatenated JSON (SFC pretty-prints, so a record spans lines), keeps this run's records by marker and, because delivery keeps no order, reads on after SFC stops until nothing new arrives for 8 s. The case fails if a record is lost or duplicated (the counter set must be contiguous), if the record is altered on the way (SFC's key order, Int type), if SFC batches despite BatchSize 1 (Messages/Writes must be exactly 1), or if a request or per-record failure is logged or a WriteError counted.",
      "pins": [
        "targets/aws-kinesis-firehose-target/src/main/kotlin/com/amazonaws/sfc/awsfirehose/AwsKinesisFirehoseTargetWriter.kt:167",
        "targets/aws-kinesis-firehose-target/src/main/kotlin/com/amazonaws/sfc/awsfirehose/AwsKinesisFirehoseTargetWriter.kt:197-204",
        "targets/aws-kinesis-firehose-target/src/main/kotlin/com/amazonaws/sfc/awsfirehose/AwsKinesisFirehoseTargetWriter.kt:261-262",
        "targets/aws-kinesis-firehose-target/src/main/kotlin/com/amazonaws/sfc/awsfirehose/AwsKinesisFirehoseTargetWriter.kt:284-288",
        "targets/aws-kinesis-firehose-target/src/main/kotlin/com/amazonaws/sfc/awsfirehose/AwsFirehoseClient.kt:17",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/TargetDataSerializer.kt:29-45",
        "ci/cdk/lib/sfc-it-stack.ts:200-210",
        "ci/cdk/lib/sfc-it-stack.ts:426"
      ],
      "sinks": {
        "main": {
          "kind": "firehose"
        }
      },
      "gate": {
        "sink": "main",
        "records": 6,
        "timeoutSeconds": 180
      },
      "timeoutSeconds": 90,
      "offlineSeconds": 25,
      "steps": [
        {
          "wait": {
            "metric": {
              "source": "Fh",
              "name": "Writes",
              "op": "ge",
              "value": 6
            }
          }
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "min": 6
        },
        {
          "kind": "channelValueRun",
          "source": "sim",
          "channel": "ctr",
          "comment": "Firehose keeps no order: a contiguous set once the sink has drained, no duplicates"
        },
        {
          "kind": "keyOrder",
          "keys": [
            "schedule",
            "serial",
            "timestamp",
            "sources",
            "metadata"
          ],
          "comment": "SFC's own serialisation (TargetDataSerializer), not wrapped or reordered on the way"
        },
        {
          "kind": "everyRecord",
          "path": "schedule",
          "equals": "S"
        },
        {
          "kind": "everyRecord",
          "path": "sources.sim.values.ctr.value",
          "type": "int"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "Fh",
            "name": "Messages"
          },
          "denominator": {
            "source": "Fh",
            "name": "Writes"
          },
          "op": "eq",
          "value": 1,
          "comment": "BatchSize 1: one record per PutRecordBatch"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error sending to kinesis firehose delivery stream",
            "Error sending target data",
            "No records to send to kinesis firehose delivery stream",
            "Error in AWS Kinesis Firehose writer",
            "NoClassDefFoundError",
            "ClassNotFoundException"
          ],
          "comment": "'Error sending target data' is a per-record failure inside a 200 response: it is not counted as a WriteError (:227-236)"
        }
      ],
      "config": {
