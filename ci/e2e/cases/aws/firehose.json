    {
      "id": "AWS-FH-NEG-01",
      "title": "Firehose: a record over 1000 KiB fails its whole PutRecordBatch - counted as a WriteError while later batches keep flowing - and takes the valid record batched with it down too (known defect)",
      "tier": "aws",
      "priority": "P1",
      "intent": "Firehose limits a record to 1,000 KiB (Record.Data, 1,024,000 bytes) and rejects a PutRecordBatch holding a larger one as a whole, with a 400. SFC checks only the batch total against 4 MiB (AwsKinesisFirehoseTargetWriter.kt:155-158, :377), never the single record, so an oversize record is batched like any other. FhMixed sends pairs (BatchSize 2) of one-line template records; the template pads ctr 12 to 1.1 MB and flags its neighbours ctr 11 and 13 with nb: true. The request carrying ctr 12 is rejected and not retried (a 400 is not retryable, AwsServiceClientHelper.kt:75-86); the whole buffer is reported as errors and one WriteError counted (:205-219, :238-245); later pairs keep flowing. Which neighbour shares the rejected request depends on batch alignment, but exactly one does, so today exactly one nb record arrives where both should: the SQS target drops only the oversize message, before batching (AwsSqsTargetWriter.kt:201-205). With the default BatchSize 10 one oversize record costs up to nine valid ones. The case fails if the oversize record ever arrives, if the failure is not counted, if the stream stops after it (16 records need pairs beyond ctr 13), or (assert-correct) while the valid batch-mate is lost.",
      "pins": [
        "targets/aws-kinesis-firehose-target/src/main/kotlin/com/amazonaws/sfc/awsfirehose/AwsKinesisFirehoseTargetWriter.kt:155-158",
        "targets/aws-kinesis-firehose-target/src/main/kotlin/com/amazonaws/sfc/awsfirehose/AwsKinesisFirehoseTargetWriter.kt:205-219",
        "targets/aws-kinesis-firehose-target/src/main/kotlin/com/amazonaws/sfc/awsfirehose/AwsKinesisFirehoseTargetWriter.kt:238-245",
        "targets/aws-kinesis-firehose-target/src/main/kotlin/com/amazonaws/sfc/awsfirehose/AwsKinesisFirehoseTargetWriter.kt:377",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/client/AwsServiceClientHelper.kt:75-86",
        "targets/aws-sqs-target/src/main/kotlin/com/amazonaws/sfc/awssqs/AwsSqsTargetWriter.kt:201-205"
      ],
      "sinks": {
        "main": {
          "kind": "firehose"
        }
      },
      "gate": {
        "sink": "main",
        "records": 16,
        "timeoutSeconds": 180
      },
      "timeoutSeconds": 90,
      "offlineSeconds": 25,
      "allowWriteErrors": [
        "FhMixed"
      ],
      "steps": [
        {
          "wait": {
            "metric": {
              "source": "FhMixed",
              "name": "WriteError",
              "op": "ge",
              "value": 1
            }
          }
        },
        {
          "wait": {
            "metric": {
              "source": "FhMixed",
              "name": "Writes",
              "op": "ge",
              "value": 10
            }
          }
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "min": 16,
          "comment": "at most 12 records precede ctr 11, so the stream went on after the rejected request"
        },
        {
          "kind": "keysAbsent",
          "paths": [
            "big"
          ],
          "comment": "the oversize record never reached S3"
        },
        {
          "kind": "recordCount",
          "where": {
            "nb": true
          },
          "min": 1
        },
        {
          "kind": "noDuplicates",
          "path": "serial"
        },
        {
          "kind": "metric",
          "source": "FhMixed",
          "name": "WriteError",
          "op": "ge",
          "value": 1,
          "comment": "the rejected request is counted"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "FhMixed",
            "name": "Messages"
          },
          "denominator": {
            "source": "FhMixed",
            "name": "Writes"
          },
          "op": "eq",
          "value": 2,
          "comment": "every successful PutRecordBatch carried a full pair"
        }
      ],
      "knownDefect": {
        "ref": "targets/aws-kinesis-firehose-target/src/main/kotlin/com/amazonaws/sfc/awsfirehose/AwsKinesisFirehoseTargetWriter.kt:155-158",
        "summary": "No per-record size check before batching (only the 4 MiB batch total): Firehose rejects the whole PutRecordBatch for one record over 1,024,000 bytes, so the valid records batched with it are lost too; the SQS target drops only the oversize message (AwsSqsTargetWriter.kt:201-205)",
        "assertCurrent": [
          {
            "kind": "recordCount",
            "where": {
              "nb": true
            },
            "equals": 1,
            "comment": "ctr 11 or ctr 13 shared the rejected request with ctr 12"
          },
          {
            "kind": "logRegex",
            "regex": "Error sending to kinesis firehose delivery stream \"[^\"]*\" for target \"FhMixed\""
          },
          {
            "kind": "logContains",
            "text": "Status Code: 400",
            "comment": "the service rejected the request; a client-side check would never have sent it"
          }
        ],
        "assertCorrect": [
          {
            "kind": "recordCount",
            "where": {
              "nb": true
            },
            "equals": 2,
            "comment": "only ctr 12 is lost; both neighbours arrive"
          }
        ]
