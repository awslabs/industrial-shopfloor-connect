    {
      "id": "AWS-FH-03",
      "title": "Firehose Template: each record is the rendered template plus a newline; a template that does not parse loses every record without counting a WriteError (known defect)",
      "tier": "aws",
      "priority": "P1",
      "intent": "With a Template each Firehose record is the rendered text plus the newline the target appends (AwsKinesisFirehoseTargetWriter.kt:131-135, :286); the template file's own final newline is dropped (OutputTransformation.kt:45), so a one-line template gives one line per record - the NDJSON that line-oriented S3 consumers read, which SFC's pretty-printed default (TargetData.kt:78, :100) is not. FhTpl's records must be exactly the template's document: its key order (no SFC timestamp, no wrapper), the constant tpl field, a serial per record and a contiguous counter. FhBroken, in the same schedule, has a template that does not parse: the error is logged once and transform() returns null from then on (OutputTransformation.kt:49-52, :65-67), buildPayload makes that an empty payload, which TargetDataBuffer does not keep while still counting the record (TargetDataBuffer.kt:27). Every flush therefore finds an empty request: it logs 'No records to send', reports the records as errors and returns (AwsKinesisFirehoseTargetWriter.kt:191-195) before WriteError is counted, as the exception path does (:240). Every FhBroken record is lost while Writes and WriteError both stay 0, so a dashboard shows an idle target, not a failing one. The case fails if the template output is wrapped or altered, if FhBroken ever sends, or (assert-correct) while that loss goes uncounted.",
      "pins": [
        "targets/aws-kinesis-firehose-target/src/main/kotlin/com/amazonaws/sfc/awsfirehose/AwsKinesisFirehoseTargetWriter.kt:131-135",
        "targets/aws-kinesis-firehose-target/src/main/kotlin/com/amazonaws/sfc/awsfirehose/AwsKinesisFirehoseTargetWriter.kt:191-195",
        "targets/aws-kinesis-firehose-target/src/main/kotlin/com/amazonaws/sfc/awsfirehose/AwsKinesisFirehoseTargetWriter.kt:238-240",
        "targets/aws-kinesis-firehose-target/src/main/kotlin/com/amazonaws/sfc/awsfirehose/AwsKinesisFirehoseTargetWriter.kt:286",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/OutputTransformation.kt:45",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/OutputTransformation.kt:49-52",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/OutputTransformation.kt:65-67",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/TargetDataBuffer.kt:27",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/TargetData.kt:78"
      ],
      "sinks": {
        "main": {
          "kind": "firehose"
        }
      },
      "gate": {
        "sink": "main",
        "records": 6,
        "timeoutSeconds": 180
      },
      "timeoutSeconds": 90,
      "offlineSeconds": 25,
      "allowWriteErrors": [
        "FhBroken"
      ],
      "steps": [
        {
          "wait": {
            "log": "No records to send to kinesis firehose delivery stream",
            "count": 4
          }
        },
        {
          "wait": {
            "metric": {
              "source": "FhTpl",
              "name": "Writes",
              "op": "ge",
              "value": 6
            }
          }
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "min": 6
        },
        {
          "kind": "keyOrder",
          "keys": [
            "metadata",
            "schedule",
            "serial",
            "sources",
            "tpl"
          ],
          "comment": "exactly the template's document: no SFC envelope, no timestamp"
        },
        {
          "kind": "everyRecord",
          "path": "tpl",
          "equals": "fh-e2e-tpl"
        },
        {
          "kind": "everyRecord",
          "path": "schedule",
          "equals": "S"
        },
        {
          "kind": "everyRecord",
          "path": "serial",
          "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
        },
        {
          "kind": "noDuplicates",
          "path": "serial"
        },
        {
          "kind": "channelValueRun",
          "source": "sim",
          "channel": "ctr",
          "comment": "template numbers render as Double (pinned by TGT-FILE-TPL-01); the run compares them as integers"
        },
        {
          "kind": "logContains",
          "text": "Error creating velocity template from file template file"
        },
        {
          "kind": "logContains",
          "text": "No records to send to kinesis firehose delivery stream",
          "min": 4
        },
        {
          "kind": "metric",
          "source": "FhBroken",
          "name": "Writes",
          "op": "eq",
          "value": 0,
          "comment": "nothing was ever sent for FhBroken"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error sending to kinesis firehose delivery stream",
            "Error sending target data"
          ]
        }
      ],
      "knownDefect": {
        "ref": "targets/aws-kinesis-firehose-target/src/main/kotlin/com/amazonaws/sfc/awsfirehose/AwsKinesisFirehoseTargetWriter.kt:191-195",
        "summary": "A flush whose payloads all rendered empty (here: an unparsable template) logs 'No records to send' and drops the records, but returns before WriteError is counted (the exception path does, :240): the loss is invisible in metrics",
        "assertCurrent": [
          {
            "kind": "metric",
            "source": "FhBroken",
            "name": "WriteError",
            "op": "eq",
            "value": 0
          }
        ],
        "assertCorrect": [
          {
            "kind": "metric",
            "source": "FhBroken",
            "name": "WriteError",
            "op": "ge",
            "value": 1
          }
        ]
      },
      "config": {
