    {
      "id": "AWS-SQS-NEG-01",
      "title": "SQS: a record over 1 MiB is dropped before sending while normal records keep flowing - and no WriteError is counted (known defect)",
      "tier": "aws",
      "priority": "P1",
      "intent": "SQS rejects messages over 1 MiB, so SFC checks the payload length first (SQS_MAX_BATCH_MSG_SIZE, AwsSqsTargetWriter.kt:201-205, 416): SqsBig renders a 1.1 M-character template and must never reach the queue, while SqsSmall in the same schedule keeps delivering. The check only logs and reports the record as an error to a result handler; it does not increment WriteError, so a dashboard shows no failure while every SqsBig record is lost. The IoT Core target does count its oversize payloads (AwsIotCoreTargetWriter.kt:357), which is why this is pinned as a defect rather than accepted.",
      "pins": [
        "targets/aws-sqs-target/src/main/kotlin/com/amazonaws/sfc/awssqs/AwsSqsTargetWriter.kt:201-205",
        "targets/aws-sqs-target/src/main/kotlin/com/amazonaws/sfc/awssqs/AwsSqsTargetWriter.kt:416",
        "targets/aws-iot-core-target/src/main/kotlin/com/amazonaws/sfc/awsiotcore/AwsIotCoreTargetWriter.kt:354-357"
      ],
      "sinks": {
        "main": {
          "kind": "sqs"
        }
      },
      "steps": [
        {
          "wait": {
            "log": "Message exceeds max SQS message size",
            "count": 4
          }
        },
        {
          "wait": {
            "metric": {
              "source": "SqsSmall",
              "name": "Writes",
              "op": "ge",
              "value": 5
            }
          }
        }
      ],
      "records": 5,
      "timeoutSeconds": 90,
      "offlineSeconds": 25,
      "assert": [
        {
          "kind": "recordCount",
          "min": 5
        },
        {
          "kind": "keysAbsent",
          "paths": [
            "big"
          ],
          "comment": "no oversize record ever reached the queue"
        },
        {
          "kind": "channelValueRun",
          "source": "sim",
          "channel": "ctr"
        },
        {
          "kind": "logContains",
          "text": "Message exceeds max SQS message size",
          "min": 4
        },
        {
          "kind": "metric",
          "source": "SqsBig",
          "name": "Writes",
          "op": "eq",
          "value": 0,
          "comment": "nothing was sent for SqsBig"
        }
      ],
      "knownDefect": {
        "ref": "targets/aws-sqs-target/src/main/kotlin/com/amazonaws/sfc/awssqs/AwsSqsTargetWriter.kt:201-205",
        "summary": "An SQS record over 1 MiB is dropped with only an error log line; WriteError is not incremented, so the data loss is invisible in metrics",
        "assertCurrent": [
          {
            "kind": "metric",
            "source": "SqsBig",
            "name": "WriteError",
            "op": "eq",
            "value": 0
          }
        ],
        "assertCorrect": [
          {
            "kind": "metric",
            "source": "SqsBig",
            "name": "WriteError",
            "op": "ge",
            "value": 1
          }
        ]
      },
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "AWS-SQS-NEG-01",
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "S",
            "Interval": 200,
            "Sources": {
              "sim": [
                "*"
              ]
            },
            "Targets": [
              "SqsSmall",
              "SqsBig"
            ]
          }
        ],
        "Sources": {
          "sim": {
            "Name": "sim",
            "ProtocolAdapter": "Sim",
            "Channels": {
              "ctr": {
                "Name": "ctr",
                "Simulation": {
                  "SimulationType": "Counter",
                  "DataType": "Int",
                  "Min": 0,
                  "Max": 100000
                }
              }
            }
          }
        },
        "Targets": {
          "SqsSmall": {
            "TargetType": "AWS-SQS",
            "QueueUrl": "${SFC_E2E_SQS_QUEUE_URL}",
            "Region": "${SFC_E2E_REGION}",
            "BatchSize": 1
          },
          "SqsBig": {
            "TargetType": "AWS-SQS",
            "QueueUrl": "${SFC_E2E_SQS_QUEUE_URL}",
            "Region": "${SFC_E2E_REGION}",
            "BatchSize": 1,
            "Template": "${SFC_E2E_CASE_DIR}/big.vm"
          }
        },
        "ProtocolAdapters": {
          "Sim": {
            "AdapterType": "SIMULATOR"
          }
        },
        "Metrics": {
          "Interval": 1,
          "Writer": {}
        },
        "Metadata": {
          "runId": "${SFC_E2E_RUN_ID}",
          "case": "${SFC_E2E_CASE}",
          "mode": "${SFC_E2E_MODE}",
          "marker": "${SFC_E2E_MARKER}"
        }
      },
      "uberjar": {
        "AdapterTypes": {
          "SIMULATOR": {
            "FactoryClassName": "com.amazonaws.sfc.simulator.SimulatorAdapter"
          }
        },
        "TargetTypes": {
          "AWS-SQS": {
            "FactoryClassName": "com.amazonaws.sfc.awssqs.AwsSqsTargetWriter"
          }
        },
        "Metrics": {
          "Writer": {
            "MetricsWriter": {
              "FactoryClassName": "com.amazonaws.sfc.e2e.E2eMetricsWriter"
            }
          }
        }
      },
      "inprocess": {
        "AdapterTypes": {
          "SIMULATOR": {
            "FactoryClassName": "com.amazonaws.sfc.simulator.SimulatorAdapter",
            "JarFiles": [
              "${SFC_DEPLOYMENT_DIR}/simulator/lib"
            ]
          }
        },
        "TargetTypes": {
          "AWS-SQS": {
            "FactoryClassName": "com.amazonaws.sfc.awssqs.AwsSqsTargetWriter",
            "JarFiles": [
              "${SFC_DEPLOYMENT_DIR}/aws-sqs-target/lib"
            ]
          }
        },
        "Metrics": {
          "Writer": {
            "MetricsWriter": {
              "FactoryClassName": "com.amazonaws.sfc.e2e.E2eMetricsWriter",
              "JarFiles": [
                "${SFC_E2E_SUPPORT_JAR}"
              ]
            }
          }
        }
      },
      "ipcServices": {
        "SimServer": {
          "module": "simulator"
        },
        "SqsSmallServer": {
          "module": "aws-sqs-target"
        },
        "SqsBigServer": {
          "module": "aws-sqs-target"
        }
      },
      "ipc": {
        "ProtocolAdapters": {
          "Sim": {
            "AdapterServer": "SimServer"
          }
        },
        "AdapterServers": {
          "SimServer": {
            "Address": "${SFC_E2E_IPC_HOST}",
            "Port": 50000
          }
        },
        "Targets": {
          "SqsSmall": {
            "TargetServer": "SqsSmallServer"
          },
          "SqsBig": {
            "TargetServer": "SqsBigServer"
          }
        },
        "TargetServers": {
          "SqsSmallServer": {
            "Address": "${SFC_E2E_IPC_HOST}",
            "Port": 50001
          },
          "SqsBigServer": {
            "Address": "${SFC_E2E_IPC_HOST}",
            "Port": 50002
          }
        },
        "Metrics": {
          "Writer": {
            "MetricsWriter": {
              "FactoryClassName": "com.amazonaws.sfc.e2e.E2eMetricsWriter",
              "JarFiles": [
                "${SFC_E2E_SUPPORT_JAR}"
              ]
            }
          }
        }
      },
      "files": {
        "big.vm": "{\"metadata\":{\"marker\":\"$metadata.marker\"},\"big\":\"#foreach($i in [1..22000])01234567890123456789012345678901234567890123456789#end\"}\n"
      }
    }
  ]
}
