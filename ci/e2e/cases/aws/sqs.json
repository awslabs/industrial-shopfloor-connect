    {
      "id": "AWS-SQS-02",
      "title": "SQS batching: BatchSize fills 10-entry batches under a steady stream; Interval flushes a partial batch once the stream is idle",
      "tier": "aws",
      "priority": "P1",
      "intent": "Batching is how SFC keeps SQS cost and request rate down, and Interval is what bounds the latency of a partial batch. SqsBatch gets a record every 100 ms with BatchSize 10, so it must flush full ten-entry batches (handleTargetData, AwsSqsTargetWriter.kt:218); SqsIdle gets a record every second with BatchSize 10 and Interval 200, so only the timer (:166-169) can flush it, one record at a time. Both write to the run's own real queue and are told apart by schedule name. The case fails if batching is disabled (Messages/Writes would be 1 for SqsBatch), if the Interval flush does not happen (no Slow record would ever arrive, a batch of 10 takes 10 s), or if records are lost or duplicated. The Interval is an inactivity timer, not a maximum wait; that defect is pinned by LOC-AWSTGT-SQS-INTERVAL-IDLE-01.",
      "pins": [
        "targets/aws-sqs-target/src/main/kotlin/com/amazonaws/sfc/awssqs/AwsSqsTargetWriter.kt:155-171",
        "targets/aws-sqs-target/src/main/kotlin/com/amazonaws/sfc/awssqs/AwsSqsTargetWriter.kt:218",
        "targets/aws-sqs-target/src/main/kotlin/com/amazonaws/sfc/awssqs/config/AwsSqsTargetConfiguration.kt:64-71"
      ],
      "sinks": {
        "main": {
          "kind": "sqs"
        }
      },
      "steps": [
        {
          "wait": {
            "metric": {
              "source": "SqsIdle",
              "name": "Writes",
              "op": "ge",
              "value": 4
            }
          }
        },
        {
          "wait": {
            "metric": {
              "source": "SqsBatch",
              "name": "Writes",
              "op": "ge",
              "value": 3
            }
          }
        }
      ],
      "records": 34,
      "timeoutSeconds": 90,
      "offlineSeconds": 25,
      "assert": [
        {
          "kind": "recordCount",
          "where": {
            "schedule": "Slow"
          },
          "min": 3
        },
        {
          "kind": "recordCount",
          "where": {
            "schedule": "Fast"
          },
          "min": 20
        },
        {
          "kind": "channelValueRun",
          "where": {
            "schedule": "Slow"
          },
          "source": "simSlow",
          "channel": "ctr"
        },
        {
          "kind": "channelValueRun",
          "where": {
            "schedule": "Fast"
          },
          "source": "simFast",
          "channel": "ctr"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "SqsBatch",
            "name": "Messages"
          },
          "denominator": {
            "source": "SqsBatch",
            "name": "Writes"
          },
          "op": "ge",
          "value": 5,
          "comment": "full batches of 10; 1 would mean no batching"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "SqsIdle",
            "name": "Messages"
          },
          "denominator": {
            "source": "SqsIdle",
            "name": "Writes"
          },
          "op": "lt",
          "value": 2,
          "comment": "the 200 ms timer flushes each slow record (the start-up reads can share a write); without it a write would carry 10"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error sending to queue"
          ]
        }
      ],
