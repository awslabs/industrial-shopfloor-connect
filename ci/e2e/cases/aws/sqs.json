    {
      "id": "AWS-SQS-03",
      "title": "SQS GZip: the {compression, payload} envelope is accepted by the real queue and decodes back to the record",
      "tier": "aws",
      "priority": "P1",
      "intent": "Compression changes what SFC puts into the message body: Compress.compressedDataPayload wraps gzip bytes in a base64 JSON envelope. That body has to be accepted by the real SQS service and decode back to the record a consumer expects. The sqs sink unwraps the envelope, so the decoded records prove the round trip (contiguous counter, the constant string intact); the per-record 'Used GZIP compression' log line proves the compression path ran for each message. The exact envelope bytes are asserted on the wire by LOC-AWSTGT-SQS-COMPRESSION-WRAPPER-01, because the sink cannot show whether a message arrived compressed.",
      "pins": [
        "targets/aws-sqs-target/src/main/kotlin/com/amazonaws/sfc/awssqs/AwsSqsTargetWriter.kt:359-377",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/Compress.kt:51-57",
        "ci/e2e/lib/sinks/aws.py:38-56"
      ],
      "sinks": {
        "main": {
          "kind": "sqs"
        }
      },
      "records": 6,
      "timeoutSeconds": 90,
      "offlineSeconds": 25,
      "steps": [
        {
          "wait": {
            "metric": {
              "source": "SqsGzip",
              "name": "Writes",
              "op": "ge",
              "value": 6
            }
          }
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "min": 6
        },
        {
          "kind": "channelValueRun",
          "source": "sim",
          "channel": "ctr"
        },
        {
          "kind": "channelValueSet",
          "source": "sim",
          "channel": "txt",
          "values": [
            "sfc-e2e-gzip-payload-sfc-e2e-gzip-payload-sfc-e2e-gzip-payload"
          ]
        },
        {
          "kind": "logContains",
          "text": "Used GZIP compression to compress",
          "min": 6,
          "comment": "one line per compressed message body"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error sending to queue"
          ]
        }
      ],
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "AWS-SQS-03",
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "S",
            "Interval": 200,
            "Sources": {
              "sim": [
                "*"
              ]
            },
            "Targets": [
              "SqsGzip"
            ]
          }
        ],
        "Sources": {
          "sim": {
            "Name": "sim",
            "ProtocolAdapter": "Sim",
            "Channels": {
              "ctr": {
                "Name": "ctr",
                "Simulation": {
                  "SimulationType": "Counter",
                  "DataType": "Int",
                  "Min": 0,
                  "Max": 100000
                }
              },
              "txt": {
                "Name": "txt",
                "Simulation": {
                  "SimulationType": "Constant",
                  "DataType": "String",
                  "Value": "sfc-e2e-gzip-payload-sfc-e2e-gzip-payload-sfc-e2e-gzip-payload"
