{
  "cases": [
    {
      "id": "AWS-SQS-01",
      "title": "SQS BatchSize 1: every record becomes its own SendMessageBatch call and arrives in the real queue",
      "tier": "aws",
      "priority": "P0",
      "intent": "The basic SQS contract against the real service: with BatchSize 1 each record is flushed on arrival (AwsSqsTargetWriter.kt:218) as a one-entry SendMessageBatch whose body is the record JSON, authorised by sqs:SendMessage on the project role. Each case run writes to a queue of its own, which the sink reads to the end once SFC has stopped, because a standard queue keeps no order. The case fails if a record is lost or duplicated (the counter run must be contiguous), if SFC batches despite BatchSize 1 (Messages/Writes must be exactly 1), or if a write error is counted.",
      "pins": [
        "targets/aws-sqs-target/src/main/kotlin/com/amazonaws/sfc/awssqs/AwsSqsTargetWriter.kt:218",
        "targets/aws-sqs-target/src/main/kotlin/com/amazonaws/sfc/awssqs/AwsSqsTargetWriter.kt:266-270",
        "targets/aws-sqs-target/src/main/kotlin/com/amazonaws/sfc/awssqs/AwsSqsTargetWriter.kt:310-318",
        "ci/cdk/lib/sfc-it-stack.ts:434-436"
      ],
      "sinks": {
        "main": {
          "kind": "sqs"
        }
      },
      "records": 6,
      "timeoutSeconds": 90,
      "offlineSeconds": 25,
      "steps": [
        {
          "wait": {
            "metric": {
              "source": "Sqs",
              "name": "Writes",
              "op": "ge",
              "value": 6
            }
          }
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "min": 6
        },
        {
          "kind": "channelValueRun",
          "source": "sim",
          "channel": "ctr",
          "comment": "SQS standard queues do not keep order: a contiguous set, no duplicates"
        },
        {
          "kind": "everyRecord",
          "path": "schedule",
          "equals": "S"
        },
        {
          "kind": "everyRecord",
          "path": "sources.sim.values.ctr.value",
          "type": "int"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "Sqs",
            "name": "Messages"
          },
          "denominator": {
            "source": "Sqs",
            "name": "Writes"
          },
          "op": "eq",
          "value": 1,
          "comment": "BatchSize 1: one record per SendMessageBatch"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error sending to queue",
            "Message exceeds max SQS message size",
            "NoClassDefFoundError",
            "ClassNotFoundException"
          ]
        }
      ],
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "AWS-SQS-01",
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "S",
            "Interval": 200,
            "Sources": {
              "sim": [
                "*"
              ]
            },
            "Targets": [
              "Sqs"
            ]
          }
        ],
        "Sources": {
          "sim": {
            "Name": "sim",
            "ProtocolAdapter": "Sim",
            "Channels": {
              "ctr": {
                "Name": "ctr",
                "Simulation": {
                  "SimulationType": "Counter",
                  "DataType": "Int",
                  "Min": 0,
                  "Max": 100000
