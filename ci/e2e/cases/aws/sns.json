            ]
          }
        },
        "TargetTypes": {
          "AWS-SNS": {
            "FactoryClassName": "com.amazonaws.sfc.awssns.AwsSnsTargetWriter",
            "JarFiles": [
              "${SFC_DEPLOYMENT_DIR}/aws-sns-target/lib"
            ]
          }
        },
        "Metrics": {
          "Writer": {
            "MetricsWriter": {
              "FactoryClassName": "com.amazonaws.sfc.e2e.E2eMetricsWriter",
              "JarFiles": [
                "${SFC_E2E_SUPPORT_JAR}"
              ]
            }
          }
        }
      },
      "ipcServices": {
        "SimServer": {
          "module": "simulator"
        },
        "SnsSmallServer": {
          "module": "aws-sns-target"
        },
        "SnsBigServer": {
          "module": "aws-sns-target"
        }
      },
      "ipc": {
        "ProtocolAdapters": {
          "Sim": {
            "AdapterServer": "SimServer"
          }
        },
        "AdapterServers": {
          "SimServer": {
            "Address": "${SFC_E2E_IPC_HOST}",
            "Port": 50000
          }
        },
        "Targets": {
          "SnsSmall": {
            "TargetServer": "SnsSmallServer"
          },
          "SnsBig": {
            "TargetServer": "SnsBigServer"
          }
        },
        "TargetServers": {
          "SnsSmallServer": {
            "Address": "${SFC_E2E_IPC_HOST}",
            "Port": 50001
          },
          "SnsBigServer": {
            "Address": "${SFC_E2E_IPC_HOST}",
            "Port": 50002
          }
        },
        "Metrics": {
          "Writer": {
            "MetricsWriter": {
              "FactoryClassName": "com.amazonaws.sfc.e2e.E2eMetricsWriter",
              "JarFiles": [
                "${SFC_E2E_SUPPORT_JAR}"
              ]
            }
          }
        }
      },
      "files": {
        "big.vm": "{\"metadata\":{\"marker\":\"$metadata.marker\"},\"big\":\"#foreach($i in [1..6000])01234567890123456789012345678901234567890123456789#end\"}\n"
      }
