    {
      "id": "AWS-SNS-NEG-01",
      "title": "SNS: a record over 256 KiB is dropped before publishing while normal records keep flowing - and no WriteError is counted (known defect)",
      "tier": "aws",
      "priority": "P1",
      "intent": "SNS rejects messages over 256 KiB, so SFC checks the payload length first (SNS_MAX_BATCH_MSG_SIZE = 262144, AwsSnsTargetWriter.kt:199-201, :408). SnsBig renders a 300 000-character template, above the SNS limit but below the 1 MiB SQS one, so a guard copied with the SQS limit would let it through and SNS would reject the call; it must never reach the topic, while SnsSmall in the same schedule keeps delivering. The guard only logs and reports the record to a result handler, which a direct target does not have; it does not increment WriteError, so a dashboard shows no failure while every SnsBig record is lost - the exception path of the same writer does count it (:294-296), and the IoT Core target counts its oversize payloads (AwsIotCoreTargetWriter.kt:353-356). The case fails if the guard is lost or too lenient (no 'exceeds max SNS message size' line, a publish for SnsBig, a send error, or the oversize record in the sink) or if SnsSmall stops delivering. SnsBig may report WriteError, so that a fix flips only the pin.",
      "pins": [
        "targets/aws-sns-target/src/main/kotlin/com/amazonaws/sfc/awssns/AwsSnsTargetWriter.kt:199-201",
        "targets/aws-sns-target/src/main/kotlin/com/amazonaws/sfc/awssns/AwsSnsTargetWriter.kt:294-296",
        "targets/aws-sns-target/src/main/kotlin/com/amazonaws/sfc/awssns/AwsSnsTargetWriter.kt:408",
        "targets/aws-iot-core-target/src/main/kotlin/com/amazonaws/sfc/awsiotcore/AwsIotCoreTargetWriter.kt:353-356"
      ],
      "sinks": {
        "main": {
          "kind": "sns"
        }
      },
      "records": 5,
      "timeoutSeconds": 90,
      "offlineSeconds": 25,
      "steps": [
        {
          "wait": {
            "log": "exceeds max SNS message size",
            "count": 4
          }
        },
        {
          "wait": {
            "metric": {
              "source": "SnsSmall",
              "name": "Writes",
              "op": "ge",
              "value": 5
            }
          }
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "min": 5
        },
        {
          "kind": "keysAbsent",
          "paths": [
            "big"
          ],
          "comment": "no oversize record ever reached the topic"
        },
        {
          "kind": "channelValueRun",
          "source": "sim",
          "channel": "ctr"
        },
        {
          "kind": "logContains",
          "text": "exceeds max SNS message size",
          "min": 4
        },
        {
          "kind": "metric",
          "source": "SnsBig",
          "name": "Writes",
          "op": "eq",
          "value": 0,
          "comment": "nothing was published for SnsBig"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error sending to topic",
            "Error sending message"
          ],
          "comment": "a 300 000-character message that got past the guard would be rejected by SNS"
        }
      ],
      "knownDefect": {
        "ref": "targets/aws-sns-target/src/main/kotlin/com/amazonaws/sfc/awssns/AwsSnsTargetWriter.kt:199-201",
        "summary": "An SNS record over 256 KiB is dropped with only an error log line; WriteError is not incremented, so the data loss is invisible in metrics",
        "assertCurrent": [
          {
            "kind": "metric",
            "source": "SnsBig",
            "name": "WriteError",
            "op": "eq",
            "value": 0
          }
        ],
        "assertCorrect": [
          {
            "kind": "metric",
            "source": "SnsBig",
            "name": "WriteError",
            "op": "ge",
            "value": 1
          }
        ]
      },
      "allowWriteErrors": [
        "SnsBig"
      ],
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "AWS-SNS-NEG-01",
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "S",
            "Interval": 200,
            "Sources": {
              "sim": [
                "*"
              ]
            },
            "Targets": [
              "SnsSmall",
              "SnsBig"
            ]
          }
        ],
        "Sources": {
          "sim": {
            "Name": "sim",
            "ProtocolAdapter": "Sim",
            "Channels": {
              "ctr": {
                "Name": "ctr",
                "Simulation": {
                  "SimulationType": "Counter",
                  "DataType": "Int",
                  "Min": 0,
                  "Max": 100000
                }
              }
            }
          }
        },
        "Targets": {
