    {
      "id": "AWS-SNS-DEF-01",
      "title": "SNS Interval is an inactivity timer, not a maximum wait: a steady stream faster than Interval waits for BatchSize (known defect)",
      "tier": "aws",
      "priority": "P2",
      "intent": "docs/targets/aws-sns.md:99 promises that buffered data is sent when Interval elapses or BatchSize is reached, whichever occurs first - that is what bounds the latency of a slow trickle. The writer cancels the timer for every record it receives and starts a new one after it (AwsSnsTargetWriter.kt:163-174), so the timer fires only after Interval without any record. SnsSteady gets a record every 200 ms with BatchSize 10 and Interval 500: as documented each PublishBatch would carry the 2-3 records of the last 500 ms; today the timer never fires, every call carries 10 and a record waits up to 2 s. The pin discriminates on Messages/Writes - about 10 today, about 2.5 once fixed; the thresholds 5 and 4 leave room for scheduling stalls that let the timer fire a few times. Both behaviours reach the same wait for 30 published messages. The common assertions fail if records are lost or duplicated on the way through the real topic.",
      "pins": [
        "targets/aws-sns-target/src/main/kotlin/com/amazonaws/sfc/awssns/AwsSnsTargetWriter.kt:158-174",
        "targets/aws-sns-target/src/main/kotlin/com/amazonaws/sfc/awssns/AwsSnsTargetWriter.kt:225-234",
        "targets/aws-sns-target/src/main/kotlin/com/amazonaws/sfc/awssns/config/AwsSnsTargetConfiguration.kt:82-89",
        "docs/targets/aws-sns.md:98-103"
      ],
      "sinks": {
        "main": {
          "kind": "sns"
        }
      },
      "records": 30,
      "timeoutSeconds": 90,
      "offlineSeconds": 25,
      "steps": [
        {
          "wait": {
            "metric": {
              "source": "SnsSteady",
              "name": "Messages",
              "op": "ge",
              "value": 30
            }
          }
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "min": 30
        },
        {
          "kind": "channelValueRun",
          "source": "sim",
          "channel": "ctr"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error sending to topic",
            "Error sending message"
          ]
        }
      ],
      "knownDefect": {
        "ref": "targets/aws-sns-target/src/main/kotlin/com/amazonaws/sfc/awssns/AwsSnsTargetWriter.kt:163-174",
        "summary": "Interval restarts with every received record, so it is an inactivity timer: under a stream faster than Interval a partial batch is flushed only when BatchSize is reached, not after Interval as documented (docs/targets/aws-sns.md:99)",
        "assertCurrent": [
          {
            "kind": "metricRatio",
            "numerator": {
              "source": "SnsSteady",
              "name": "Messages"
            },
            "denominator": {
              "source": "SnsSteady",
              "name": "Writes"
            },
            "op": "ge",
            "value": 5,
            "comment": "every PublishBatch waits for 10 records"
          }
        ],
        "assertCorrect": [
          {
            "kind": "metricRatio",
            "numerator": {
              "source": "SnsSteady",
              "name": "Messages"
            },
            "denominator": {
              "source": "SnsSteady",
              "name": "Writes"
            },
            "op": "le",
            "value": 4,
            "comment": "flushed at least every 500 ms: 2-3 records per PublishBatch"
          }
        ]
      },
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "AWS-SNS-DEF-01",
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "Steady",
