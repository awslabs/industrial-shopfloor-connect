{
  "cases": [
    {
      "id": "AWS-SNS-01",
      "title": "SNS BatchSize 1: every record is its own PublishBatch call to the real topic and arrives unchanged through the raw-delivery subscription",
      "tier": "aws",
      "priority": "P0",
      "intent": "The basic SNS contract against the real service: with BatchSize 1 each record is flushed on arrival (AwsSnsTargetWriter.kt:214-216) as a one-entry PublishBatch whose message is the record JSON, authorised by sns:Publish on the project role (topic.grantPublish). The stack's sink queue is subscribed to the topic with raw message delivery, so each SQS body is exactly what SFC published; the queue is shared by every concurrent SNS case run, so the sink keeps only this run's marker and, as a standard queue keeps no order, reads on after the stop until nothing new has arrived for 8 s. The case fails if a record is lost or duplicated (the counter set must be contiguous), if anything wraps or alters the record (the top-level keys must be exactly SFC's envelope, in order - a notification envelope would not even carry the marker), if SFC batches despite BatchSize 1 (Messages/Writes must be exactly 1), or if a write error is counted or logged.",
      "pins": [
        "targets/aws-sns-target/src/main/kotlin/com/amazonaws/sfc/awssns/AwsSnsTargetWriter.kt:214-216",
        "targets/aws-sns-target/src/main/kotlin/com/amazonaws/sfc/awssns/AwsSnsTargetWriter.kt:259-266",
        "targets/aws-sns-target/src/main/kotlin/com/amazonaws/sfc/awssns/AwsSnsTargetWriter.kt:302-319",
        "targets/aws-sns-target/src/main/kotlin/com/amazonaws/sfc/awssns/AwsSnsTargetWriter.kt:332-352",
        "ci/cdk/lib/sfc-it-stack.ts:171-176",
        "ci/cdk/lib/sfc-it-stack.ts:420-423",
        "ci/e2e/lib/sinks/aws.py:173-174"
      ],
      "sinks": {
        "main": {
          "kind": "sns"
        }
      },
      "records": 6,
      "timeoutSeconds": 90,
      "offlineSeconds": 25,
      "steps": [
        {
          "wait": {
            "metric": {
              "source": "Sns",
              "name": "Writes",
              "op": "ge",
              "value": 6
            }
          }
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "min": 6
        },
        {
          "kind": "channelValueRun",
          "source": "sim",
          "channel": "ctr",
          "comment": "SNS -> SQS keeps no order: a contiguous set, no duplicates"
        },
        {
          "kind": "keyOrder",
          "keys": [
            "schedule",
            "serial",
            "timestamp",
            "sources",
            "metadata"
          ],
          "comment": "raw delivery: the body is SFC's record itself, nothing added or wrapped"
        },
        {
          "kind": "everyRecord",
          "path": "schedule",
          "equals": "S"
        },
        {
          "kind": "everyRecord",
          "path": "sources.sim.values.ctr.value",
          "type": "int"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "Sns",
            "name": "Messages"
          },
          "denominator": {
            "source": "Sns",
            "name": "Writes"
          },
          "op": "eq",
          "value": 1,
          "comment": "BatchSize 1: one record per PublishBatch"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error sending to topic",
            "Error sending message",
            "exceeds max SNS message size",
            "NoClassDefFoundError",
            "ClassNotFoundException"
          ]
        }
      ],
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "AWS-SNS-01",
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "S",
            "Interval": 200,
            "Sources": {
              "sim": [
                "*"
              ]
            },
            "Targets": [
              "Sns"
            ]
          }
        ],
