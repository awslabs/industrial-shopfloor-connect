    {
      "id": "AWS-SNS-03",
      "title": "SNS GZip and Zip: the {compression, payload} envelope is accepted by the real topic, delivered raw and decodes back to the record",
      "tier": "aws",
      "priority": "P1",
      "intent": "Compression changes what SFC publishes: Compress.compressedDataPayload wraps the gzip or zip bytes in a base64 JSON envelope {compression: GZIP|ZIP, payload} (AwsSnsTargetWriter.kt:338-347, Compress.kt:51-57). That message has to be accepted by SNS, passed on unchanged by the raw-delivery subscription and decode back to the record a consumer expects. SnsGzip and SnsZip publish separate counter streams, told apart by schedule; the sns sink unwraps either envelope (sinks/aws.py:42-60), so a contiguous counter and the intact constant string per stream prove the round trip, and one 'Used GZIP/ZIP compression to compress' line per message proves the compression path ran for each. The case fails if compression is skipped (no log lines), if an envelope does not decode (its records never match the marker, so the gate times out), or if a record is lost, duplicated or altered. The sink cannot show that a message arrived compressed; the exact envelope is asserted on the wire for SQS by LOC-AWSTGT-SQS-COMPRESSION-WRAPPER-01, and SNS builds it with the same helper.",
      "pins": [
        "targets/aws-sns-target/src/main/kotlin/com/amazonaws/sfc/awssns/AwsSnsTargetWriter.kt:338-347",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/Compress.kt:51-57",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/ZipCompression.kt:38-47",
        "ci/e2e/lib/sinks/aws.py:42-60"
      ],
      "sinks": {
        "main": {
          "kind": "sns"
        }
      },
      "records": 10,
      "timeoutSeconds": 90,
      "offlineSeconds": 25,
      "steps": [
        {
          "wait": {
            "metric": {
              "source": "SnsGzip",
              "name": "Writes",
              "op": "ge",
              "value": 5
            }
          }
        },
        {
          "wait": {
            "metric": {
              "source": "SnsZip",
              "name": "Writes",
              "op": "ge",
              "value": 5
            }
          }
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "where": {
            "schedule": "Gz"
          },
          "min": 5
        },
        {
          "kind": "recordCount",
          "where": {
            "schedule": "Zp"
          },
          "min": 5
        },
        {
          "kind": "channelValueRun",
          "where": {
            "schedule": "Gz"
          },
          "source": "simGz",
          "channel": "ctr"
        },
        {
          "kind": "channelValueRun",
          "where": {
            "schedule": "Zp"
          },
          "source": "simZp",
          "channel": "ctr"
        },
        {
          "kind": "channelValueSet",
          "where": {
            "schedule": "Gz"
          },
          "source": "simGz",
          "channel": "txt",
          "values": [
            "sfc-e2e-sns-compressed-payload-sfc-e2e-sns-compressed-payload-sfc-e2e-sns-compressed-payload"
          ]
        },
        {
          "kind": "channelValueSet",
          "where": {
            "schedule": "Zp"
          },
          "source": "simZp",
          "channel": "txt",
          "values": [
            "sfc-e2e-sns-compressed-payload-sfc-e2e-sns-compressed-payload-sfc-e2e-sns-compressed-payload"
          ]
        },
        {
          "kind": "logContains",
          "text": "Used GZIP compression to compress",
          "min": 5,
          "comment": "one line per compressed message (the enum name, not the configured spelling)"
        },
        {
          "kind": "logContains",
          "text": "Used ZIP compression to compress",
          "min": 5
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error sending to topic",
            "Error sending message"
          ]
        }
      ],
