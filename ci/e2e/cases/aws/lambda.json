    {
      "id": "AWS-LAM-03",
      "title": "Lambda GZip and Zip: each batch goes out as the {compression, payload} envelope at under a third of its JSON size, and the real service accepts every event",
      "tier": "aws",
      "priority": "P1",
      "intent": "With Compression the target sends Compress.compressedDataPayload's {compression: GZIP|ZIP, payload: <base64>} envelope in place of the records (AwsLambdaTargetWriter.kt:264-270, Compress.kt:51-57), because the Invoke payload has to be JSON (docs/targets/aws-lambda.md:56). LamGzip and LamZip each put five records into one Invoke; LamPlain sends records of the same shape uncompressed and is the in-run control. The evidence function looks for $.metadata.marker in the event (evidence.py:24-30), which the envelope does not carry, so compressed events land under lambda-evidence/unknown/ and cannot be read back; decoding the envelope is proven for SQS by AWS-SQS-03 (the same Compress code), and here SFC's own counters carry the proof. WriteSuccess is counted only after Invoke returned (AwsLambdaTargetWriter.kt:200-206), so it shows the real service accepted every compressed event. BytesWritten is the length of the payload actually sent (:205), so under 250 bytes per record - about 110 (GZip) and 150 (Zip) for five records, against about 480 for LamPlain's uncompressed records in the same run - shows the events really were compressed. Messages/Writes 5 shows the whole batch went into one envelope, and one 'Used ... compression' line per write shows each codec ran. The case fails if a codec fails or is skipped, if the service rejects an envelope (WriteError), or if a batch is split. The compressed events are also decoded back: every record of the GZip and Zip streams must arrive, as a contiguous counter.",
      "pins": [
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/AwsLambdaTargetWriter.kt:264-270",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/Compress.kt:51-57",
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/AwsLambdaTargetWriter.kt:194-206",
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/AwsLambdaTargetWriter.kt:238-246",
        "docs/targets/aws-lambda.md:53-70",
        "ci/cdk/lambda/evidence.py:24-30"
      ],
      "sinks": {
        "main": {
          "kind": "lambda"
        }
      },
      "records": 15,
      "timeoutSeconds": 90,
      "offlineSeconds": 25,
      "steps": [
        {
          "wait": {
            "metric": {
              "source": "LamGzip",
              "name": "Writes",
              "op": "ge",
              "value": 3
            }
          }
        },
        {
          "wait": {
            "metric": {
              "source": "LamZip",
              "name": "Writes",
              "op": "ge",
              "value": 3
            }
          }
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "where": {
            "schedule": "Plain"
          },
          "min": 15,
          "comment": "LamPlain's events: the function and the invoke permission work in this run"
        },
        {
          "kind": "channelValueRun",
          "where": {
            "schedule": "Plain"
          },
          "source": "simPlain",
          "channel": "ctr"
        },
        {
          "kind": "recordCount",
          "where": {
            "schedule": "Gzip"
          },
          "min": 15,
          "comment": "the GZip envelopes the function received decode back to records (evidence.py opens the envelope to file them under the run marker)"
        },
        {
          "kind": "channelValueRun",
          "where": {
            "schedule": "Gzip"
          },
          "source": "simGzip",
          "channel": "ctr"
        },
        {
          "kind": "recordCount",
          "where": {
            "schedule": "Zip"
          },
          "min": 15,
          "comment": "the Zip envelopes the function received decode back to records (evidence.py opens the envelope to file them under the run marker)"
        },
        {
          "kind": "channelValueRun",
          "where": {
            "schedule": "Zip"
          },
          "source": "simZip",
          "channel": "ctr"
        },
        {
          "kind": "metric",
          "source": "LamGzip",
          "name": "WriteSuccess",
          "op": "ge",
          "value": 3,
          "comment": "the service accepted each GZip envelope"
        },
        {
          "kind": "metric",
          "source": "LamZip",
          "name": "WriteSuccess",
          "op": "ge",
          "value": 3,
          "comment": "the service accepted each Zip envelope"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "LamGzip",
            "name": "Messages"
          },
          "denominator": {
            "source": "LamGzip",
            "name": "Writes"
          },
          "op": "eq",
          "value": 5
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "LamZip",
            "name": "Messages"
          },
          "denominator": {
            "source": "LamZip",
            "name": "Writes"
          },
          "op": "eq",
          "value": 5
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "LamGzip",
            "name": "BytesWritten"
          },
          "denominator": {
            "source": "LamGzip",
            "name": "Messages"
          },
          "op": "lt",
          "value": 250,
          "comment": "bytes sent per record, compressed"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "LamZip",
            "name": "BytesWritten"
          },
          "denominator": {
            "source": "LamZip",
            "name": "Messages"
          },
          "op": "lt",
          "value": 250,
          "comment": "bytes sent per record, compressed"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "LamPlain",
            "name": "BytesWritten"
          },
          "denominator": {
            "source": "LamPlain",
            "name": "Messages"
          },
          "op": "ge",
          "value": 250,
          "comment": "the control: an uncompressed record is above the threshold, so the two checks above can fail"
        },
        {
          "kind": "logContains",
          "text": "Used GZIP compression to compress",
          "min": 3
        },
        {
          "kind": "logContains",
          "text": "Used ZIP compression to compress",
          "min": 3
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error invoking function",
            "payload exceeds max Lambda payload size"
          ]
        }
      ],
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "AWS-LAM-03",
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "Plain",
            "Interval": 200,
            "Sources": {
              "simPlain": [
                "*"
              ]
            },
            "Targets": [
              "LamPlain"
            ]
          },
