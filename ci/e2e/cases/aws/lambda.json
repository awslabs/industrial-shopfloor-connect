{
  "cases": [
    {
      "id": "AWS-LAM-01",
      "title": "Lambda BatchSize 1: every record is its own asynchronous Invoke of the real function and is read back from the evidence the function writes",
      "tier": "aws",
      "priority": "P0",
      "intent": "The basic Lambda contract against the real service. With BatchSize 1 each record is flushed on arrival (AwsLambdaTargetWriter.kt:167-169) as the bare record JSON (:253-254) in an Invoke with InvocationType Event (:275-283) of the stack's evidence function, authorised by lambda:InvokeFunction on the project role. An Event invoke returns before the function runs, so the observable is its side effect: the function files each event under lambda-evidence/<marker>/ by $.metadata.marker (evidence.py:24-38), and the sink reads those objects until none has arrived for 8 s after SFC stopped. The case fails if a record is lost or duplicated (the counter values must form a contiguous run after the drain), if SFC batches despite BatchSize 1 (Messages/Writes must be exactly 1), if any invoke fails (WriteError, or the writer's 'Error invoking function' line), or if no event reaches the function at all (the gate).",
      "pins": [
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/AwsLambdaTargetWriter.kt:167-169",
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/AwsLambdaTargetWriter.kt:253-254",
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/AwsLambdaTargetWriter.kt:275-283",
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/AwsLambdaTargetWriter.kt:238-246",
        "ci/cdk/lambda/evidence.py:24-38",
        "ci/e2e/lib/sinks/aws.py:342-366",
        "ci/cdk/lib/sfc-it-stack.ts:418-424"
      ],
      "sinks": {
        "main": {
          "kind": "lambda"
        }
      },
      "records": 6,
      "timeoutSeconds": 90,
      "offlineSeconds": 25,
      "steps": [
        {
          "wait": {
            "metric": {
              "source": "Lam",
              "name": "Writes",
              "op": "ge",
              "value": 6
            }
          }
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "min": 6
        },
        {
          "kind": "channelValueRun",
          "source": "sim",
          "channel": "ctr",
          "comment": "asynchronous invocation keeps no order: after the drain, a contiguous set with no duplicates"
        },
        {
          "kind": "everyRecord",
          "path": "schedule",
          "equals": "S"
        },
        {
          "kind": "everyRecord",
          "path": "sources.sim.values.ctr.value",
          "type": "int"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "Lam",
            "name": "Messages"
          },
          "denominator": {
            "source": "Lam",
            "name": "Writes"
          },
          "op": "eq",
          "value": 1,
          "comment": "BatchSize 1: one record per Invoke"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error invoking function",
            "payload exceeds max Lambda payload size",
            "NoClassDefFoundError",
            "ClassNotFoundException"
          ]
        }
      ],
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "AWS-LAM-01",
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "S",
            "Interval": 200,
            "Sources": {
              "sim": [
                "*"
              ]
            },
            "Targets": [
              "Lam"
            ]
          }
        ],
        "Sources": {
          "sim": {
