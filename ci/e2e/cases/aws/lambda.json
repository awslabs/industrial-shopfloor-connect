            },
            "Targets": [
              "LamZip"
            ]
          }
        ],
        "Sources": {
          "simPlain": {
            "Name": "simPlain",
            "ProtocolAdapter": "Sim",
            "Channels": {
              "ctr": {
                "Name": "ctr",
                "Simulation": {
                  "SimulationType": "Counter",
                  "DataType": "Int",
                  "Min": 0,
                  "Max": 100000
                }
              }
            }
          },
          "simGzip": {
            "Name": "simGzip",
            "ProtocolAdapter": "Sim",
            "Channels": {
              "ctr": {
