    {
      "id": "AWS-LAM-DEF-01",
      "title": "An invalid Lambda FunctionName passes validation: SFC starts, and every record becomes a rejected Invoke reported only as a WriteError and an error line (known defect)",
      "tier": "aws",
      "priority": "P1",
      "intent": "docs/targets/aws-lambda.md:105-125 documents the FunctionName rules and validateLambdaFunctionName (AwsLambdaTargetConfiguration.kt:174-200) implements them, but validateLambda (:104-109) only constructs the ConfigurationException and never throws it, unlike the ConfigurationException.check calls (ConfigurationException.kt:38-46) that reject a bad Region or Interval. So a name that can never exist is not reported at startup, as CORE-AWSTGT-VAL-NAMES-REQUIRED-01 shows for every other AWS target: the writer starts (AwsLambdaTargetWriter.kt:123) and every record becomes an Invoke that AWS rejects, reported only as one WriteError and one 'Error invoking function' line per record (:207-225). LamBad's name contains spaces, which no Lambda function name or ARN may contain, so AWS rejects it whether it answers ValidationException or AccessDeniedException, and no IAM permission could make it valid; the file target in the same schedule shows the rest of the pipeline keeps running. The first wait accepts either the defect's signature or the validation message, so one timeline serves assertCurrent and assertCorrect. A fix must keep accepting what AWS accepts: ARNs and qualified names fail the check as written (':' and the 64-character limit), which is why AWS-LAM-02 invokes by partial ARN.",
      "pins": [
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/config/AwsLambdaTargetConfiguration.kt:104-109",
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/config/AwsLambdaTargetConfiguration.kt:174-200",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ConfigurationException.kt:38-46",
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/AwsLambdaTargetWriter.kt:123",
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/AwsLambdaTargetWriter.kt:207-225",
        "docs/targets/aws-lambda.md:105-125"
      ],
      "records": 5,
      "timeoutSeconds": 90,
      "offlineSeconds": 25,
      "failFast": [],
      "allowWriteErrors": [
        "LamBad"
      ],
      "steps": [
        {
          "wait": {
            "any": [
              {
                "metric": {
                  "source": "LamBad",
                  "name": "WriteError",
                  "op": "ge",
                  "value": 3
                }
              },
              {
                "log": "FunctionName can only contain letters, numbers, hyphens (-), and underscores (_)"
              }
            ]
          }
        },
        {
          "wait": {
            "metric": {
              "source": "FileTarget",
              "name": "Writes",
              "op": "ge",
              "value": 5
            }
          }
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "min": 5
        },
        {
          "kind": "channelSequence",
          "source": "sim",
          "channel": "ctr",
          "step": 1,
          "comment": "the file target keeps delivering beside the broken Lambda target"
        },
        {
          "kind": "metric",
          "source": "LamBad",
          "name": "WriteSuccess",
          "op": "eq",
          "value": 0,
          "comment": "no Invoke with this name ever succeeds, today or once it is rejected at startup"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "NoClassDefFoundError",
            "ClassNotFoundException",
            "NoSuchMethodError"
          ]
        }
      ],
      "knownDefect": {
        "ref": "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/config/AwsLambdaTargetConfiguration.kt:107",
        "summary": "validateLambda() builds the ConfigurationException for an invalid FunctionName but never throws it: SFC starts with a name that can never exist and reports it only as one WriteError and one 'Error invoking function' line per record",
        "assertCurrent": [
          {
            "kind": "logContains",
            "text": "AWS Lambda writer for target \"LamBad\" calling lambda function \"sfc e2e invalid name\"",
            "comment": "the writer started with the invalid name"
          },
          {
            "kind": "metric",
            "source": "LamBad",
            "name": "WriteError",
            "op": "ge",
            "value": 3,
            "comment": "each record is one Invoke that AWS rejects"
          },
          {
            "kind": "logContains",
            "text": "Error invoking function \"sfc e2e invalid name\" for target \"LamBad\"",
            "min": 3
          },
          {
            "kind": "logAbsent",
            "texts": [
              "FunctionName can only contain letters, numbers, hyphens (-), and underscores (_)"
            ],
            "comment": "the check's message is built and discarded"
          }
        ],
        "assertCorrect": [
          {
            "kind": "logContains",
            "text": "FunctionName can only contain letters, numbers, hyphens (-), and underscores (_)",
            "comment": "rejected at startup with the documented rule"
          },
          {
            "kind": "logAbsent",
            "texts": [
              "AWS Lambda writer for target \"LamBad\"",
              "Error invoking function"
            ]
          },
          {
            "kind": "metric",
            "source": "LamBad",
            "name": "WriteError",
            "op": "eq",
            "value": 0
          }
        ]
      },
