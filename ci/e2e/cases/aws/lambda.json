    {
      "id": "AWS-LAM-02",
      "title": "Lambda batching: BatchSize 10 without Interval sends exactly ten records per event; Interval 200 flushes an idle stream's partial batch, invoking by partial ARN",
      "tier": "aws",
      "priority": "P1",
      "intent": "Batching is how SFC keeps the number of invocations down, and Interval is what bounds the latency of a partial batch. LamBatch gets a record every 100 ms with BatchSize 10 and no Interval - the documented default, under which the flush timer waits Duration.INFINITE (AwsLambdaTargetConfiguration.kt:79-86) and only the count flushes (AwsLambdaTargetWriter.kt:167-169) - so every Invoke carries exactly ten records as one JSON array (:255-258), whose first element gives the evidence function the marker. LamIdle gets a record every second with BatchSize 10 and Interval 200, so only the inactivity timer (:125-139, :172-181) can flush it, one record at a time. LamIdle addresses the function by partial ARN, <account>:function:<name>: the schema says 'Name or ARN' (docs/targets/aws-lambda.md:217), and the name check that never fires (AWS-LAM-DEF-01) would reject the ':', so a fix that enforces that check as written fails this case. Both targets invoke the evidence function and are told apart by schedule. The case fails if batching is lost or a batch is split (LamBatch Messages/Writes must be exactly 10), if the Interval flush does not happen (LamIdle's writes would carry ten records each), if the ARN form is not accepted (WriteError, no Slow record), or if records are lost or duplicated.",
      "pins": [
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/AwsLambdaTargetWriter.kt:125-139",
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/AwsLambdaTargetWriter.kt:158-169",
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/AwsLambdaTargetWriter.kt:172-181",
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/AwsLambdaTargetWriter.kt:250-262",
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/config/AwsLambdaTargetConfiguration.kt:64-71",
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/config/AwsLambdaTargetConfiguration.kt:79-86",
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/config/AwsLambdaTargetConfiguration.kt:174-200",
        "docs/targets/aws-lambda.md:215-218",
        "ci/cdk/lambda/evidence.py:24-30"
      ],
      "sinks": {
        "main": {
          "kind": "lambda"
        }
      },
      "steps": [
        {
          "wait": {
            "metric": {
              "source": "LamIdle",
              "name": "Writes",
              "op": "ge",
              "value": 4
            }
          }
        },
        {
          "wait": {
            "metric": {
              "source": "LamBatch",
              "name": "Writes",
              "op": "ge",
              "value": 3
            }
          }
        }
      ],
      "records": 34,
      "timeoutSeconds": 90,
      "offlineSeconds": 25,
      "assert": [
        {
          "kind": "recordCount",
          "where": {
            "schedule": "Slow"
          },
          "min": 4,
          "comment": "every LamIdle write counted before the stop carries at least one record, and the drain reads them all"
        },
        {
          "kind": "recordCount",
          "where": {
            "schedule": "Fast"
          },
          "min": 30,
          "comment": "three or more LamBatch writes of exactly ten records"
        },
        {
          "kind": "channelValueRun",
          "where": {
            "schedule": "Slow"
          },
          "source": "simSlow",
          "channel": "ctr"
        },
        {
          "kind": "channelValueRun",
          "where": {
            "schedule": "Fast"
          },
          "source": "simFast",
          "channel": "ctr"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "LamBatch",
            "name": "Messages"
          },
          "denominator": {
            "source": "LamBatch",
            "name": "Writes"
          },
          "op": "eq",
          "value": 10,
          "comment": "no Interval: only a full batch is sent (the size flush needs ~256 KiB); 1 would mean no batching"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "LamIdle",
            "name": "Messages"
          },
          "denominator": {
            "source": "LamIdle",
            "name": "Writes"
          },
          "op": "lt",
          "value": 2,
          "comment": "the 200 ms timer flushes each slow record (the start-up reads can share a write); without it a write would carry 10"
        },
        {
          "kind": "logRegex",
          "regex": "AWS Lambda writer for target \"LamIdle\" calling lambda function \"\\d{12}:function:[A-Za-z0-9_-]+\"",
          "comment": "the partial ARN is used as configured"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error invoking function",
            "payload exceeds max Lambda payload size"
          ]
        }
      ],
