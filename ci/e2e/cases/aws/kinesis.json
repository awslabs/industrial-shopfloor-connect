    {
      "id": "AWS-KIN-DEF-01",
      "title": "Kinesis Interval is an inactivity timer: under a steady stream nothing is sent until BatchSize is reached, not after Interval as documented (known defect)",
      "tier": "aws",
      "priority": "P2",
      "intent": "aws-kinesis.md:75 promises that the buffer is sent when BatchSize is reached or when Interval has elapsed, whichever comes first, so that records do not sit in the buffer waiting for the batch to fill. The writer instead cancels the timer on every received record and starts a new one after each select (AwsKinesisTargetWriter.kt:161-171), so it fires only after Interval without any record. KinClock (BatchSize 1) and KinSteady (BatchSize 500, Interval 1500, a template that marks its records via=steady) receive the same record every 200 ms. By the time KinClock has written 40 records (8 s), the documented behaviour has sent KinSteady's buffer about five times; today KinSteady has sent nothing, and would only at 500 records, 100 s in. KinClock's records prove the stream and the schedule ran the whole time. The pin tolerates one flush, from a stall of 1.5 s between two records; with the defect fixed KinSteady writes at least three times and its records arrive.",
      "pins": [
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:152-177",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:217-226",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/config/AwsKinesisTargetConfiguration.kt:64-71",
        "docs/targets/aws-kinesis.md:74-79"
      ],
      "sinks": {
        "main": {
          "kind": "kinesis"
        }
      },
      "records": 40,
      "timeoutSeconds": 120,
      "offlineSeconds": 25,
      "steps": [
        {
          "wait": {
            "metric": {
              "source": "KinClock",
              "name": "Writes",
              "op": "ge",
              "value": 40
            }
          }
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "where": {
            "schedule": "S"
          },
          "min": 30
        },
        {
          "kind": "channelSequence",
          "where": {
            "schedule": "S"
          },
          "source": "sim",
          "channel": "ctr",
          "step": 1,
          "comment": "KinClock's records: the schedule delivered every 200 ms throughout"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "KinClock",
            "name": "Messages"
          },
          "denominator": {
            "source": "KinClock",
            "name": "Writes"
          },
          "op": "eq",
          "value": 1
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error sending to kinesis",
            ", error code : ",
            "Error transforming data with template",
            "Error creating velocity template"
          ]
        }
      ],
      "knownDefect": {
        "ref": "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:161-171",
        "summary": "Interval restarts with every received record, so it bounds idle time, not the time a record waits: with records arriving more often than Interval nothing is sent until BatchSize records have accumulated (docs/targets/aws-kinesis.md:75 says whichever comes first)",
        "assertCurrent": [
          {
            "kind": "metric",
            "source": "KinSteady",
            "name": "Writes",
            "op": "le",
            "value": 1,
            "comment": "no flush while records keep arriving within Interval; 1 tolerates one 1.5 s stall"
          }
        ],
        "assertCorrect": [
          {
            "kind": "metric",
            "source": "KinSteady",
            "name": "Writes",
            "op": "ge",
            "value": 3
          },
          {
            "kind": "recordCount",
            "where": {
              "via": "steady"
            },
            "min": 5
          }
        ]
      },
      "config": {
        "AWSVersion": "2022-04-02",
