    {
      "id": "AWS-KIN-03",
      "title": "Kinesis GZip and Zip: a 1.1 MB record, over the 1 MiB Kinesis record limit uncompressed, is accepted compressed and decodes back intact",
      "tier": "aws",
      "priority": "P1",
      "intent": "Kinesis compresses each entry's data on its own and sends the raw GZip or Zip bytes, with no {compression, payload} envelope as for SQS (AwsKinesisTargetWriter.kt:344-350, Compress.kt:45-49; one UUID-named zip entry, :348). A template renders every record to about 1.1 MB, more than the 1 MiB a record in the stack's stream may hold (no larger limit is set, sfc-it-stack.ts:192-198), so the real service accepts it only because SFC compressed it; BytesWritten counts the uncompressed payload (:323, TargetDataBuffer.kt:29) and proves each write carried such a record. The sink picks gzip or zip by magic number, both checked by CRC, and the whole JSON document must parse with every key present and the same padding in every record, the counter in order per target. The case fails if a target sends the record uncompressed (PutRecords rejects it and nothing arrives), if the compressed bytes do not decode, or if records are lost, duplicated or reordered. The padding is compared by distinct count, so a failure does not copy 1.1 MB strings into the report.",
      "pins": [
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:193-194",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:198-200",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:309-326",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:344-350",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/Compress.kt:45-57",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/CompressionTypes.kt:10-27",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/config/AwsKinesisTargetConfiguration.kt:74-78",
        "docs/targets/aws-kinesis.md:60-71",
        "ci/e2e/lib/sinks/aws.py:42-60"
      ],
      "sinks": {
        "main": {
          "kind": "kinesis"
        }
      },
      "records": 6,
      "timeoutSeconds": 120,
      "offlineSeconds": 25,
      "steps": [
        {
          "wait": {
            "metric": {
              "source": "KinGzip",
              "name": "Writes",
              "op": "ge",
              "value": 3
            }
          }
        },
        {
          "wait": {
            "metric": {
              "source": "KinZip",
              "name": "Writes",
              "op": "ge",
              "value": 3
            }
          }
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "where": {
            "via": "gzip"
          },
          "min": 3
        },
        {
          "kind": "recordCount",
          "where": {
            "via": "zip"
          },
          "min": 3
        },
        {
          "kind": "channelSequence",
          "where": {
            "via": "gzip"
          },
          "source": "sim",
          "channel": "ctr",
          "step": 1
        },
        {
          "kind": "channelSequence",
          "where": {
            "via": "zip"
          },
          "source": "sim",
          "channel": "ctr",
          "step": 1
        },
        {
          "kind": "keySet",
          "keys": [
            "metadata",
            "via",
            "sources",
            "pad"
          ]
        },
        {
          "kind": "distinct",
          "path": "pad",
          "equals": 1,
          "comment": "the same 22000 x 50 character padding in every decoded record"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "KinGzip",
            "name": "BytesWritten"
          },
          "denominator": {
            "source": "KinGzip",
            "name": "Writes"
          },
          "op": "ge",
          "value": 1048576,
          "comment": "every write carried an uncompressed payload above the 1 MiB record limit"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "KinZip",
            "name": "BytesWritten"
          },
          "denominator": {
            "source": "KinZip",
            "name": "Writes"
          },
          "op": "ge",
          "value": 1048576,
          "comment": "every write carried an uncompressed payload above the 1 MiB record limit"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "KinGzip",
            "name": "Messages"
          },
          "denominator": {
            "source": "KinGzip",
            "name": "Writes"
          },
          "op": "eq",
          "value": 1
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "KinZip",
            "name": "Messages"
          },
          "denominator": {
            "source": "KinZip",
            "name": "Writes"
          },
          "op": "eq",
          "value": 1
        },
        {
          "kind": "logAbsent",
          "texts": [
