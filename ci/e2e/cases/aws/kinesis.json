    {
      "id": "AWS-KIN-DEF-02",
      "title": "Kinesis: a record whose template renders empty fails its whole PutRecords batch - the valid records batched with it are lost (known defect)",
      "tier": "aws",
      "priority": "P1",
      "intent": "A template may render nothing for a record, to send only some of them. TargetDataBuffer.add keeps no payload for an empty string but still counts the record (TargetDataBuffer.kt:26-36), and buildRecords then reads buffer.payloads[i] for every buffered item (AwsKinesisTargetWriter.kt:340-345): the IndexOutOfBoundsException is caught by flush, counted as one WriteError and the whole batch is dropped (:295-304). Both targets use a template that renders only even counter values. KinOne (BatchSize 1) delivers every even record and pays a WriteError with a stack trace for each odd one; KinFour (BatchSize 4) has two odd records in every batch, so none of its even records ever arrives. KinOne's records prove the template renders correctly (consecutive even values in order, no template error), so the loss is the writer's. The timeline waits for KinFour's second write or its second WriteError, whichever comes first, so it serves the pin and the fix.",
      "pins": [
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/TargetDataBuffer.kt:26-36",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:228-234",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:295-304",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:340-345",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/OutputTransformation.kt:45",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/OutputTransformation.kt:103"
      ],
      "sinks": {
        "main": {
          "kind": "kinesis"
        }
      },
      "steps": [
        {
          "wait": {
            "metric": {
              "source": "KinOne",
              "name": "Writes",
              "op": "ge",
              "value": 5
            }
          }
        },
        {
          "wait": {
            "any": [
              {
                "metric": {
                  "source": "KinFour",
                  "name": "Writes",
                  "op": "ge",
                  "value": 2
                }
              },
              {
                "metric": {
                  "source": "KinFour",
                  "name": "WriteError",
                  "op": "ge",
                  "value": 2
                }
              }
            ]
          }
        }
      ],
      "records": 5,
      "timeoutSeconds": 120,
      "offlineSeconds": 25,
      "allowWriteErrors": [
        "KinOne",
        "KinFour"
      ],
      "assert": [
        {
          "kind": "recordCount",
          "where": {
            "via": "one"
          },
          "min": 5
        },
        {
          "kind": "channelSequence",
          "where": {
            "via": "one"
          },
          "source": "sim",
          "channel": "ctr",
          "step": 2,
          "comment": "every even value, in order, and no odd one"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error transforming data with template",
            "Error creating velocity template"
          ],
          "comment": "the empty renders are the template's choice, not a template failure"
        }
      ],
      "knownDefect": {
        "ref": "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:340-345",
        "summary": "An empty template result is not buffered as a payload but still counts as an item (TargetDataBuffer.kt:27-35), so buildRecords indexes buffer.payloads past its end: the IndexOutOfBoundsException drops the whole PutRecords batch with one WriteError, including its valid records",
        "assertCurrent": [
          {
            "kind": "recordCount",
            "where": {
              "via": "four"
            },
            "equals": 0,
            "comment": "every batch of four holds two empty renders, so every batch is dropped"
          },
          {
            "kind": "metric",
            "source": "KinFour",
            "name": "WriteError",
            "op": "ge",
            "value": 2
          },
          {
            "kind": "metric",
            "source": "KinFour",
            "name": "Writes",
            "op": "eq",
            "value": 0
          },
          {
            "kind": "metric",
            "source": "KinOne",
            "name": "WriteError",
            "op": "ge",
            "value": 2,
            "comment": "an odd record alone in its batch throws as well"
          },
          {
            "kind": "logContains",
            "text": "IndexOutOfBoundsException",
            "min": 2
          }
        ],
        "assertCorrect": [
          {
            "kind": "recordCount",
            "where": {
              "via": "four"
            },
            "min": 2
          },
          {
            "kind": "metric",
            "source": "KinFour",
            "name": "Writes",
            "op": "ge",
            "value": 1
          }
        ]
      },
