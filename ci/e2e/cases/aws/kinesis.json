    {
      "id": "AWS-KIN-02",
      "title": "Kinesis batching: the default BatchSize of 10 fills PutRecords calls under a steady stream; Interval flushes a partial batch once the stream is idle",
      "tier": "aws",
      "priority": "P1",
      "intent": "Batching is how SFC keeps the PutRecords rate down, and Interval is what flushes a partial batch. KinBatch sets no BatchSize, so the documented default of 10 applies (AwsKinesisTargetConfiguration.kt:55-62, :134; aws-kinesis.md:47); it gets a record every 100 ms with Interval 2000, so every request must carry exactly ten entries (handleTargetData, AwsKinesisTargetWriter.kt:209-211). KinIdle gets a record every second with BatchSize 10 and Interval 200, so only the timer (:166-169, :217-226) can flush it, one record at a time. Both write to the stack's stream and are told apart by schedule name. The case fails if batching is off or the default changed (Messages/Writes would leave 7..10 for KinBatch), if the Interval flush does not happen (no Slow record would arrive before ten had accumulated, 10 s), or if records are lost or duplicated. PutRecords does not promise order inside one request, so the counters are checked as contiguous sets. Every entry's partition key is its index in the batch (:342), '0'..'9' for KinBatch and always '0' for KinIdle; on a one-shard stream that cannot change where a record goes and the sink does not return keys, so keys are not asserted. Interval resets on every record instead of bounding the wait: AWS-KIN-DEF-01.",
      "pins": [
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:166-171",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:209-211",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:217-226",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:340-342",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/config/AwsKinesisTargetConfiguration.kt:55-71",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/config/AwsKinesisTargetConfiguration.kt:133-134",
        "docs/targets/aws-kinesis.md:42-47"
      ],
      "sinks": {
        "main": {
          "kind": "kinesis"
        }
      },
      "steps": [
        {
          "wait": {
            "metric": {
              "source": "KinIdle",
              "name": "Writes",
              "op": "ge",
              "value": 4
            }
          }
        },
        {
          "wait": {
            "metric": {
              "source": "KinBatch",
              "name": "Writes",
              "op": "ge",
              "value": 3
            }
          }
        }
      ],
      "records": 34,
      "timeoutSeconds": 120,
      "offlineSeconds": 25,
      "assert": [
        {
          "kind": "recordCount",
          "where": {
            "schedule": "Slow"
          },
          "min": 3
        },
        {
          "kind": "recordCount",
          "where": {
            "schedule": "Fast"
          },
          "min": 20
        },
        {
          "kind": "channelValueRun",
          "where": {
            "schedule": "Slow"
          },
          "source": "simSlow",
          "channel": "ctr"
        },
        {
          "kind": "channelValueRun",
          "where": {
            "schedule": "Fast"
          },
          "source": "simFast",
          "channel": "ctr"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "KinBatch",
            "name": "Messages"
          },
          "denominator": {
            "source": "KinBatch",
            "name": "Writes"
          },
          "op": "ge",
          "value": 7,
          "comment": "full batches of the default 10 (one stalled partial batch tolerated); 1 would mean no batching"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "KinBatch",
            "name": "Messages"
          },
          "denominator": {
            "source": "KinBatch",
            "name": "Writes"
          },
          "op": "le",
          "value": 10,
          "comment": "no request above the default BatchSize"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "KinIdle",
            "name": "Messages"
          },
          "denominator": {
            "source": "KinIdle",
            "name": "Writes"
          },
          "op": "lt",
          "value": 2,
          "comment": "the 200 ms timer flushes each slow record (the start-up reads can share a write); without it a write would carry 10"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error sending to kinesis",
            ", error code : "
          ]
        }
      ],
      "config": {
