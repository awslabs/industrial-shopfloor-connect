{
  "cases": [
    {
      "id": "AWS-KIN-01",
      "title": "Kinesis BatchSize 1: every record is its own PutRecords call and arrives in the real stream, in order",
      "tier": "aws",
      "priority": "P0",
      "intent": "The basic Kinesis contract against the real service: with BatchSize 1 each record is flushed on arrival (handleTargetData, AwsKinesisTargetWriter.kt:209-211) as a one-entry PutRecords request whose data is the record JSON (:340-345), authorised by kinesis:PutRecords from stream.grantReadWrite on the project role (sfc-it-stack.ts:425). One writer coroutine sends the requests one after the other into the stack's one-shard stream, so the stream keeps SFC's order and the counter must read back as an unbroken sequence. The case fails if a record is lost, duplicated or reordered (channelSequence), if SFC batches despite BatchSize 1 (Messages/Writes must be exactly 1), if the data is not the full SFC record (schedule, Int counter, serial), or if a write error is counted. A PutRecords entry the service rejects is only logged (:285-293) - Writes and WriteSuccess are counted for the whole request before its per-entry results are read (:263-266) - so the case also requires that log line to be absent.",
      "pins": [
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:209-211",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:261-266",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:285-293",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/AwsKinesisTargetWriter.kt:340-345",
        "ci/cdk/lib/sfc-it-stack.ts:192-198",
        "ci/cdk/lib/sfc-it-stack.ts:425",
        "ci/e2e/lib/sinks/aws.py:277-312"
      ],
      "sinks": {
        "main": {
          "kind": "kinesis"
        }
      },
      "records": 6,
      "timeoutSeconds": 120,
      "offlineSeconds": 25,
      "steps": [
        {
          "wait": {
            "metric": {
              "source": "Kin",
              "name": "Writes",
              "op": "ge",
              "value": 6
            }
          }
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "min": 6
        },
        {
          "kind": "channelSequence",
          "source": "sim",
          "channel": "ctr",
          "step": 1,
          "comment": "one PutRecords at a time into one shard: the stream keeps SFC's order"
        },
        {
          "kind": "everyRecord",
          "path": "schedule",
          "equals": "S"
        },
        {
          "kind": "everyRecord",
          "path": "sources.sim.values.ctr.value",
          "type": "int"
        },
        {
          "kind": "everyRecord",
          "path": "serial",
          "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
        },
        {
          "kind": "metricRatio",
          "numerator": {
            "source": "Kin",
            "name": "Messages"
          },
          "denominator": {
            "source": "Kin",
            "name": "Writes"
          },
          "op": "eq",
          "value": 1,
          "comment": "BatchSize 1: one entry per PutRecords request"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error sending to kinesis",
            ", error code : ",
            "No records to send to kinesis stream",
            "NoClassDefFoundError",
            "ClassNotFoundException"
          ],
          "comment": "', error code : ' is the per-entry rejection line (AwsKinesisTargetWriter.kt:289); it is not counted as WriteError"
        }
      ],
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "AWS-KIN-01",
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "S",
