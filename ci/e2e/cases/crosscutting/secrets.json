{
  "cases": [
    {
      "id": "LOC-SEC-SM-01",
      "title": "A Secrets Manager placeholder resolves via its alias, is stored encrypted and is never printed",
      "tier": "local-infra",
      "priority": "P0",
      "services": [
        {
          "name": "aws",
          "kind": "command",
          "args": {
            "readyLog": "fake aws listening",
            "argv": [
              "python",
              "${COUNTERPARTS}/xc_fake_aws.py",
              "--port",
              "${SFC_E2E_AWS_PORT}",
              "--spec",
              "${SFC_E2E_CASE_DIR}/aws-spec.json",
              "--aws-config",
              "${SFC_E2E_WORK}/aws.config"
            ]
          }
        }
      ],
      "env": {
        "AWS_CONFIG_FILE": "aws.config",
        "AWS_PROFILE": "default",
        "AWS_SHARED_CREDENTIALS_FILE": "/dev/null",
        "AWS_ACCESS_KEY_ID": "e2e-fake",
        "AWS_SECRET_ACCESS_KEY": "e2e-fake",
        "AWS_REGION": "e2e-local-1",
        "AWS_EC2_METADATA_DISABLED": "true"
      },
      "dirs": [
        "sm"
      ],
      "sinks": {
        "main": {
          "kind": "file"
        },
        "store": {
          "kind": "file",
          "format": "text"
        },
        "requests": {
          "kind": "jsonl",
          "service": "aws",
          "file": "requests.jsonl"
        }
      },
      "timeoutSeconds": 60,
      "assert": [
        {
          "kind": "logAbsent",
          "texts": [
            "e2e-sm-VALUE-9F3KQ27XHBL4"
          ],
          "comment": "the plain secret is never printed, whatever happens"
        }
      ],
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "LOC-SEC-SM-01",
        "Version": 1,
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "S",
            "Interval": 100,
            "Active": true,
            "TimestampLevel": "Both",
            "Sources": {
              "sim": [
                "*"
              ]
            },
            "Targets": [
              "FileTarget",
              "Dbg"
            ]
          }
        ],
        "Sources": {
          "sim": {
            "Name": "sim",
            "ProtocolAdapter": "SimAdapter",
            "Channels": {
              "ctr": {
                "Name": "ctr",
                "Simulation": {
                  "SimulationType": "Counter",
                  "DataType": "Int",
                  "Direction": "UP",
                  "Min": 0,
                  "Max": 100000,
                  "Step": 1
                }
              }
            }
          }
        },
        "Targets": {
          "FileTarget": {
            "Active": true,
            "TargetType": "FILE-TARGET",
            "Directory": "${SFC_E2E_SINK}",
            "Json": true,
            "UtcTime": true,
            "Extension": ".json",
            "BufferSize": 1,
            "BufferCount": 1,
            "Interval": 60,
            "Description": "${sfc-e2e-secret}"
          },
          "Dbg": {
            "Active": true,
            "TargetType": "DEBUG-TARGET"
          }
        },
        "ProtocolAdapters": {
          "SimAdapter": {
            "AdapterType": "SIMULATOR"
          }
        },
        "Metrics": {
          "Interval": 1,
          "Writer": {}
        },
        "Metadata": {
          "runId": "${SFC_E2E_RUN_ID}",
          "case": "${SFC_E2E_CASE}",
          "mode": "${SFC_E2E_MODE}",
          "marker": "${SFC_E2E_MARKER}",
          "probe": "${sfc-e2e-secret}"
        },
        "SecretsManager": {
          "Secrets": [
            {
              "SecretId": "sfc-e2e/secret",
              "Alias": "sfc-e2e-secret"
            }
          ],
          "Region": "e2e-local-1",
          "PrivateKeyFile": "${SFC_E2E_DIR_SM}/sfc-key.pem",
          "StoredSecretsFile": "${SFC_E2E_SINK_STORE}/sfc-secrets.json"
        }
      },
      "uberjar": {
        "AdapterTypes": {
          "SIMULATOR": {
            "FactoryClassName": "com.amazonaws.sfc.simulator.SimulatorAdapter"
          }
        },
        "TargetTypes": {
          "FILE-TARGET": {
            "FactoryClassName": "com.amazonaws.sfc.filetarget.FileTargetWriter"
          },
          "DEBUG-TARGET": {
            "FactoryClassName": "com.amazonaws.sfc.debugtarget.DebugTargetWriter"
          }
        },
        "Metrics": {
          "Writer": {
            "MetricsWriter": {
              "FactoryClassName": "com.amazonaws.sfc.e2e.E2eMetricsWriter"
            }
          }
        }
      },
      "inprocess": {
        "AdapterTypes": {
          "SIMULATOR": {
            "FactoryClassName": "com.amazonaws.sfc.simulator.SimulatorAdapter",
            "JarFiles": [
              "${SFC_DEPLOYMENT_DIR}/simulator/lib"
            ]
          }
        },
        "TargetTypes": {
          "FILE-TARGET": {
            "FactoryClassName": "com.amazonaws.sfc.filetarget.FileTargetWriter",
            "JarFiles": [
              "${SFC_DEPLOYMENT_DIR}/file-target/lib"
            ]
          },
          "DEBUG-TARGET": {
            "FactoryClassName": "com.amazonaws.sfc.debugtarget.DebugTargetWriter",
            "JarFiles": [
              "${SFC_DEPLOYMENT_DIR}/debug-target/lib"
            ]
          }
        },
        "Metrics": {
          "Writer": {
            "MetricsWriter": {
              "FactoryClassName": "com.amazonaws.sfc.e2e.E2eMetricsWriter",
              "JarFiles": [
                "${SFC_E2E_SUPPORT_JAR}"
              ]
            }
          }
        }
      },
      "ipcServices": {
        "SimAdapterServer": {
          "module": "simulator"
        },
        "FileTargetServer": {
          "module": "file-target"
        },
        "DbgServer": {
          "module": "debug-target"
        }
      },
      "ipc": {
        "ProtocolAdapters": {
          "SimAdapter": {
            "AdapterServer": "SimAdapterServer"
          }
        },
        "AdapterServers": {
          "SimAdapterServer": {
            "Address": "${SFC_E2E_IPC_HOST}",
            "Port": 50000
          }
        },
        "Targets": {
          "FileTarget": {
            "TargetServer": "FileTargetServer"
          },
          "Dbg": {
            "TargetServer": "DbgServer"
          }
        },
        "TargetServers": {
          "FileTargetServer": {
            "Address": "${SFC_E2E_IPC_HOST}",
            "Port": 50001
          },
          "DbgServer": {
            "Address": "${SFC_E2E_IPC_HOST}",
            "Port": 50002
          }
        },
        "Metrics": {
          "Writer": {
            "MetricsWriter": {
              "FactoryClassName": "com.amazonaws.sfc.e2e.E2eMetricsWriter",
              "JarFiles": [
                "${SFC_E2E_SUPPORT_JAR}"
              ]
            }
          }
        }
      },
      "files": {
        "aws-spec.json": "{\n  \"secrets\": {\n    \"sfc-e2e/secret\": \"e2e-sm-VALUE-9F3KQ27XHBL4\"\n  }\n}"
      },
      "intent": "A Secrets Manager secret (served by the local fake, xc_fake_aws.py) is referenced by its alias as ${sfc-e2e-secret} in a target's Description. Correct behaviour: the placeholder resolves, the stored secrets file holds only the encrypted value, and the plain value is never printed. Today SFC cannot start at all: ConfigReader computes jsonConfig (ConfigReader.kt:30) - which resolves secrets and records them in usedSecrets (:127) - before the usedSecrets property itself is initialised (:32), so the first resolved secret throws a NullPointerException and no service instance is created.",
      "pins": [
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ConfigReader.kt:30",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ConfigReader.kt:32",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ConfigReader.kt:127"
      ],
      "failFast": [],
      "steps": [
        {
          "wait": {
            "any": [
              {
                "sink": "main",
                "records": 5
              },
              {
                "log": "\"this.usedSecrets\" is null"
              }
            ]
          }
        }
      ],
      "knownDefect": {
        "ref": "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ConfigReader.kt:30",
        "summary": "jsonConfig is initialised before usedSecrets, so resolving any Secrets Manager placeholder throws a NullPointerException and SFC does not start",
        "assertCurrent": [
          {
            "kind": "logContains",
            "text": "Cannot invoke \"java.util.Map.put(Object, Object)\" because \"this.usedSecrets\" is null"
          },
          {
            "kind": "recordCount",
            "sink": "main",
            "max": 0
          }
        ],
        "assertCorrect": [
          {
            "kind": "recordCount",
            "sink": "main",
            "min": 5
          },
          {
            "kind": "rawContains",
            "sink": "store",
            "text": "encryptedSecretString"
          },
          {
            "kind": "rawAbsent",
            "sink": "store",
            "texts": [
              "e2e-sm-VALUE-9F3KQ27XHBL4"
            ]
          }
        ]
      }
    }
  ]
}
