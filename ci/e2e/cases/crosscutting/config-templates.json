{
  "cases": [
    {
      "id": "CORE-CFG-TPL-01",
      "title": "Configuration templates: whole-node replacement, %placeholders%, nesting with placeholder pass-through, partial in-string replacement, and @file-loaded templates",
      "tier": "core",
      "priority": "P0",
      "intent": "Merged with CORE-CFG-TEMPLATES-01. TemplateResolver replaces a string that is exactly $(Name, k=v) with the template's value, of any type (TemplateResolver.kt:24-26), substitutes %k% in the template's strings (:84-96), and resolves templates inside the result again, so templates nest. Two sources come from one SRC template with different name/start values; start passes through two levels of nesting into the counter's Min, and Step is a numeric template. A third source's channel comes from a template loaded with @file: (includes resolve before templates, ConfigReader.kt:85-86). Metadata uses a whole-string and a partial in-string replacement (:30). Every assertion fails if any of those steps is skipped.",
      "pins": [
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/TemplateResolver.kt:24",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/TemplateResolver.kt:30",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/TemplateResolver.kt:84",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/data/JsonHelper.kt:276",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ConfigReader.kt:85"
      ],
      "records": 6,
      "timeoutSeconds": 60,
      "modeParity": true,
      "assert": [
        {
          "kind": "recordCount",
          "min": 6
        },
        {
          "kind": "keySet",
          "path": "sources",
          "keys": [
            "One",
            "Two",
            "Three"
          ],
          "comment": "source names from %name%"
        },
        {
          "kind": "channelSequence",
          "source": "One",
          "channel": "c",
          "step": 2
        },
        {
          "kind": "channelSequence",
          "source": "Two",
          "channel": "c",
          "step": 2
        },
        {
          "kind": "channelNumericRange",
          "source": "One",
          "channel": "c",
          "min": 0,
          "max": 98,
          "comment": "Min 0 passed through $(SRC) -> $(NamedCounter) -> $(CounterSim)"
        },
        {
          "kind": "channelNumericRange",
          "source": "Two",
          "channel": "c",
          "min": 100,
          "max": 198,
          "comment": "Min 100: the other start value"
        },
        {
          "kind": "channelValueSet",
          "source": "Three",
          "channel": "f",
          "values": [
            42
          ]
        },
        {
          "kind": "everyRecord",
          "path": "metadata.t",
          "equals": "tpl-ok"
        },
        {
          "kind": "everyRecord",
          "path": "metadata.p",
          "equals": "v-tpl-ok-x",
          "comment": "partial replacement inside a string"
        },
        {
          "kind": "rawAbsent",
          "texts": [
            "$(",
            "%name%",
            "%start%"
          ]
        }
      ],
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "CORE-CFG-TPL-01",
        "Version": 1,
        "LogLevel": "Info",
        "Templates": {
          "TAG": "tpl-ok",
          "STEP": 2,
          "CounterSim": {
            "SimulationType": "Counter",
            "DataType": "Int",
            "Direction": "UP",
            "Min": "%start%",
            "Max": 100000,
            "Step": "$(STEP)"
          },
          "NamedCounter": {
            "Name": "%name%",
            "Simulation": "$(CounterSim, start=%start%)"
          },
          "SRC": {
            "Name": "%name%",
            "ProtocolAdapter": "SimAdapter",
            "Channels": {
              "c": "$(NamedCounter, name=c, start=%start%)"
            }
          },
          "FromFile": "@file:${SFC_E2E_CASE_DIR}/tpl-chan.json"
        },
        "Metadata": {
          "runId": "${SFC_E2E_RUN_ID}",
          "case": "${SFC_E2E_CASE}",
          "mode": "${SFC_E2E_MODE}",
          "marker": "${SFC_E2E_MARKER}",
