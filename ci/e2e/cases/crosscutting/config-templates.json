    {
      "id": "CORE-CFG-TPL-NUMPARTIAL-01",
      "title": "A numeric template in a partial replacement renders as a double (known defect)",
      "tier": "core",
      "priority": "P1",
      "intent": "In a partial replacement TemplateResolver inserts resolved.toString() (TemplateResolver.kt:30). Template values come from the Gson-parsed configuration map, where every number is a Double (ConfigReader.kt:72), so 'v$(Ver)' with Ver=3 becomes 'v3.0'. The isNumericValue helper that could prevent it is never called (:104-105). Ports, versions or paths built this way get a '.0'. The string template in the same Metadata is the control: partial replacement itself works.",
      "pins": [
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/TemplateResolver.kt:30",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/TemplateResolver.kt:104",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ConfigReader.kt:72"
      ],
      "records": 3,
      "timeoutSeconds": 60,
      "modeParity": true,
      "assert": [
        {
          "kind": "recordCount",
          "min": 3
        },
        {
          "kind": "everyRecord",
          "path": "metadata.n",
          "equals": "x-plant"
        }
      ],
      "knownDefect": {
        "ref": "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/TemplateResolver.kt:30",
        "summary": "Partial template replacement inserts the Double's toString(), so an integral numeric template renders with '.0' ('v$(Ver)' -> 'v3.0'). Correct: 'v3'.",
        "assertCurrent": [
          {
            "kind": "everyRecord",
            "path": "metadata.v",
            "equals": "v3.0"
          }
        ],
        "assertCorrect": [
          {
            "kind": "everyRecord",
            "path": "metadata.v",
            "equals": "v3"
          }
