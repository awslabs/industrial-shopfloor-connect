          "p": "v-$(TAG)-x"
        },
        "Schedules": [
          {
            "Name": "S",
            "Interval": 100,
            "Active": true,
            "TimestampLevel": "Both",
            "Sources": {
              "s1": [
                "*"
              ],
              "s2": [
                "*"
              ],
              "s3": [
                "*"
              ]
            },
            "Targets": [
              "FileTarget"
            ]
          }
        ],
        "Sources": {
          "s1": "$(SRC, name=One, start=0)",
          "s2": "$(SRC, name=Two, start=100)",
          "s3": {
