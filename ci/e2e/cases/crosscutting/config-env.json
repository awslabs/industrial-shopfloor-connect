    {
      "id": "CORE-CFG-ENV-ESCAPE-01",
      "title": "Environment values with backslashes and embedded quotes reach string values intact",
      "tier": "core",
      "priority": "P2",
      "intent": "The research lead said such values corrupt the configuration, because ConfigReader's final pass splices raw values into the JSON text (ConfigReader.kt:88-89, :150). That pass is not what substitutes string values: IncludeResolver visits every string node of the parsed map and substitutes placeholders there first (IncludeResolver.kt:61, returned as the node's value at :65), and the map is then re-serialised with proper escaping (ConfigReader.kt:85-87). A Windows path and a value with inner double quotes therefore arrive unchanged, also inside a longer string. This pins that ordering: moving substitution to the text pass alone would corrupt exactly these values.",
      "pins": [
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/IncludeResolver.kt:61",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/IncludeResolver.kt:65",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ConfigReader.kt:85",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ConfigReader.kt:87",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ConfigReader.kt:150"
      ],
      "env": {
        "SFC_E2E_WINPATH": "C:\\temp\\x",
        "SFC_E2E_INNERQUOTE": "say \"hi\" twice"
      },
      "records": 3,
      "timeoutSeconds": 60,
      "modeParity": true,
      "assert": [
        {
          "kind": "recordCount",
          "min": 3
        },
        {
          "kind": "channelSequence",
          "source": "sim",
          "channel": "ctr",
          "step": 1
        },
        {
          "kind": "everyRecord",
          "path": "metadata.p",
          "equals": "C:\\temp\\x",
          "comment": "\\t and \\x would be a tab and an invalid escape in raw JSON"
        },
        {
          "kind": "everyRecord",
          "path": "metadata.q",
          "equals": "say \"hi\" twice"
        },
        {
          "kind": "everyRecord",
          "path": "metadata.mixed",
          "equals": "dir=C:\\temp\\x;say=say \"hi\" twice"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error running service",
            "Error getting configuration"
          ]
        }
      ],
