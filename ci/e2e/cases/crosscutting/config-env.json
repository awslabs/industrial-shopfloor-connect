      "id": "CORE-CFG-DISABLED-CHANNEL-01",
      "title": "'#'-prefixed channel keys and schedule-source keys are disabled",
      "tier": "core",
      "priority": "P2",
      "intent": "A key starting with '#' comments an entry out: SourceConfiguration drops such channels (SourceConfiguration.kt:36) and ScheduleConfiguration drops such schedule sources (ScheduleConfiguration.kt:69). The case has a second counter under '#off' and a schedule source '#ghost' that does not exist. Records must carry only ctr, and the unknown '#ghost' must not fail validation, which it would if it were not filtered.",
      "pins": [
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/SourceConfiguration.kt:36",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ScheduleConfiguration.kt:69",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/BaseConfiguration.kt:309"
      ],
      "records": 4,
      "timeoutSeconds": 60,
      "modeParity": true,
      "assert": [
        {
          "kind": "recordCount",
          "min": 4
        },
        {
          "kind": "channelSequence",
          "source": "sim",
          "channel": "ctr",
          "step": 1
        },
        {
          "kind": "keySet",
          "path": "sources",
          "keys": [
            "sim"
          ]
        },
        {
          "kind": "keySet",
          "path": "sources.sim.values",
          "keys": [
            "ctr"
          ]
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Error creating service instance"
          ]
        }
      ],
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "CORE-CFG-DISABLED-CHANNEL-01",
        "Version": 1,
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "S",
            "Interval": 100,
            "Active": true,
            "TimestampLevel": "Both",
            "Sources": {
              "sim": [
                "*"
              ],
              "#ghost": [
                "*"
              ]
            },
            "Targets": [
              "FileTarget"
            ]
          }
        ],
        "Sources": {
          "sim": {
            "Name": "sim",
            "ProtocolAdapter": "SimAdapter",
            "Channels": {
              "ctr": {
                "Name": "ctr",
                "Simulation": {
                  "SimulationType": "Counter",
