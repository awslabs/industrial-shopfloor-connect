    {
      "id": "CORE-CFG-ENV-01",
      "title": "Environment placeholders resolve, with whitespace inside the braces, quote trimming, numeric fields and deferred ${{...}} placeholders left alone",
      "tier": "core",
      "priority": "P0",
      "intent": "The positive counterpart of CORE-CFG-PLACEHOLDER-NEG-01. SFC substitutes ${NAME} from the process environment as the last step of reading a configuration (ConfigReader.kt:88-89), on the JSON text: the pattern allows whitespace inside the braces (:167), every value is trimmed of surrounding single and double quotes (:150), and a quoted placeholder in a numeric field (Step) becomes a number. The deferred form ${{NAME}} is deliberately not matched by that pattern (:170), so it must reach the records verbatim. Every record proves all five at once; if substitution did nothing, the unresolved placeholders would abort startup instead.",
      "pins": [
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ConfigReader.kt:88",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ConfigReader.kt:144",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ConfigReader.kt:150",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ConfigReader.kt:167",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/ConfigReader.kt:170",
        "core/sfc-main/src/main/kotlin/com/amazonaws/sfc/ScheduleWriter.kt:148"
      ],
      "env": {
        "SFC_E2E_TAG": "e2e-tag",
        "SFC_E2E_DQ": "\"dq-value\"",
        "SFC_E2E_SQ": "'sq-value'",
        "SFC_E2E_STEP": "2"
      },
      "records": 5,
      "timeoutSeconds": 60,
      "modeParity": true,
      "assert": [
        {
          "kind": "recordCount",
          "min": 5
        },
        {
          "kind": "channelSequence",
          "source": "sim",
          "channel": "ctr",
          "step": 2,
          "comment": "Step came from \"${SFC_E2E_STEP}\" = \"2\": a quoted placeholder in a numeric field"
        },
        {
          "kind": "everyRecord",
          "path": "metadata.envCase",
          "equals": "CORE-CFG-ENV-01"
        },
        {
          "kind": "everyRecord",
          "path": "metadata.tag",
          "equals": "e2e-tag",
          "comment": "${ SFC_E2E_TAG } with spaces inside the braces"
        },
        {
          "kind": "everyRecord",
          "path": "metadata.dq",
          "equals": "dq-value",
          "comment": "the env value carries double quotes; they are trimmed"
        },
        {
          "kind": "everyRecord",
          "path": "metadata.sq",
          "equals": "sq-value",
          "comment": "the env value carries single quotes; they are trimmed"
        },
        {
          "kind": "everyRecord",
          "path": "metadata.deferred",
          "equals": "${{SFC_E2E_RUNTIME_ONLY}}",
          "comment": "the deferred form is not a startup placeholder and is not reported as unresolved"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "could not be replaced"
          ]
        }
      ],
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "CORE-CFG-ENV-01",
        "Version": 1,
        "LogLevel": "Info",
        "Metadata": {
          "runId": "${SFC_E2E_RUN_ID}",
          "case": "${SFC_E2E_CASE}",
          "mode": "${SFC_E2E_MODE}",
          "marker": "${SFC_E2E_MARKER}",
          "envCase": "${SFC_E2E_CASE}",
          "tag": "${ SFC_E2E_TAG }",
          "dq": "${SFC_E2E_DQ}",
