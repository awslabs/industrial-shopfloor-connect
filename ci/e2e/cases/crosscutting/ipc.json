{
  "cases": [
    {
      "id": "CORE-IPC-STARTUP-01",
      "title": "IPC startup: the adapter service ignores the first InitializeAdapter, so the first read fails UNKNOWN and the metrics reader spins (known defect)",
      "tier": "core",
      "priority": "P1",
      "modes": [
        "ipc"
      ],
      "intent": "Root cause of the ~10 s first-read failure in every IPC run. IpcAdapterService.initializeAdapter only creates the adapter when it receives the SAME configuration a second time: a new configuration is just stored in lastRequest and answered initialized=true. sfc-main trusts the answer and calls ReadValues, whose flow dereferences the null adapter (adapter!!), which reaches the client as gRPC UNKNOWN; IpcSourceReader logs it and waits WAIT_AFTER_ERROR=10 s, then a new client sends the same configuration again and only that creates the adapter. Meanwhile IpcMetricsProvider sees the reader initialised and calls ReadMetrics, which returns at once because the service's own flag is still false, and re-creates its client with no delay: thousands of gRPC clients in 10 s. Counted, not timed: two 'initialized' answers for one adapter, one UNKNOWN error, a client-creation storm. IPC mode only.",
      "pins": [
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcAdapterService.kt:214-272",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcAdapterService.kt:147",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcAdapterService.kt:190",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcSourceReadClient.kt:33-55",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcSourceReader.kt:96-143",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcSourceReader.kt:194",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcMetricsProvider.kt:52-90"
      ],
      "records": 8,
      "timeoutSeconds": 60,
      "assert": [
        {
          "kind": "recordCount",
          "min": 8
        },
        {
          "kind": "channelSequence",
          "source": "sim",
          "channel": "ctr",
          "step": 1
        },
        {
          "kind": "logCount",
          "process": "adapter-SimAdapter",
          "text": "SFC_MODULE SIMULATOR",
          "equals": 1,
          "comment": "The adapter is created exactly once, on the request that repeats the configuration."
        }
      ],
      "config": {
        "AWSVersion": "2022-04-02",
        "Name": "CORE-IPC-STARTUP-01",
        "Version": 1,
        "LogLevel": "Info",
        "Schedules": [
          {
            "Name": "S",
            "Interval": 100,
            "Active": true,
            "TimestampLevel": "Both",
            "Sources": {
              "sim": [
                "*"
              ]
            },
            "Targets": [
              "FileTarget"
            ]
          }
        ],
        "Sources": {
          "sim": {
            "Name": "sim",
            "ProtocolAdapter": "SimAdapter",
            "Channels": {
              "ctr": {
                "Name": "ctr",
                "Simulation": {
                  "SimulationType": "Counter",
                  "DataType": "Int",
                  "Direction": "UP",
                  "Min": 0,
                  "Max": 100000,
                  "Step": 1
                }
              }
            }
          }
        },
        "Targets": {
          "FileTarget": {
            "Active": true,
            "TargetType": "FILE-TARGET",
            "Directory": "${SFC_E2E_SINK}",
            "Json": true,
            "UtcTime": true,
            "Extension": ".json",
            "BufferSize": 1,
            "BufferCount": 1,
            "Interval": 60
          }
        },
        "ProtocolAdapters": {
          "SimAdapter": {
            "AdapterType": "SIMULATOR"
          }
        },
        "Metrics": {
          "Interval": 1,
          "Writer": {}
        },
        "Metadata": {
          "runId": "${SFC_E2E_RUN_ID}",
          "case": "${SFC_E2E_CASE}",
          "mode": "${SFC_E2E_MODE}",
          "marker": "${SFC_E2E_MARKER}"
        }
      },
      "ipcServices": {
        "SimAdapterServer": {
          "module": "simulator"
        },
        "FileTargetServer": {
          "module": "file-target"
        }
      },
      "ipc": {
        "ProtocolAdapters": {
          "SimAdapter": {
            "AdapterServer": "SimAdapterServer"
          }
        },
        "AdapterServers": {
          "SimAdapterServer": {
            "Address": "${SFC_E2E_IPC_HOST}",
            "Port": 50000
          }
        },
        "Targets": {
          "FileTarget": {
            "TargetServer": "FileTargetServer"
          }
        },
        "TargetServers": {
          "FileTargetServer": {
            "Address": "${SFC_E2E_IPC_HOST}",
            "Port": 50001
          }
        },
        "Metrics": {
          "Writer": {
            "MetricsWriter": {
              "FactoryClassName": "com.amazonaws.sfc.e2e.E2eMetricsWriter",
              "JarFiles": [
                "${SFC_E2E_SUPPORT_JAR}"
              ]
            }
          }
        }
      },
      "knownDefect": {
        "ref": "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcAdapterService.kt:217-218",
        "summary": "initializeAdapter's cache check is inverted: a new configuration is only stored and answered initialized=true without creating the adapter, so the first ReadValues hits adapter!! (gRPC UNKNOWN), the reader backs off 10 s, and IpcMetricsProvider re-creates its client in a tight loop meanwhile (IpcMetricsProvider.kt:87-88)",
        "assertCurrent": [
          {
            "kind": "logRegex",
            "process": "sfc-main",
            "regex": "Error communicating with source connector service on [0-9.]+:[0-9]+, UNKNOWN"
          },
          {
            "kind": "logCount",
            "process": "sfc-main",
            "text": "IPC source service adapter for server",
            "equals": 2,
            "comment": "Two 'initialized' answers for one adapter: the first one created nothing."
          },
          {
            "kind": "logCount",
            "process": "sfc-main",
            "text": "Creating client to connect to IPC service",
            "min": 100,
            "comment": "The metrics reader storm; observed 5,000+ in 10 s. Two orders of magnitude above the correct bound."
          },
          {
            "kind": "metric",
            "source": "SfcCore",
            "name": "Errors",
            "op": "ge",
            "value": 1
          }
        ],
        "assertCorrect": [
          {
            "kind": "logAbsent",
            "process": "sfc-main",
            "texts": [
              "Error communicating with source connector service on"
            ]
          },
          {
            "kind": "logCount",
            "process": "sfc-main",
            "text": "IPC source service adapter for server",
            "equals": 1
          },
          {
            "kind": "logCount",
            "process": "sfc-main",
            "text": "Creating client to connect to IPC service",
            "max": 10
          }
        ]
      }
    },
    {
      "id": "CORE-IPC-SVC-CLI-01",
      "title": "IPC service command line: -envport works; a bad -connection, a bad -interface and TLS without -key exit 1 with the reason",
      "tier": "core",
      "priority": "P2",
      "modes": [
        "ipc"
      ],
      "intent": "The IPC service launchers are run directly by the probe, without a configuration (as the harness does). -envport names an environment variable that holds the port, and the service listens there. Each misconfiguration fails before binding with its own message and exit code 1 (ServiceMain.runService exits when no service instance was created): an unknown -connection value, an -interface that does not exist, and ServerSideTLS without -key. -config, -port and -envport form one option group, which is why the harness cannot add -envport to its own launches. IPC mode only.",
      "pins": [
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcProtocolServerCommandLine.kt:16-32",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcProtocolServerCommandLine.kt:55-66",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcBaseService.kt:165-168",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcBaseService.kt:175-208",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/service/ServiceMain.kt:168-174"
      ],
      "sinks": {
        "main": {
          "kind": "file"
        },
        "probe": {
          "kind": "file"
        }
      },
      "records": 3,
      "timeoutSeconds": 120,
      "steps": [
        {
          "wait": {
            "sink": "main",
            "records": 3
          }
        },
        {
          "do": "run",
          "timeoutSeconds": 60,
          "argv": [
            "python",
            "${COUNTERPARTS}/xc_probe.py",
            "svc",
            "--name",
            "envport",
            "--out",
            "${SFC_E2E_SINK_PROBE}/envport.json",
            "--module",
            "simulator",
            "--workdir",
            "${SFC_E2E_WORK}/svc-envport",
            "--timeout",
            "40",
            "--env",
            "SFC_E2E_SVC_PORT=__PORT__",
            "--",
            "-envport",
            "SFC_E2E_SVC_PORT",
            "-nocolor",
            "-info"
          ]
        },
        {
          "do": "run",
          "timeoutSeconds": 60,
          "argv": [
            "python",
            "${COUNTERPARTS}/xc_probe.py",
            "svc",
            "--name",
            "badconnection",
            "--out",
            "${SFC_E2E_SINK_PROBE}/badconnection.json",
            "--module",
            "simulator",
            "--workdir",
            "${SFC_E2E_WORK}/svc-badconnection",
            "--timeout",
            "40",
            "--",
            "-port",
            "__PORT__",
            "-connection",
            "Bogus",
            "-nocolor",
            "-info"
          ]
        },
        {
          "do": "run",
          "timeoutSeconds": 60,
          "argv": [
            "python",
            "${COUNTERPARTS}/xc_probe.py",
            "svc",
            "--name",
            "badinterface",
            "--out",
            "${SFC_E2E_SINK_PROBE}/badinterface.json",
            "--module",
            "simulator",
            "--workdir",
            "${SFC_E2E_WORK}/svc-badinterface",
            "--timeout",
            "40",
            "--",
            "-port",
            "__PORT__",
            "-interface",
            "no-such-if",
            "-nocolor",
            "-info"
          ]
        },
        {
          "do": "run",
          "timeoutSeconds": 60,
          "argv": [
            "python",
            "${COUNTERPARTS}/xc_probe.py",
            "svc",
            "--name",
            "tlsnokey",
            "--out",
            "${SFC_E2E_SINK_PROBE}/tlsnokey.json",
            "--module",
            "simulator",
            "--workdir",
            "${SFC_E2E_WORK}/svc-tlsnokey",
            "--timeout",
            "40",
            "--",
            "-port",
            "__PORT__",
            "-connection",
            "ServerSideTLS",
            "-nocolor",
            "-info"
          ]
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "min": 3
        },
        {
          "kind": "everyRecord",
          "sink": "probe",
          "where": {
            "probe": "envport"
          },
          "path": "outcome",
          "equals": "listening"
        },
        {
          "kind": "everyRecord",
          "sink": "probe",
          "where": {
            "probe": "badconnection"
          },
          "path": "exitCode",
          "equals": 1
        },
        {
