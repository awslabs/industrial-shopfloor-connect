          },
          "path": "output",
          "regex": "(?s).*No IP4 network address for interface no-such-if.*"
        },
        {
          "kind": "everyRecord",
          "sink": "probe",
          "where": {
            "probe": "tlsnokey"
          },
          "path": "exitCode",
          "equals": 1
        },
        {
          "kind": "everyRecord",
