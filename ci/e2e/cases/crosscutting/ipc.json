    {
      "id": "CORE-IPC-SVC-CONFIG-02",
      "title": "An adapter service started with -config ignores the server entry's ConnectionType and serves PlainText (known defect)",
      "tier": "core",
      "priority": "P1",
      "modes": [
        "ipc"
      ],
      "intent": "buildServerConfiguration intends command line first, then the configuration file: cmd.connectionType ?: serverConfiguration.serverConnectionType ?: PlainText. But IpcServiceCommandLine.connectionType returns PlainText, never null, when -connection is absent, so the file's ConnectionType is dead. Here svc-config.json's server entry says ServerSideTLS with a valid certificate and key (which ARE picked up, through the working elvis for -key/-cert); the service started with -config and -adapter listens, logs 'connection type is PlainText', and the probe gets cleartext HTTP/2 from it. A deployment configured for TLS in the file runs unencrypted with no warning. Correct: ServerSideTLS. IPC mode only.",
      "pins": [
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcProtocolServerCommandLine.kt:44-50",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcBaseService.kt:144-147",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcAdapterService.kt:355-371"
      ],
      "sinks": {
        "main": {
          "kind": "file"
        },
        "probe": {
          "kind": "file"
        }
      },
      "records": 3,
      "timeoutSeconds": 90,
      "steps": [
        {
          "wait": {
            "sink": "main",
            "records": 3
          }
        },
        {
          "do": "run",
          "timeoutSeconds": 60,
          "argv": [
            "python",
            "${COUNTERPARTS}/xc_probe.py",
            "svc",
            "--name",
            "tlsinfile",
            "--out",
            "${SFC_E2E_SINK_PROBE}/tlsinfile.json",
            "--module",
            "simulator",
            "--workdir",
            "${SFC_E2E_WORK}/svc-tlsinfile",
            "--template",
            "${SFC_E2E_CASE_DIR}/svc-config.json",
            "--timeout",
            "40",
            "--h2c",
            "--",
            "-config",
            "__WORK__/svc-config.json",
            "-adapter",
            "SimAdapter",
            "-nocolor",
            "-info"
          ]
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "min": 3
        },
        {
          "kind": "everyRecord",
          "sink": "probe",
          "where": {
            "probe": "tlsinfile"
          },
          "path": "outcome",
          "equals": "listening"
        }
      ],
      "knownDefect": {
        "ref": "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcProtocolServerCommandLine.kt:47",
        "summary": "IpcServiceCommandLine.connectionType returns PlainText instead of null when -connection is absent, so the configuration file's ConnectionType is never used (IpcBaseService.kt:147) and a service configured for TLS in the file serves PlainText",
        "assertCurrent": [
          {
            "kind": "everyRecord",
            "sink": "probe",
            "where": {
              "probe": "tlsinfile"
            },
            "path": "output",
            "regex": "(?s).*connection type is PlainText.*"
          },
          {
            "kind": "everyRecord",
            "sink": "probe",
            "where": {
              "probe": "tlsinfile"
            },
            "path": "plaintextH2",
            "equals": true
          }
        ],
        "assertCorrect": [
          {
            "kind": "everyRecord",
            "sink": "probe",
            "where": {
              "probe": "tlsinfile"
            },
            "path": "output",
            "regex": "(?s).*connection type is ServerSideTLS.*"
          },
          {
            "kind": "everyRecord",
            "sink": "probe",
            "where": {
              "probe": "tlsinfile"
            },
            "path": "plaintextH2",
            "equals": false
          }
        ]
      },
