    {
      "id": "CORE-IPC-SVC-CONFIG-01",
      "title": "An adapter service started with -config and no -adapter picks a target id and exits (known defect)",
      "tier": "core",
      "priority": "P1",
      "modes": [
        "ipc"
      ],
      "intent": "The documented alternative to -port: start the IPC service with -config, and with a single protocol adapter in the file the adapter id is implied. getAdapterProtocolID returns serviceConfiguration.activeTargets.keys.first() for that case - a target id - so the service looks up protocol adapter 'FileTarget', logs that it does not exist and exits 1. The control, the same file with -adapter SimAdapter, listens. The probe runs the simulator module launcher itself (svc-config.json in this directory, with a free port); the regular IPC pipeline runs alongside. IPC mode only: the module launchers are unpacked for IPC.",
      "pins": [
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcAdapterService.kt:382-391",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcAdapterService.kt:409-418",
        "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcAdapterService.kt:342-379",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/service/ServiceMain.kt:168-174"
      ],
      "sinks": {
        "main": {
          "kind": "file"
        },
        "probe": {
          "kind": "file"
        }
      },
      "records": 3,
      "timeoutSeconds": 90,
      "steps": [
        {
          "wait": {
            "sink": "main",
            "records": 3
          }
        },
        {
          "do": "run",
          "timeoutSeconds": 60,
          "argv": [
            "python",
            "${COUNTERPARTS}/xc_probe.py",
            "svc",
            "--name",
            "noadapter",
            "--out",
            "${SFC_E2E_SINK_PROBE}/noadapter.json",
            "--module",
            "simulator",
            "--workdir",
            "${SFC_E2E_WORK}/svc-noadapter",
            "--template",
            "${SFC_E2E_CASE_DIR}/svc-config.json",
            "--timeout",
            "40",
            "--",
            "-config",
            "__WORK__/svc-config.json",
            "-nocolor",
            "-info"
          ]
        },
        {
          "do": "run",
          "timeoutSeconds": 60,
          "argv": [
            "python",
            "${COUNTERPARTS}/xc_probe.py",
            "svc",
            "--name",
            "withadapter",
            "--out",
            "${SFC_E2E_SINK_PROBE}/withadapter.json",
            "--module",
            "simulator",
            "--workdir",
            "${SFC_E2E_WORK}/svc-withadapter",
            "--template",
            "${SFC_E2E_CASE_DIR}/svc-config.json",
            "--timeout",
            "40",
            "--",
            "-config",
            "__WORK__/svc-config.json",
            "-adapter",
            "SimAdapter",
            "-nocolor",
            "-info"
          ]
        }
      ],
      "assert": [
        {
          "kind": "recordCount",
          "min": 3
        },
        {
          "kind": "everyRecord",
          "sink": "probe",
          "where": {
            "probe": "withadapter"
          },
          "path": "outcome",
          "equals": "listening",
          "comment": "Control: the same file with -adapter works, so the file itself is a valid service configuration."
        },
        {
          "kind": "everyRecord",
          "sink": "probe",
          "where": {
            "probe": "withadapter"
          },
          "path": "output",
          "regex": "(?s).*IPC protocol service started, listening on .*"
        }
      ],
      "knownDefect": {
        "ref": "core/sfc-ipc/src/main/kotlin/com/amazonaws/sfc/ipc/IpcAdapterService.kt:389",
        "summary": "With one protocol adapter and no -adapter, getAdapterProtocolID returns activeTargets.keys.first() (a target id), so a service started with -config exits 1 with 'Protocol Adapter \"FileTarget\" does not exist' (NoSuchElementException when there is no active target)",
        "assertCurrent": [
          {
            "kind": "everyRecord",
            "sink": "probe",
            "where": {
              "probe": "noadapter"
            },
            "path": "outcome",
            "equals": "exited"
          },
          {
            "kind": "everyRecord",
            "sink": "probe",
            "where": {
              "probe": "noadapter"
            },
            "path": "exitCode",
            "equals": 1
          },
          {
            "kind": "everyRecord",
            "sink": "probe",
            "where": {
              "probe": "noadapter"
            },
            "path": "output",
            "regex": "(?s).*Protocol Adapter \"FileTarget\" does not exist in configuration, existing protocols adapters are \\[SimAdapter\\].*"
          }
        ],
        "assertCorrect": [
          {
            "kind": "everyRecord",
            "sink": "probe",
            "where": {
              "probe": "noadapter"
            },
            "path": "outcome",
            "equals": "listening"
          }
