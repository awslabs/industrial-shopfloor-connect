    {
      "id": "CORE-CFG-RELOAD-02",
      "title": "In-process, a configuration change reaches the adapter: the reloaded counter starts at its new Min",
      "tier": "core",
      "priority": "P1",
      "intent": "The update renames the schedule to S2, moves it to a second file target (sink v2) and changes an adapter-level setting: the counter's Min becomes 1000. S2 records prove the new configuration is running; their counter values show whether the adapter got it too. In-process the new MainControllerService builds a new InstanceFactory, whose URLClassLoader loads SimulatorAdapter afresh (InstanceFactory.kt:39-41), so the adapter cached in its companion object (SimulatorAdapter.kt:213-214, :239) is a new one and the first S2 value is exactly 1000. In-process only: the uberjar and IPC modes keep the old adapter (CORE-CFG-RELOAD-03, -04).",
      "pins": [
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/util/InstanceFactory.kt:39",
        "adapters/simulator/src/main/kotlin/com/amazonaws/sfc/simulator/SimulatorAdapter.kt:213",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/service/ServiceMain.kt:109"
      ],
      "modes": [
        "inprocess"
      ],
      "sinks": {
        "main": {
          "kind": "file"
        },
        "v2": {
          "kind": "file"
        }
      },
      "timeoutSeconds": 90,
      "steps": [
        {
          "wait": {
            "sink": "main",
            "records": 3
          }
        },
        {
          "do": "update-config",
          "patch": {
            "Schedules": [
              {
                "Name": "S2",
                "Interval": 100,
                "Active": true,
                "TimestampLevel": "Both",
                "Sources": {
                  "sim": [
                    "*"
                  ]
                },
                "Targets": [
                  "FileTargetV2"
                ]
              }
            ],
            "Sources": {
              "sim": {
                "Channels": {
                  "ctr": {
                    "Simulation": {
                      "Min": 1000
                    }
                  }
                }
              }
            }
          }
        },
        {
          "wait": {
            "sink": "v2",
            "records": 3
          }
        }
      ],
      "assert": [
        {
          "kind": "everyRecord",
          "path": "schedule",
          "equals": "S2",
          "sink": "v2"
