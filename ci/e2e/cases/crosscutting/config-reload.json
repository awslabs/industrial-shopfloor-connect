    {
      "id": "CORE-CFG-RELOAD-INCLUDE-01",
      "title": "Changing an @include'd file reloads the configuration although the main file is unchanged",
      "tier": "core",
      "priority": "P1",
      "intent": "For every included file ConfigFileProvider starts a file watcher (ConfigFileProvider.kt:165, :198-215; MonitorIncludedConfigFiles defaults to true, BaseConfiguration.kt:306). On a change it logs 'Included configuration file ... changed' and re-sends the last configuration (:173-181), which re-reads the include. The schedule's Targets and Metadata come from case/sched.txt; rewriting it moves the schedule to the second target (sink v2) with tag v2. The main file never changes, so 'Updating configuration from file' must not appear.",
      "pins": [
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/service/ConfigFileProvider.kt:165",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/service/ConfigFileProvider.kt:178",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/service/ConfigFileProvider.kt:180",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/config/BaseConfiguration.kt:306"
      ],
      "sinks": {
        "main": {
          "kind": "file"
        },
        "v2": {
          "kind": "file"
        }
      },
      "timeoutSeconds": 90,
      "steps": [
        {
          "wait": {
            "sink": "main",
            "records": 3
          }
        },
        {
          "do": "write-file",
          "path": "${SFC_E2E_CASE_DIR}/sched.txt",
          "content": "\"Metadata\": {\"tag\": \"v2\"},\n\"Targets\": [\"FileTargetV2\"]\n"
        },
        {
          "wait": {
            "sink": "v2",
            "records": 3
          }
        }
      ],
      "assert": [
        {
          "kind": "everyRecord",
          "path": "metadata.tag",
          "equals": "v1",
          "sink": "main"
        },
        {
          "kind": "everyRecord",
          "path": "metadata.tag",
          "equals": "v2",
          "sink": "v2"
        },
        {
          "kind": "logContains",
          "text": "Included configuration file",
          "process": "sfc-main"
        },
        {
          "kind": "logContains",
          "text": "case/sched.txt\" changed",
          "process": "sfc-main"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "Updating configuration from file"
          ],
          "process": "sfc-main"
        }
      ],
