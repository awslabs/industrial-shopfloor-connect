{
  "cases": [
    {
      "id": "CORE-CFG-RELOAD-01",
      "title": "Changing the configuration file replaces the running pipeline",
      "tier": "core",
      "priority": "P0",
      "intent": "ConfigFileProvider watches the configuration file and sends every changed version to ServiceMain (ConfigFileProvider.kt:252-258), which stops the running instance and creates a new one (ServiceMain.kt:100-117, :195). The first version writes schedule S to sink main; the update renames the schedule to S2 and points it at a second file target (sink v2). Records in v2 can only come from the new configuration, so the gate on v2 is the proof, without timing. The update is a merge patch of the configuration as rendered for the mode, so IPC server entries survive. Adapter-level changes behave differently per mode and are pinned separately in CORE-CFG-RELOAD-02/-03/-04.",
      "pins": [
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/service/ConfigFileProvider.kt:252",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/service/ConfigFileProvider.kt:256",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/service/ServiceMain.kt:109",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/service/ServiceMain.kt:195",
        "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/util/FileWatcher.kt:42"
      ],
      "sinks": {
        "main": {
          "kind": "file"
        },
        "v2": {
          "kind": "file"
        }
      },
      "timeoutSeconds": 90,
      "steps": [
        {
          "wait": {
            "sink": "main",
            "records": 3
          }
        },
        {
          "do": "update-config",
          "patch": {
            "Schedules": [
              {
                "Name": "S2",
                "Interval": 100,
                "Active": true,
                "TimestampLevel": "Both",
                "Sources": {
                  "sim": [
                    "*"
                  ]
                },
                "Targets": [
                  "FileTargetV2"
                ]
              }
            ]
          }
        },
        {
          "wait": {
            "sink": "v2",
            "records": 3
          }
        }
      ],
      "assert": [
        {
          "kind": "everyRecord",
          "path": "schedule",
          "equals": "S",
          "sink": "main"
        },
        {
          "kind": "everyRecord",
          "path": "schedule",
          "equals": "S2",
          "sink": "v2"
        },
        {
          "kind": "logContains",
          "text": "Updating configuration from file \"config.json\"",
          "process": "sfc-main"
        },
        {
          "kind": "logContains",
          "text": "Stopping service instance",
          "process": "sfc-main"
        },
        {
          "kind": "logCount",
          "text": "Received configuration data from config provider",
          "process": "sfc-main",
          "equals": 2
        }
      ],
