{
  "cases": [
    {
      "id": "CORE-AWSTGT-VAL-NAMES-REQUIRED-01",
      "title": "Invalid names and missing required keys fail per AWS target with their own message before any network call",
      "tier": "core",
      "priority": "P1",
      "intent": "Required destinations and name rules are checked when each writer is built, so a broken name is reported at startup instead of as a stream of AWS errors. Nine AWS targets each carry one naming problem - an S3 bucket with upper case and '_', a 9-level IoT topic, SQS/SNS/Kinesis/Firehose without their destination, MSK without brokers, an S3 Tables namespace with upper case and '-', a SiteWise AssetId that is not a UUID - beside a valid file target. Each message must be logged, no AWS writer may start (IoT validates before its DescribeEndpoint call, AwsIotCoreTargetWriter.kt:88-90, so nothing touches the network) and the file target keeps delivering. One invalid target per type, for the reason given in CORE-AWSTGT-VAL-RANGES-01. The Lambda counterpart of this check never fires; that is AWS-LAM-DEF-01.",
      "pins": [
        "targets/aws-s3-target/src/main/kotlin/com/amazonaws/sfc/awss3/config/AwsS3TargetConfiguration.kt:206-226",
        "targets/aws-iot-core-target/src/main/kotlin/com/amazonaws/sfc/awsiotcore/config/AwsIotCoreTargetConfiguration.kt:101-106",
        "targets/aws-sqs-target/src/main/kotlin/com/amazonaws/sfc/awssqs/config/AwsSqsTargetConfiguration.kt:96-102",
        "targets/aws-sns-target/src/main/kotlin/com/amazonaws/sfc/awssns/config/AwsSnsTargetConfiguration.kt:124-130",
        "targets/aws-kinesis-target/src/main/kotlin/com/amazonaws/sfc/awskinesis/config/AwsKinesisTargetConfiguration.kt:113-118",
        "targets/aws-kinesis-firehose-target/src/main/kotlin/com/amazonaws/sfc/awsfirehose/config/AwsKinesisFirehoseTargetConfiguration.kt:82-88",
        "targets/aws-msk-target/src/main/kotlin/com/amazonaws/sfc/awsmsk/config/AwsMskTargetConfiguration.kt:113-118",
        "targets/aws-s3-tables-target/src/main/kotlin/com/amazonaws/sfc/awss3tables/config/AwsS3TablesTargetConfiguration.kt:107-118",
        "targets/aws-s3-tables-target/src/main/kotlin/com/amazonaws/sfc/awss3tables/AwsS3TablesHelper.kt:253-260",
        "targets/aws-sitewise-target/src/main/kotlin/com/amazonaws/sfc/awssitewise/config/AwsSiteWiseAssetConfiguration.kt:83-86"
      ],
      "failFast": [],
