    {
      "id": "CORE-AWSTGT-VAL-REGION-01",
      "title": "An unknown Region is rejected by every regional AWS target; S3 Tables cannot be configured with an Endpoint alone (known defect)",
      "tier": "core",
      "priority": "P2",
      "intent": "Each regional target checks Region against its SDK client's service metadata offline, so a mistyped region fails at startup instead of as unresolvable-host errors at every write. Seven targets with Region 'us-east-7' must all be rejected with the shared 'Region \"us-east-7\" is not valid' message while the file target keeps running. S3 Tables is the exception: its first check accepts an Endpoint instead of a Region (\"Either Region must be specified\"), but the second one evaluates Region.of(_region!!) and turns the resulting NullPointerException into 'Invalid Region \"null\"', so an Endpoint-only configuration can never be built. That is pinned as a defect.",
      "pins": [
        "targets/aws-sqs-target/src/main/kotlin/com/amazonaws/sfc/awssqs/config/AwsSqsTargetConfiguration.kt:122-134",
        "targets/aws-iot-core-target/src/main/kotlin/com/amazonaws/sfc/awsiotcore/config/AwsIotCoreTargetConfiguration.kt:111-123",
        "targets/aws-lambda-target/src/main/kotlin/com/amazonaws/sfc/awslambda/config/AwsLambdaTargetConfiguration.kt:112-123",
        "targets/aws-s3-tables-target/src/main/kotlin/com/amazonaws/sfc/awss3tables/config/AwsS3TablesTargetConfiguration.kt:124-143"
      ],
      "failFast": [],
      "records": 4,
      "timeoutSeconds": 60,
      "assert": [
        {
          "kind": "recordCount",
          "min": 4
        },
        {
          "kind": "logContains",
          "text": "Region \"us-east-7\" is not valid",
          "min": 7,
          "comment": "S3, SQS, SNS, Lambda, Kinesis, Firehose and IoT Core"
        },
        {
          "kind": "logAbsent",
          "texts": [
            "AWS IoT Core writer for target",
            "AWS S3 writer for target",
            "AWS SQS writer for target",
            "AWS SNS writer for target",
            "AWS Kinesis writer for target",
            "AWS Lambda writer for target",
            "AWS Kinesis Firehose writer for target",
            "NoClassDefFoundError",
            "ClassNotFoundException",
            "NoSuchMethodError"
          ]
        }
      ],
      "knownDefect": {
        "ref": "targets/aws-s3-tables-target/src/main/kotlin/com/amazonaws/sfc/awss3tables/config/AwsS3TablesTargetConfiguration.kt:133-142",
        "summary": "S3 Tables accepts Endpoint instead of Region in its first check, then dereferences the null Region and rejects the configuration as 'Invalid Region \"null\"'",
        "assertCurrent": [
          {
            "kind": "logContains",
            "text": "Invalid Region \"null\""
          }
        ],
        "assertCorrect": [
          {
            "kind": "logAbsent",
            "texts": [
              "Invalid Region \"null\""
            ]
          }
        ]
      },
