    {
      "id": "CORE-AWSTGT-VAL-NAMES-REQUIRED-02",
      "title": "A missing S3 BucketName and an IoT topic starting with '$' are rejected at startup",
      "tier": "core",
      "priority": "P2",
      "intent": "The second half of CORE-AWSTGT-VAL-NAMES-REQUIRED-01, split off because a writer validates every target of its own type and reports the first invalid one (AwsSqsWriterConfiguration.validate and its siblings), so two invalid S3 or IoT targets in one configuration would produce mode-dependent messages. An S3 target without BucketName and an IoT target publishing to a reserved '$aws/...' topic must each fail with their own message ('$aws' has no braces, so SFC's ${} substitution leaves it alone), while the file target keeps delivering.",
      "pins": [
        "targets/aws-s3-target/src/main/kotlin/com/amazonaws/sfc/awss3/config/AwsS3TargetConfiguration.kt:206-210",
