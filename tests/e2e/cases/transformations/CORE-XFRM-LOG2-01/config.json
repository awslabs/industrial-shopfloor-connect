{
  "AWSVersion": "2022-04-02",
  "Name": "CORE-XFRM-LOG2-01",
  "Version": 1,
  "LogLevel": "Info",
  "Transformations": {
    "L2": [
      {
        "Operator": "Log2"
      }
    ]
  },
  "Schedules": [
    {
      "Name": "S",
      "Interval": 100,
      "Active": true,
      "TimestampLevel": "None",
      "Sources": {
        "sim": ["*"]
      },
      "Targets": ["FileTarget"]
    }
  ],
  "Sources": {
    "sim": {
      "Name": "sim",
      "ProtocolAdapter": "SimAdapter",
      "Channels": {
        "eight": {
          "Name": "eight",
          "Transformation": "L2",
          "Simulation": {
            "SimulationType": "Constant",
            "DataType": "Double",
            "Value": 8.0
          }
        },
        "sixtyfour": {
          "Name": "sixtyfour",
          "Transformation": "L2",
          "Simulation": {
            "SimulationType": "Constant",
            "DataType": "Double",
            "Value": 64.0
          }
        }
      }
    }
  },
  "Targets": {
    "FileTarget": {
      "Active": true,
      "TargetType": "FILE-TARGET",
      "Directory": "${SFC_E2E_SINK}",
      "Json": true,
      "UtcTime": true,
      "Extension": ".json",
      "BufferSize": 1,
      "BufferCount": 1,
      "Interval": 60
    }
  },
  "TargetTypes": {
    "FILE-TARGET": {
      "FactoryClassName": "com.amazonaws.sfc.filetarget.FileTargetWriter"
    }
  },
  "ProtocolAdapters": {
    "SimAdapter": {
      "AdapterType": "SIMULATOR"
    }
  },
  "AdapterTypes": {
    "SIMULATOR": {
      "FactoryClassName": "com.amazonaws.sfc.simulator.SimulatorAdapter"
    }
  }
}
