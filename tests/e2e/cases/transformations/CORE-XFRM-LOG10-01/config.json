{
  "AWSVersion": "2022-04-02",
  "Name": "CORE-XFRM-LOG10-01",
  "Version": 1,
  "LogLevel": "Info",
  "Transformations": {
    "L10": [
      {
        "Operator": "Log10"
      }
    ]
  },
  "Schedules": [
    {
      "Name": "S",
      "Interval": 100,
      "Active": true,
      "TimestampLevel": "None",
      "Sources": {
        "sim": [
          "*"
        ]
      },
      "Targets": [
        "FileTarget"
      ]
    }
  ],
  "Sources": {
    "sim": {
      "Name": "sim",
      "ProtocolAdapter": "SimAdapter",
      "Channels": {
        "hundred": {
          "Name": "hundred",
          "Transformation": "L10",
          "Simulation": {
            "SimulationType": "Constant",
            "DataType": "Double",
            "Value": 100.0
          }
        },
        "thousand": {
          "Name": "thousand",
          "Transformation": "L10",
          "Simulation": {
            "SimulationType": "Constant",
            "DataType": "Double",
            "Value": 1000.0
          }
        }
      }
    }
  },
  "Targets": {
    "FileTarget": {
      "Active": true,
      "TargetType": "FILE-TARGET",
      "Directory": "${SFC_E2E_SINK}",
      "Json": true,
      "UtcTime": true,
      "Extension": ".json",
      "BufferSize": 1,
      "BufferCount": 1,
      "Interval": 60
    }
  },
  "TargetTypes": {
    "FILE-TARGET": {
      "FactoryClassName": "com.amazonaws.sfc.filetarget.FileTargetWriter"
    }
  },
  "ProtocolAdapters": {
    "SimAdapter": {
      "AdapterType": "SIMULATOR"
    }
  },
  "AdapterTypes": {
    "SIMULATOR": {
      "FactoryClassName": "com.amazonaws.sfc.simulator.SimulatorAdapter"
    }
  }
}
