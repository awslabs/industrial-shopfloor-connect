{
  "id": "CORE-XFRM-LOG10-01",
  "title": "Log10 on a Double returns the natural logarithm (known defect)",
  "area": "transformations",
  "tier": "core",
  "intent": "Log10.kt:21 is a copy-paste of the same defect as Log2: `else -> kotlin.math.ln(target.toDouble())`. Log10(100.0) yields 4.605170185988092 instead of 2.0. Log10Test.kt passes for the same reason Log2Test.kt does - its non-Float fixtures are only 0.0 and 1.0, where every logarithm agrees. Pinned, not fixed: no SFC source file is changed by this suite.",
  "pins": [
    "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/transformations/Log10.kt:21",
    "core/sfc-core/src/test/kotlin/com/amazonaws/sfc/transformations/Log10Test.kt"
  ],
  "records": 3,
  "timeoutSeconds": 60,
  "modes": [
    "inprocess",
    "uberjar"
  ],
  "assert": [
    {
      "kind": "recordCount",
      "min": 3
    }
  ],
  "knownDefect": {
    "ref": "core/sfc-core/src/main/kotlin/com/amazonaws/sfc/transformations/Log10.kt:21",
    "summary": "Log10 applies ln() to every non-Float input, so Log10(100.0)=4.6051\u2026 not 2.0 and Log10(1000.0)=6.9077\u2026 not 3.0",
    "assertCurrent": [
      {
        "kind": "channelValueSet",
        "source": "sim",
        "channel": "hundred",
        "values": [
          4.605170185988092
        ],
        "tolerance": 1e-12,
        "comment": "ln(100); correct Log10 is 2.0"
      },
      {
        "kind": "channelValueSet",
        "source": "sim",
        "channel": "thousand",
        "values": [
          6.907755278982137
        ],
        "tolerance": 1e-12,
        "comment": "ln(1000); correct Log10 is 3.0"
      }
    ],
    "assertCorrect": [
      {
        "kind": "channelValueSet",
        "source": "sim",
        "channel": "hundred",
        "values": [
          2.0
        ],
        "tolerance": 1e-12
      },
      {
        "kind": "channelValueSet",
        "source": "sim",
        "channel": "thousand",
        "values": [
          3.0
        ],
        "tolerance": 1e-12
      }
    ]
  },
  "modeParity": true
}
