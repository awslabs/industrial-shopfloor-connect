{
  "AWSVersion": "2022-04-02",
  "Name": "CORE-SIM-CLAMP-01",
  "Version": 1,
  "LogLevel": "Info",
  "Schedules": [
    {
      "Name": "S",
      "Interval": 100,
      "Active": true,
      "TimestampLevel": "Both",
      "Sources": {
        "sim": [
          "*"
        ]
      },
      "Targets": [
        "FileTarget"
      ]
    }
  ],
  "Sources": {
    "sim": {
      "Name": "sim",
      "ProtocolAdapter": "SimAdapter",
      "Channels": {
        "sq": {
          "Name": "sq",
          "Simulation": {
            "SimulationType": "Square",
            "DataType": "Double",
            "Min": 0,
            "Max": 100,
            "CycleLength": 400
          }
        },
        "sqf": {
          "Name": "sqf",
          "Simulation": {
            "SimulationType": "Square",
            "DataType": "Float",
            "Min": 0,
            "Max": 50,
            "CycleLength": 400
          }
        }
      }
    }
  },
  "Targets": {
    "FileTarget": {
      "Active": true,
      "TargetType": "FILE-TARGET",
      "Directory": "${SFC_E2E_SINK}",
      "Json": true,
      "UtcTime": true,
      "Extension": ".json",
      "BufferSize": 1,
      "BufferCount": 1,
      "Interval": 60
    }
  },
  "TargetTypes": {
    "FILE-TARGET": {
      "FactoryClassName": "com.amazonaws.sfc.filetarget.FileTargetWriter"
    }
  },
  "ProtocolAdapters": {
    "SimAdapter": {
      "AdapterType": "SIMULATOR"
    }
  },
  "AdapterTypes": {
    "SIMULATOR": {
      "FactoryClassName": "com.amazonaws.sfc.simulator.SimulatorAdapter"
    }
  },
  "Metrics": {
    "Interval": 1,
    "Writer": {
      "MetricsWriter": {
        "FactoryClassName": "com.amazonaws.sfc.e2e.E2eMetricsWriter"
      }
    }
  }
}
