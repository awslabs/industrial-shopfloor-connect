{
  "AWSVersion": "2022-04-02",
  "Name": "CORE-CFG-PLACEHOLDER-NEG-01",
  "Version": 1,
  "LogLevel": "Info",
  "Schedules": [
    {
      "Name": "S",
      "Interval": 100,
      "Active": true,
      "TimestampLevel": "Both",
      "Sources": {
        "sim": [
          "*"
        ]
      },
      "Targets": [
        "FileTarget"
      ]
    }
  ],
  "Sources": {
    "sim": {
      "Name": "sim",
      "ProtocolAdapter": "SimAdapter",
      "Channels": {
        "ctr": {
          "Name": "ctr",
          "Simulation": {
            "SimulationType": "Counter",
            "DataType": "Int",
            "Direction": "UP",
            "Min": 0,
            "Max": 100000,
            "Step": 1
          }
        }
      }
    }
  },
  "Targets": {
    "FileTarget": {
      "Active": true,
      "TargetType": "FILE-TARGET",
      "Directory": "${SFC_E2E_DELIBERATELY_UNSET_PLACEHOLDER}",
      "Json": true,
      "UtcTime": true,
      "Extension": ".json",
      "BufferSize": 1,
      "BufferCount": 1,
      "Interval": 60
    }
  },
  "TargetTypes": {
    "FILE-TARGET": {
      "FactoryClassName": "com.amazonaws.sfc.filetarget.FileTargetWriter"
    }
  },
  "ProtocolAdapters": {
    "SimAdapter": {
      "AdapterType": "SIMULATOR"
    }
  },
  "AdapterTypes": {
    "SIMULATOR": {
      "FactoryClassName": "com.amazonaws.sfc.simulator.SimulatorAdapter"
    }
  },
  "Metrics": {
    "Interval": 1,
    "Writer": {
      "MetricsWriter": {
        "FactoryClassName": "com.amazonaws.sfc.e2e.E2eMetricsWriter"
      }
    }
  }
}
